#!/usr/bin/env python3
"""kanban/bin/kb: aifactory のチケット台帳（SQLite 正本）。task-id の採番元。

  kb new <pj> <kind> <title> [--body FILE|-] [--pr N] [--id N] [--status S] [--note TEXT] [--attach FILE]...
  kb list [--status S] [--pj P] [--all]
  kb show <id>
  kb start|review|done|reopen <id> [--note TEXT]
  kb block <id> --note TEXT
  kb set <id> [--status S] [--pr N] [--run DIR] [--note TEXT] [--kind K]   # --note '' でメモを空に戻す
  kb append <id> [--section S] [--text T]        # 本文の末尾に追記（--text が無ければ stdin）。history に残る
  kb attach <id> <file>...                       # 画像・PDF・CSV などを添付（コピー）。本文には書かない
  kb attachments <id> [--json]                   # 添付の一覧（名前・サイズ・種別・追加日時）
  kb detach <id> <name>                          # 添付を 1 件消す
  kb next [--pj P] [--json]                      # 次に回す todo を 1 件（glue のルーターが読む）
  kb resumable [--pj P] [--json]                 # 一時停止中（利用枠切れ / 鍵なし で todo に戻した）チケットと、続きを回せるか（解除時刻を過ぎた / 鍵が登録された。dispatch --resume-paused が読む）
  kb run <id> [--workflow W] [--dry-run] [--keep] [--resume] [--from [STEP]] [--branch B] [--wait [分]]   # workflow/bin/run を呼び、結果で状態を進める（--workflow は今回の実行方法だけ。kind は変えない）
                                                 # --wait は VM のプールに空きが無いとき失敗せず空くまで待つ（分。既定 60）。上限を超えたら todo に戻す
                                                 # --from は human で止まった run を新しい VM で STEP からやり直す（既定は記録の resume_step、続きは記録の wip ブランチ）。--resume とは併用できない
  kb sync <id> [--run DIR] [--dry-run]           # runs/<run>/state.json を読み直して状態を合わせる（--dry-run は書かずに前後を JSON で出す）
  kb run-note <run> [--result done|abandoned] [--pr N] [--text T] [--force]   # 人間の後始末（wip から PR を作ってマージ／打ち切り）を run 記録に残す
  kb history <id>
  kb render                                      # BOARD.md を再生成（状態を変える操作は自動で行う）

- pj    : $AIFACTORY_WORKSPACE/projects/<pj>/（無ければ examples/projects/<pj>/）がある PJ
- kind  : workflow/kit/workflows/*.yml のうち `.` / `_` 始まりでないもの（chore / bug / feature / hotfix / research / merge-pr / docs）
- status: todo → in_progress → review → done。人間待ちは blocked
- チケット本文は tickets/<id>-<pj>-<slug>.md（1 行目が題名、`pr: N` 行は runner が読む）。runner にはこのパスをそのまま渡す
- 添付は attachments/<id>/（本文には書かない。1 ファイル 20 MiB・1 チケット 100 MiB まで）。run のとき VM の ~/work/<id>/attachments/ に置かれる
- DB は $AIFACTORY_WORKSPACE/kanban/kanban.db（git 追跡外。lib/aifactory_paths.py が置き場を決める）。ここには ID・状態・履歴だけ。本文はファイルが正
- 「ただのコード。エージェントは居ない」。LLM を使う判断（種別の分類など）は glue 側
- 置き場は環境変数 AIFACTORY_WORKSPACE（全体）か KB_ROOT（kanban だけ）で差し替えられる
- run 列には run 名（例 2026-09-06-kumitate-206）を入れる。旧記録の workflow/runs/<名前> も読める
"""
import argparse, datetime, json, os, pathlib, re, sqlite3, subprocess, sys

HERE = pathlib.Path(__file__).resolve().parent.parent          # kanban/
REPO = HERE.parent                                              # repo root
sys.path.insert(0, str(REPO / "lib")); import aifactory_paths as paths, aifactory_attachments as attachments
ROOT = paths.KB_ROOT
DB = ROOT / "kanban.db"
TICKETS = ROOT / "tickets"
BOARD = ROOT / "BOARD.md"
RUNNER = REPO / "workflow" / "bin" / "run"

STATUSES = ["todo", "in_progress", "review", "blocked", "done"]
STATUS_LABEL = {"todo": "未着手", "in_progress": "実行中", "review": "レビュー待ち", "blocked": "人間待ち", "done": "完了"}
MIN_ID = 100   # DNS 名 task-{id}.sb.internal に使うため 3 桁以上


def die(msg, code=1):
    print(f"[kb] error: {msg}", file=sys.stderr); sys.exit(code)


def now():
    """記録する時刻はオフセット付き（ADR-0026）。読む側（console）が時間帯を推し量らずに済む"""
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def pjs():
    return paths.projects()


def kinds():
    d = REPO / "workflow" / "kit" / "workflows"
    # `.` / `_` 始まり（macOS の `._bug.yml` など）とディレクトリは種別にしない
    return sorted(p.stem for p in d.glob("*.yml") if p.is_file() and not p.name.startswith((".", "_")))


def slugify(title):
    s = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    return s[:40].rstrip("-") or "ticket"


# ---------- DB ----------
SCHEMA = """
CREATE TABLE IF NOT EXISTS tickets (
    id      INTEGER PRIMARY KEY,
    pj      TEXT NOT NULL,
    kind    TEXT NOT NULL,
    title   TEXT NOT NULL,
    status  TEXT NOT NULL DEFAULT 'todo',
    file    TEXT NOT NULL,
    pr      INTEGER,
    run     TEXT,
    note    TEXT,
    created TEXT NOT NULL,
    updated TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS history (
    id     INTEGER PRIMARY KEY AUTOINCREMENT,
    ticket INTEGER NOT NULL REFERENCES tickets(id) ON DELETE CASCADE,
    at     TEXT NOT NULL,
    field  TEXT NOT NULL,
    old    TEXT,
    new    TEXT
);
CREATE INDEX IF NOT EXISTS idx_tickets_status ON tickets(status);
"""


def db():
    ROOT.mkdir(parents=True, exist_ok=True); TICKETS.mkdir(exist_ok=True)
    c = sqlite3.connect(DB); c.row_factory = sqlite3.Row
    c.execute("PRAGMA foreign_keys = ON"); c.executescript(SCHEMA)
    return c


def get(c, tid):
    r = c.execute("SELECT * FROM tickets WHERE id = ?", (tid,)).fetchone()
    return r or die(f"チケット {tid} が無い")


def record(c, tid, field, old, new):
    if str(old) == str(new): return
    c.execute("INSERT INTO history (ticket, at, field, old, new) VALUES (?,?,?,?,?)", (tid, now(), field, str(old) if old is not None else None, str(new) if new is not None else None))


def update(c, tid, transcribe=True, **fields):
    r = get(c, tid)
    for k, v in fields.items():
        if v is None: continue
        # 「未指定（None）＝触らない」の判定より後で空を潰す。--note '' はメモを消す指示なので DB は NULL に揃える
        if k == "note" and v == "": v = None
        if k == "status" and v not in STATUSES: die(f"status は {STATUSES} のどれか")
        if k == "kind" and v not in kinds(): die(f"kind は {kinds()} のどれか")
        record(c, tid, k, r[k], v)
        c.execute(f"UPDATE tickets SET {k} = ?, updated = ? WHERE id = ?", (v, now(), tid))
        if k == "pr": sync_pr_line(ROOT / r["file"], v)
    c.commit()
    r = get(c, tid)
    # 人間が wip から PR を作ってマージした（= pr を入れた / done にした）ことは run 記録にも残す（335）。
    # runner 由来の更新（apply_result）は transcribe=False で来るので、runner が付けた PR は「人間が仕上げた」にならない
    if transcribe and (fields.get("pr") or fields.get("status") == "done"): transcribe_human(r)
    return r


def sync_pr_line(path, pr):
    # runner は本文の `pr: N` 行を読むので、DB と食い違わないように書き換える
    if not path.exists(): return
    lines = path.read_text(encoding="utf-8").splitlines()
    idx = next((i for i, l in enumerate(lines[:3]) if re.match(r"^pr:\s*#?\d+\s*$", l)), None)
    if idx is not None: lines[idx] = f"pr: {pr}"
    else: lines.insert(1, f"pr: {pr}")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


# ---------- ticket file ----------
def write_ticket(path, title, body, pr):
    lines = [f"# {title}"]
    if pr: lines.append(f"pr: {pr}")
    lines.append("")
    lines.append(body.rstrip() + "\n" if body.strip() else "")
    path.write_text("\n".join(lines), encoding="utf-8")


def fmt(r):
    pr = f"#{r['pr']}" if r["pr"] else "-"
    return f"{r['id']:>4} {STATUS_LABEL[r['status']]:<6} {r['pj']:<10} {r['kind']:<9} {pr:<6} {r['title']}"


# ---------- render ----------
def render(c):
    rows = c.execute("SELECT * FROM tickets ORDER BY id").fetchall()
    out = ["# kanban ボード", "", f"`kb render` が生成（{now()}）。手で編集しない。正本は `kanban.db`、本文は `tickets/`。", ""]
    counts = {s: sum(1 for r in rows if r["status"] == s) for s in STATUSES}
    out.append("| " + " | ".join(STATUS_LABEL[s] for s in STATUSES) + " |")
    out.append("|" + "---|" * len(STATUSES))
    out.append("| " + " | ".join(str(counts[s]) for s in STATUSES) + " |")
    out.append("")
    for s in STATUSES:
        rs = [r for r in rows if r["status"] == s]
        if not rs: continue
        out += [f"## {STATUS_LABEL[s]}（{s}）", "", "| id | PJ | 種別 | 題名 | PR | run | メモ | 更新 |", "|---|---|---|---|---|---|---|---|"]
        for r in rs:
            pr = f"#{r['pr']}" if r["pr"] else ""
            run = f"`{r['run']}`" if r["run"] else ""
            note = (r["note"] or "").replace("|", "/").replace("\n", " ")
            out.append(f"| [{r['id']}]({r['file']}) | {r['pj']} | {r['kind']} | {r['title']} | {pr} | {run} | {note} | {r['updated'][:16]} |")
        out.append("")
    BOARD.write_text("\n".join(out), encoding="utf-8")


# ---------- commands ----------
def cmd_new(a):
    if a.pj not in pjs(): die(f"pj は {pjs()} のどれか")
    if a.kind not in kinds(): die(f"kind は {kinds()} のどれか")
    if a.status not in STATUSES: die(f"status は {STATUSES} のどれか")
    body = ""
    if a.body == "-": body = sys.stdin.read()
    elif a.body: body = pathlib.Path(a.body).read_text(encoding="utf-8")
    c = db()
    if a.id is not None:
        tid = int(a.id)
        if tid < MIN_ID: die(f"id は {MIN_ID} 以上（3 桁以上）")
        if c.execute("SELECT 1 FROM tickets WHERE id = ?", (tid,)).fetchone(): die(f"id {tid} は既にある")
    else:
        m = c.execute("SELECT MAX(id) FROM tickets").fetchone()[0]
        tid = max((m or 0) + 1, MIN_ID)
    file = TICKETS / f"{tid}-{a.pj}-{slugify(a.title) if slugify(a.title) != 'ticket' else a.kind}.md"
    if file.exists(): die(f"{file} が既にある")
    write_ticket(file, a.title, body, a.pr)
    t = now()
    c.execute("INSERT INTO tickets (id, pj, kind, title, status, file, pr, run, note, created, updated) VALUES (?,?,?,?,?,?,?,?,?,?,?)",
              (tid, a.pj, a.kind, a.title, a.status, str(file.relative_to(ROOT)), a.pr, None, a.note, t, t))
    record(c, tid, "status", None, a.status)
    c.commit(); render(c)
    print(fmt(get(c, tid))); print(f"     {file}")
    if getattr(a, "attach", None): attach_files(c, tid, a.attach)
    return tid


def cmd_list(a):
    c = db(); q = "SELECT * FROM tickets WHERE 1=1"; p = []
    if a.status: q += " AND status = ?"; p.append(a.status)
    elif not a.all: q += " AND status != 'done'"
    if a.pj: q += " AND pj = ?"; p.append(a.pj)
    rows = c.execute(q + " ORDER BY id", p).fetchall()
    for r in rows: print(fmt(r))
    if not rows: print("(なし)")


def cmd_show(a):
    c = db(); r = get(c, a.id)
    for k in r.keys(): print(f"{k:<8} {r[k] if r[k] is not None else ''}")
    f = ROOT / r["file"]
    print("-" * 60); print(f.read_text(encoding="utf-8") if f.exists() else f"(本文ファイル無し: {f})")
    # 添付は本文に書かないので、ここで導く（0 件なら今までどおり何も足さない）
    items = attachments.listing(a.id)
    if items:
        print("-" * 20 + f" 添付 ({len(items)}) " + "-" * 20)
        for it in items: print(f"{it['name']:<40} {attachments.human(it['size']):>10}  {it['type']}  {it['added']}")
        print(f"     {attachments.dir_for(a.id)}")


def cmd_status(a, status):
    c = db(); r = update(c, a.id, status=status, note=getattr(a, "note", None)); render(c); print(fmt(r))


def cmd_set(a):
    c = db(); r = update(c, a.id, status=a.status, pr=a.pr, run=a.run, note=a.note, kind=a.kind); render(c); print(fmt(r))


def cmd_append(a):
    """本文の末尾に追記する。本文はファイルが正なので、書き足したことだけを history に残す（差分は持たない）"""
    text = a.text if a.text is not None else sys.stdin.read()
    if not text.strip(): die("追記する本文が空")
    c = db(); r = get(c, a.id)
    f = ROOT / r["file"]
    if not f.exists(): die(f"本文が無い: {f}")
    cur = f.read_text(encoding="utf-8")
    add = (f"\n## {a.section}\n\n" if a.section else "\n") + text.rstrip() + "\n"
    f.write_text(cur.rstrip("\n") + "\n" + add, encoding="utf-8")
    record(c, a.id, "body", None, f"append {len(text)}字" + (f" ({a.section})" if a.section else ""))
    c.execute("UPDATE tickets SET updated = ? WHERE id = ?", (now(), a.id)); c.commit()
    print(fmt(get(c, a.id))); print(f"     {f}")


def attach_files(c, tid, files):
    """ファイルを添付し、history に残す。1 件でも失敗したらそこで止める（入った分は残る）"""
    added = []
    try:
        for f in files:
            name = attachments.add(tid, f)
            record(c, tid, "attachment", None, f"add {name} ({attachments.human((attachments.dir_for(tid) / name).stat().st_size)})")
            added.append(name)
    except (ValueError, OSError) as e:
        c.execute("UPDATE tickets SET updated = ? WHERE id = ?", (now(), tid)); c.commit()
        if added: print(f"[kb] {len(added)} 件は添付済み: {', '.join(added)}", file=sys.stderr)
        die(f"添付できない: {e}")
    c.execute("UPDATE tickets SET updated = ? WHERE id = ?", (now(), tid)); c.commit()
    for name in added: print(f"添付 {name}  {attachments.dir_for(tid) / name}")
    return added


def cmd_attach(a):
    c = db(); get(c, a.id)
    attach_files(c, a.id, a.file)


def cmd_attachments(a):
    c = db(); get(c, a.id)
    items = attachments.listing(a.id)
    if a.json: print(json.dumps(items, ensure_ascii=False)); return
    if not items: print("(添付なし)"); return
    for it in items: print(f"{it['name']:<40} {attachments.human(it['size']):>10}  {it['type']}  {it['added']}")
    print(f"     {attachments.dir_for(a.id)}")


def cmd_detach(a):
    c = db(); get(c, a.id)
    if not attachments.remove(a.id, a.name): die(f"添付 {a.name} が無い（kb attachments {a.id} で確認）")
    record(c, a.id, "attachment", a.name, "removed")
    c.execute("UPDATE tickets SET updated = ? WHERE id = ?", (now(), a.id)); c.commit()
    print(f"detach {a.name}")


def cmd_next(a):
    c = db(); q = "SELECT * FROM tickets WHERE status = 'todo'"; p = []
    if a.pj: q += " AND pj = ?"; p.append(a.pj)
    r = c.execute(q + " ORDER BY id LIMIT 1", p).fetchone()
    if not r: print("" if a.json else "(todo なし)"); return
    if a.json: print(json.dumps({k: r[k] for k in r.keys()} | {"path": str(ROOT / r["file"])}, ensure_ascii=False))
    else: print(fmt(r)); print(f"     {ROOT / r['file']}")


def resume_max_hits():
    """利用枠切れで続けて止まってよい回数。超えたら自動再開をやめて人間へ（380）"""
    return int(os.environ.get("AIFACTORY_RESUME_MAX_HITS") or 6)


def resume_backoff_min():
    """解除時刻が記録に無いときに、止まってから自動再開を試すまでの分数（380）"""
    return int(os.environ.get("AIFACTORY_RESUME_BACKOFF_MIN") or 30)


def fmt_when(iso):
    """記録の時刻（オフセット付き ISO）をメモ向けに短く。読めなければそのまま"""
    try: return datetime.datetime.fromisoformat(iso).astimezone().strftime("%m-%d %H:%M")
    except (TypeError, ValueError): return str(iso)


def key_purposes(need):
    return "、".join({"fable": "Fable に使う鍵", "other": "Opus・Sonnet・Haiku に使う鍵"}[k] for k in need) or "鍵"


def sandbox_keys_path():
    """鍵プール（keys.json）の置き場。sandbox CLI / console と同じ規則（SANDBOX_KEYS → state.json の隣）。値は読まない（用途と有効だけ）"""
    v = os.environ.get("SANDBOX_KEYS")
    if v: return pathlib.Path(v).expanduser()
    st = pathlib.Path(os.environ.get("SANDBOX_STATE") or (pathlib.Path.home() / ".config/sandbox/state.json")).expanduser()
    return st.parent / (st.name[:-len("state.json")] + "keys.json" if st.name.endswith("state.json") else "keys.json")


def key_pool_has(need):
    """鍵プールに、要る用途（fable / other）の有効な鍵がそろっているか（ADR-0046）。プールを読めなければ False"""
    try: keys = json.loads(sandbox_keys_path().read_text(encoding="utf-8")).get("keys") or []
    except (OSError, ValueError): return False
    ok = {g: any(isinstance(k, dict) and k.get("enabled", True) is not False and (k.get("allow") or {}).get(g) is True for k in keys) for g in ("fable", "other")}
    return all(ok.get(g) for g in need) if need else any(ok.values())


def resume_plan(r):
    """チケットが「利用枠切れで一時停止中」なら、その続きを回すのに要る事実と、今回せるか（380）。
    根拠は台帳の run が指す state.json だけ（result: human / failure: quota / wip_branch / resume_step）。それ以外は None。
    ready は retry_after を過ぎたか、無ければ finished から AIFACTORY_RESUME_BACKOFF_MIN 分過ぎたか。判定に使った時刻も返す"""
    if r["status"] != "todo" or not r["run"]: return None
    st = paths.run_path(r["run"]) / "state.json"
    try: s = json.loads(st.read_text(encoding="utf-8"))
    except (OSError, ValueError): return None
    if "finished" not in s: return None
    if s.get("result") == "failed" and s.get("failure") == "nokey":
        # 鍵が無くて VM を取らずに止まった run（ADR-0046）。続きではなく初めから（step / branch は無し）。鍵がそろえば ready
        need = [k for k in (s.get("needed_keys") or []) if k in ("fable", "other")] or ["fable", "other"]
        return {"id": r["id"], "pj": r["pj"], "kind": r["kind"], "title": r["title"], "run": r["run"], "step": None, "branch": None,
                "quota_type": None, "quota_hits": 0, "retry_after": None, "until": None, "needed_keys": need,
                "ready": key_pool_has(need), "hits_exceeded": False, "paused": "nokey"}
    if s.get("result") != "human" or s.get("failure") != "quota": return None
    step, wip = s.get("resume_step"), s.get("wip_branch")
    if not (step and wip): return None
    now_dt = datetime.datetime.now().astimezone()
    until = None
    try:
        if s.get("retry_after"): until = datetime.datetime.fromisoformat(s["retry_after"])
        else: until = datetime.datetime.fromisoformat(s["finished"]) + datetime.timedelta(minutes=resume_backoff_min())
    except (TypeError, ValueError): until = None
    if until is not None and until.tzinfo is None: until = until.astimezone()
    return {"id": r["id"], "pj": r["pj"], "kind": r["kind"], "title": r["title"], "run": r["run"],
            "step": step, "branch": wip, "quota_type": s.get("quota_type"), "quota_hits": int(s.get("quota_hits") or 0),
            "retry_after": s.get("retry_after"), "until": until.isoformat(timespec="seconds") if until else None,
            "ready": bool(until is None or now_dt >= until), "hits_exceeded": int(s.get("quota_hits") or 0) >= resume_max_hits(), "paused": "quota"}


def cmd_resumable(a):
    c = db(); q = "SELECT * FROM tickets WHERE status = 'todo'"; p = []
    if a.pj: q += " AND pj = ?"; p.append(a.pj)
    plans = [pl for pl in (resume_plan(r) for r in c.execute(q + " ORDER BY id", p)) if pl]
    if a.json: print(json.dumps(plans, ensure_ascii=False)); return
    if not plans: print("(一時停止中のチケットなし)"); return
    for pl in plans:
        if pl.get("paused") == "nokey":
            when = "今すぐ" if pl["ready"] else f"鍵の登録待ち（{key_purposes(pl['needed_keys'])}）"
            print(f"{pl['id']:>4} {pl['pj']:<10} {'(初めから)':<10} {when}  {pl['run']}  {pl['title'][:40]}")
            print(f"     kb run {pl['id']}")
            continue
        when = "今すぐ" if pl["ready"] else f"{fmt_when(pl['until'])} 以降"
        print(f"{pl['id']:>4} {pl['pj']:<10} {pl['step']:<10} {when:<14} {pl['quota_type'] or '?'} x{pl['quota_hits']}  {pl['run']}  {pl['title'][:40]}")
        print(f"     kb run {pl['id']} --from {pl['step']} --branch {pl['branch']}")


def run_workflow(run_dir):
    """runs/<run>/state.json に残る「その run をどの workflow で回したか」。--resume は kind ではなくこれで再開する"""
    f = paths.run_path(run_dir) / "state.json"
    try: return json.loads(f.read_text(encoding="utf-8")).get("workflow")
    except Exception: return None


def attempt_no(run_dir):
    """runner が退避に使う番号（workflow/bin/run と同じ規則で数える）。runner が保証する値ではないのでメモの文言だけに使う"""
    p = paths.run_path(run_dir); n = 1
    while (p.parent / f"{p.name}-attempt{n}").exists(): n += 1
    return n


RUN_TAG = "[run] "
# `[run] ` を付ける前に kb 自身が note 全体として書いていた文言の書き出し（342）。既存チケットの 1 行目がこれで始まるなら
# run 由来と見なして捨てる（人の行に格上げすると #294 の「板が古く見える」が戻る）。移行スクリプトは要らない
LEGACY_RUN_PREFIXES = ("人間へ", "PR 待ち", "再走中", "VM を取得できず", "VM の空き待ち", "自動マージ", "マージ済み",
                       "PR 無しで終了", "runner が", "貸出直後の準備", "鍵の利用枠切れ", "鍵が使えず", "Claude の鍵が無いので")


def run_note(prev, text):
    """run 由来の状態文をチケットのメモに置く。1 行目（`[run] …`）だけが機械のもので、残りは人のもの（342）。

    PM が `kb set --note` で書いた申し送りを run / sync / 再走が丸ごと上書きして消していたので、
    自分が前に書いた 1 行だけを差し替え、人が書いた行はそのまま後ろに残す。人の `kb set --note` は今までどおり
    note 全体を書く（note の持ち主は人。次の run が自分の 1 行目を書き直す）"""
    lines = (prev or "").splitlines()
    if lines and (lines[0].startswith(RUN_TAG) or lines[0].startswith(LEGACY_RUN_PREFIXES)):
        lines = lines[1:]
    human = "\n".join(lines).strip()
    return RUN_TAG + text + (f"\n{human}" if human else "")


def rerun_note(r, run_dir, resuming, restarting, wf, from_step):
    """同じチケットを回し直すとき、チケットのメモを「再走中」に替える（335）。替えないと前回 human で止まったときの
       「人間へ（wip: …）…」が in_progress のまま残り、板が古い状態に見える。触らないときは None（初回の run は今までどおり）"""
    retiring = paths.run_path(run_dir).exists()
    if resuming or not (retiring or restarting): return None
    note = f"再走中（attempt {attempt_no(run_dir)}・workflow {wf}）" if retiring else f"再走中（workflow {wf}）"
    if restarting and r["run"]:
        note += f"。前回: {r['run']}" + (f" の {from_step} から" if from_step else " の続きから")
    return note


def cmd_run(a):
    c = db(); r = get(c, a.id)
    pd = paths.project_dir(r["pj"])
    if not (pd and (pd / "project.yml").exists()): die(f"{r['pj']} に project.yml が無い（runner が動かない。置き場: {' / '.join(str(d) for d in paths.PROJECT_DIRS)}）")
    if r["status"] == "done" and not a.dry_run: die(f"{a.id} は done。やり直すなら kb reopen")
    path = ROOT / r["file"]
    if not path.exists(): die(f"本文が無い: {path}")
    run_dir = f"{datetime.date.today().isoformat()}-{r['pj']}-{r['id']}" + ("-dry" if a.dry_run else "")
    resuming = bool(a.resume and not a.dry_run and r["run"])
    # --from / --branch は「新しい VM で、記録の wip ブランチの続きから、指定の step をやり直す」（333）。run は新しく作る
    restarting = a.from_step is not None or a.from_branch is not None
    if restarting and a.resume: die("--from と --resume は一緒に使えない（--resume は貸出中の VM で続き、--from は新しい VM を取り直す）")
    if resuming:
        run_dir = r["run"]
    # kind は「何の仕事か」、workflow は「今回どう回すか」。--workflow は kind を書き換えない（チケット 249）
    wf = a.workflow or (resuming and run_workflow(run_dir)) or (restarting and r["run"] and run_workflow(r["run"])) or r["kind"]
    if wf not in kinds(): die(f"workflow {wf} が無い（{kinds()}）")
    if not a.dry_run:
        rn = rerun_note(r, run_dir, resuming, restarting, wf, a.from_step)
        update(c, a.id, status="in_progress", run=run_dir,
               note=run_note(r["note"], rn) if rn is not None else None, transcribe=False)
        if a.workflow: record(c, a.id, "workflow", None, wf); c.commit()
        render(c)
    cmd = [str(RUNNER), r["pj"], str(r["id"]), wf, str(path)] + [f for f in ("--dry-run", "--keep", "--resume") if getattr(a, f[2:].replace("-", "_"))]
    if getattr(a, "wait", None): cmd.append(f"--wait={int(a.wait * 60)}")   # 人は分で言い、runner は秒で待つ（242）
    if a.from_step is not None: cmd.append(f"--from={a.from_step}" if a.from_step else "--from")
    if a.from_branch: cmd.append(f"--branch={a.from_branch}")
    print("[kb] " + " ".join(cmd), flush=True)
    env = os.environ.copy()
    if a.resume and not a.dry_run:
        env["AIFACTORY_RESUME_RUN"] = run_dir
    else:
        env.pop("AIFACTORY_RESUME_RUN", None)
    # 前回の run（step の既定・wip ブランチ・持ち込む work/*.md の出どころ）。runner は run 名の形しか受け付けない
    if restarting and r["run"]:
        env["AIFACTORY_FROM_RUN"] = r["run"]
    else:
        env.pop("AIFACTORY_FROM_RUN", None)
    rc = subprocess.run(cmd, env=env).returncode
    if a.dry_run: print(f"[kb] dry-run 終了 rc={rc}"); return rc
    # --from が弾かれて記録が 1 つも残らなかったら、台帳の run を前回に戻す（333）。
    # 戻さないと AIFACTORY_FROM_RUN が存在しない run 名になり、打ち直しても wip も前回の work/*.md も辿れない
    if restarting and rc != 0 and r["run"] and not (paths.run_path(run_dir) / "state.json").exists():
        run_dir = r["run"]
    rc = apply_result(c, a.id, run_dir, rc)
    print(f"[kb] {fmt(get(c, a.id))}")
    return rc


# ---------- 人間の後始末（run 記録への転記）
def actor():
    """記録に残す「誰が」。CI や別の口から呼ぶときは AIFACTORY_ACTOR で名乗れる"""
    return os.environ.get("AIFACTORY_ACTOR") or os.environ.get("USER") or "human"


def pr_url_for(pj, pr):
    """PR 番号を記録に書く形にする。PJ 定義に repo があれば URL、無ければ `#N`（console はどちらからも番号を取る）"""
    if not pr: return ""
    pd = paths.project_dir(pj) if pj else None
    f = (pd / "project.yml") if pd else None
    if f and f.exists():
        m = re.search(r"^repo:\s*[\"']?([\w.-]+/[\w.-]+)[\"']?\s*$", f.read_text(encoding="utf-8"), re.M)
        if m: return f"https://github.com/{m.group(1)}/pull/{pr}"
    return f"#{pr}"


def human_note(run_dir, result=None, pr=None, text=None, force=False):
    """人間が run の後始末（wip から PR を作ってマージ・打ち切り）をしたことを state.json に追記する（335）。

    runner が確定した `result` は上書きせず `human: {at, by, result, pr_url, text}` を別に持つ。
    「人間が PR#n で仕上げた」という言い方は console が導く（ADR-0025 / ADR-0039）。
    実行中（finished が無い）の run は runner が同じファイルを書いているので断る。"""
    st = paths.run_path(run_dir) / "state.json"
    if not st.exists(): raise ValueError(f"実行記録が無い: {st}")
    s = json.loads(st.read_text(encoding="utf-8"))
    if "finished" not in s: raise ValueError(f"{run_dir} はまだ実行中（runner が state.json を書いている）。終わってから記録する")
    old = s.get("human") or {}
    if old and not force: raise ValueError(f"{run_dir} には既に人間の記録がある（{old.get('at')} / {old.get('by')}）。書き足すなら --force")
    h = {"at": now(), "by": actor(), "result": result or old.get("result") or "done",
         "pr_url": pr_url_for(s.get("pj"), pr) or old.get("pr_url") or "",
         "text": (text if text is not None else old.get("text")) or ""}
    if h["result"] not in ("done", "abandoned"): raise ValueError("--result は done か abandoned")
    s["human"] = h
    st.write_text(json.dumps(s, ensure_ascii=False, indent=2), encoding="utf-8")
    return h


def transcribe_human(r):
    """チケットに PR を入れた / done にしたとき、紐づく run が human で止まったままなら run 記録に転記する（335）。
       転記できなくてもチケットの更新は成功させる（記録が無いだけで done できないのは困る）"""
    if not r["run"]: return
    st = paths.run_path(r["run"]) / "state.json"
    if not st.exists(): return
    try: s = json.loads(st.read_text(encoding="utf-8"))
    except Exception as e: print(f"[kb] warn: {st} を読めず run に転記しなかった: {e}", file=sys.stderr); return
    if s.get("result") != "human" or s.get("human") or "finished" not in s: return
    try: h = human_note(r["run"], result="done", pr=r["pr"], text=f"チケット {r['id']} の後始末を kb から転記")
    except Exception as e: print(f"[kb] warn: {r['run']} に転記できなかった: {e}", file=sys.stderr); return
    print(f"[kb] {r['run']} に人間の後始末を転記（{h['result']} / {h['pr_url'] or 'PR 無し'}）")


def cmd_run_note(a):
    try: h = human_note(a.run, result=a.result, pr=a.pr, text=a.text, force=a.force)
    except ValueError as e: die(str(e))
    except OSError as e: die(f"{a.run} の state.json を書けない: {e}")
    print(f"[kb] {a.run} human={h['result']} pr={h['pr_url'] or '-'} by={h['by']} at={h['at']}")


def apply_result(c, tid, run_dir, rc=0, dry=False):
    """runs/<run>/state.json を読んで状態を進める（kb run の末尾と kb sync が共用）。
    dry=True なら DB を書かず、前後（状態・メモ）を JSON で標準出力に出すだけ（console の下見が読む）"""
    st = paths.run_path(run_dir) / "state.json"
    s = json.loads(st.read_text(encoding="utf-8")) if st.exists() else {}
    pr = None
    if "finished" not in s:
        # rc≠0 なら runner はもう居ない。記録が無いまま `実行中` で放置しない（238。kb sync は rc=0 なので従来どおり）
        if rc != 0: status, note = "blocked", f"runner が記録を残さず終了 rc={rc}。原因を直して kb reopen → kb run"
        else: status, note = "in_progress", f"runner 実行中（次の step: {s.get('next', '?')}）"
    else:
        result, pr_url, wip = s.get("result"), s.get("pr_url") or "", s.get("wip_branch") or ""
        m = re.search(r"/pull/(\d+)", pr_url); pr = int(m.group(1)) if m else None
        # chore / bug / feature は pr step の後 `human`（= 人間がレビューしてマージ）で終わるので、PR があれば review
        # runner が条件を確かめて自分でマージした run（ADR-0042）。事実は state.json の merged だけを見る（推し量らない）
        m2 = s.get("merged")
        if isinstance(m2, dict) and m2.get("at"):        # at は script が必ず書く（sha は GitHub の反映が遅れると空になる）
            n = re.search(r"/pull/(\d+)", m2.get("pr_url") or "")
            if n: pr = int(n.group(1))
            status = "done"
            note = f"自動マージ #{pr or '?'} → {m2.get('base') or '?'}（{m2.get('method') or 'merge'}）"
        elif "MERGED" in pr_url: status, note = "done", f"マージ済み {pr_url}"
        elif pr_url:
            # 自動マージしなかった run は、その理由（runner が書いた 1 行）も板に写す。判定は足さず事実をそのまま置く（ADR-0039）
            why = ((s.get("error") or "").strip().splitlines() or [""])[0]
            status = "review"
            note = f"PR 待ち {pr_url}" + (f"（自動マージせず: {why.removeprefix('automerge: ')[:120]}）"
                                          if why.startswith("automerge: ") else "")
        elif result == "end": status, note = "done", "PR 無しで終了（research 等）"
        elif result == "failed" and s.get("failure") == "wait_timeout":
            # --wait で空きを待ったが出なかった run。直す所は無い（VM が空けば回る）ので、人間待ちにせず todo に戻す（242）
            status = "todo"
            note = (f"VM の空き待ちが上限 {int(s.get('waited_s') or 0) // 60} 分を超えて終了。"
                    "空きが出たら kb run --wait / dispatch --wait で再開")
        elif result == "failed" and s.get("failure") == "nokey":
            # 要る用途の Claude の鍵が鍵プールに無く、VM を取らずに止まった run（ADR-0046）。鍵が登録されれば回せるので todo に戻し、
            # dispatch --resume-paused（timer）が鍵の登録を見て初めから回し直す。人が直すのは鍵の登録だけ
            need = [k for k in (s.get("needed_keys") or []) if k in ("fable", "other")]
            status = "todo"
            note = (f"Claude の鍵が無いので一時停止（必要: {key_purposes(need)}）。console の「鍵」画面か sandbox keys add で登録すると自動で再開"
                    "（dispatch --resume-paused）")
        elif result == "failed" and s.get("failure") == "prepare":
            # 貸出直後の準備で落ちた run（330）。VM は取れているので「取得できず」ではない。直す所は prepare.sh か VM の側
            why = ([l.strip() for l in (s.get("error") or "").splitlines() if l.strip()] or ["理由不明"])[-1][:120]
            status = "blocked"
            note = f"貸出直後の準備（prepare）で止まった: {why}。prepare.sh か VM を直して kb reopen → kb run"
        elif result == "failed":
            # 工程が 1 つも始まる前に落ちた run（VM が取れない等）。todo に戻すと配車がすぐ拾って同じ失敗を繰り返す（238）
            why = ([l.strip() for l in (s.get("error") or "").splitlines() if l.strip()] or ["理由不明"])[-1][:120]
            status, note = "blocked", f"VM を取得できず開始前に終了: {why}。原因を直して kb reopen → kb run"
        elif result == "human" and s.get("failure") == "quota":
            # 鍵の利用枠の上限で止まった run（380 / ADR-0043）。直す所は無い（時間が経てば戻る）ので todo に戻し、
            # dispatch --resume-paused（制御系の timer）が解除時刻を過ぎてから `kb run --from` で続きを回す。
            # 続けて何度も止まる（鍵の枠が小さすぎる等）ときだけ人間へ（上限は AIFACTORY_RESUME_MAX_HITS、既定 6）
            step, hits = s.get("resume_step"), int(s.get("quota_hits") or 0)
            cont = f"kb run {tid} --from {step} --branch {wip}" if wip and step else f"kb run {tid}"
            when = s.get("retry_after")
            if hits >= resume_max_hits():
                status = "blocked"
                note = f"鍵の利用枠切れで {hits} 回続けて中断（{s.get('quota_type') or 'unknown'}）。鍵の枠を確かめてから {cont}"
            elif not (wip and step):
                # 続きに要る事実（wip ブランチ・やり直す step）が無い run は自動では回せない（wip の push に失敗した等。wip.patch を見る）
                status = "blocked"
                note = f"鍵の利用枠切れで中断したが、続きに要る記録（wip ブランチ / 再開する工程）が無い。runs/{run_dir}/ を確かめてから {cont}"
            else:
                status = "todo"
                note = (f"鍵の利用枠切れで一時停止（{step or '?'} の途中・{s.get('quota_type') or 'unknown'}・{hits} 回目）。"
                        + (f"{fmt_when(when)} 以降に" if when else f"解除時刻は不明。{resume_backoff_min()} 分後に")
                        + f"自動再開（dispatch --resume-paused）。手で回すなら {cont}")
        elif result == "human" and s.get("failure") == "key":
            # 鍵そのものが使えない（無効・失効・残高不足）run。待っても戻らないので人間へ。直したら続きから（380）
            why = ([l.strip() for l in (s.get("error") or "").splitlines() if l.strip()] or ["理由不明"])[-1][:160]
            step = s.get("resume_step")
            status = "blocked"
            note = f"鍵が使えず中断: {why}。sandbox token set/rotate で鍵を直してから" + (f" kb run {tid} --from {step} --branch {wip}" if wip and step else f" kb run {tid}")
        elif result == "human":
            # 止まった理由（どの step で・なぜ）を板だけ見て分かるようにする（239）。理由が無い run は従来どおり
            why = ([l.strip() for l in (s.get("error") or "").splitlines() if l.strip()] or [""])[-1][:160]
            status = "blocked"
            note = ("人間へ" + (f"（wip: origin/{wip}）" if wip else "（PR 無し）")) + (f": {why}" if why else "")
            # 続きから回す口をメモにそのまま置く（板を見た人が組み立て直さずに打てる。333）
            step = s.get("resume_step")
            if wip and step: note += f" 再開: kb run {tid} --from {step} --branch {wip}"
        else: status, note = "blocked", f"runner が異常終了 rc={rc}（state.json: {s.get('next')}）"
    # run 由来の文は note の 1 行目に置き、人が書いた行は後ろに残す（342）。dry の下見にも合成後を出す
    r = get(c, tid)
    note = run_note(r["note"], note)
    if dry:
        print(json.dumps({"id": tid, "run": run_dir, "run_finished": s.get("finished"), "run_result": s.get("result"),
                          "before": {"status": r["status"], "note": r["note"], "run": r["run"], "pr": r["pr"], "updated": r["updated"]},
                          "after": {"status": status, "note": note, "pr": pr, "run": run_dir}}, ensure_ascii=False))
        return rc
    update(c, tid, status=status, pr=pr, run=run_dir, note=note, transcribe=False); render(c)
    return rc


def cmd_sync(a):
    c = db(); r = get(c, a.id)
    run_dir = a.run or r["run"] or die(f"{a.id} に run が無い。--run で指定")
    apply_result(c, a.id, run_dir, dry=a.dry_run)
    if not a.dry_run: print(fmt(get(c, a.id)))


def cmd_history(a):
    c = db(); get(c, a.id)
    for h in c.execute("SELECT * FROM history WHERE ticket = ? ORDER BY id", (a.id,)):
        print(f"{h['at']}  {h['field']:<7} {h['old'] or '-'} → {h['new'] or '-'}")


def main():
    ap = argparse.ArgumentParser(prog="kb", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("new"); p.add_argument("pj"); p.add_argument("kind"); p.add_argument("title")
    p.add_argument("--body"); p.add_argument("--pr", type=int); p.add_argument("--id", type=int); p.add_argument("--status", default="todo"); p.add_argument("--note")
    p.add_argument("--attach", action="append", metavar="FILE", help="起票と同時に添付する（複数可）")
    p = sp.add_parser("list"); p.add_argument("--status"); p.add_argument("--pj"); p.add_argument("--all", action="store_true")
    p = sp.add_parser("show"); p.add_argument("id", type=int)
    for name in ("start", "review", "done", "reopen", "block"):
        p = sp.add_parser(name); p.add_argument("id", type=int); p.add_argument("--note", required=(name == "block"))
    p = sp.add_parser("set"); p.add_argument("id", type=int); p.add_argument("--status"); p.add_argument("--pr", type=int); p.add_argument("--run"); p.add_argument("--note"); p.add_argument("--kind")
    p = sp.add_parser("append"); p.add_argument("id", type=int); p.add_argument("--section", help="追記に付ける見出し。例 PM 補足"); p.add_argument("--text", help="無ければ stdin から読む")
    p = sp.add_parser("attach"); p.add_argument("id", type=int); p.add_argument("file", nargs="+", help="添付するファイル（コピーされる）")
    p = sp.add_parser("attachments"); p.add_argument("id", type=int); p.add_argument("--json", action="store_true")
    p = sp.add_parser("detach"); p.add_argument("id", type=int); p.add_argument("name", help="kb attachments で出る名前")
    p = sp.add_parser("next"); p.add_argument("--pj"); p.add_argument("--json", action="store_true")
    p = sp.add_parser("resumable"); p.add_argument("--pj"); p.add_argument("--json", action="store_true")
    p = sp.add_parser("run"); p.add_argument("id", type=int); p.add_argument("--workflow"); p.add_argument("--dry-run", action="store_true"); p.add_argument("--keep", action="store_true"); p.add_argument("--resume", action="store_true")
    p.add_argument("--wait", nargs="?", type=float, const=60, help="VM のプールに空きが無いとき、空くまで待つ上限（分。既定 60）")
    p.add_argument("--from", dest="from_step", nargs="?", const="", metavar="STEP",
                   help="human で止まった run を新しい VM でこの step からやり直す（既定は記録の resume_step）")
    p.add_argument("--branch", dest="from_branch", metavar="B", help="--from のとき続きに使うブランチ（既定は記録の wip_branch）")
    p = sp.add_parser("sync"); p.add_argument("id", type=int); p.add_argument("--run"); p.add_argument("--dry-run", action="store_true", help="書き換えずに前後を JSON で出す")
    p = sp.add_parser("run-note"); p.add_argument("run", help="run 名（例 2026-09-06-kumitate-206）")
    p.add_argument("--result", choices=["done", "abandoned"], help="人間がどう決着させたか（既定 done）")
    p.add_argument("--pr", type=int, help="人間が作ってマージした PR の番号")
    p.add_argument("--text", help="後始末の説明（run 画面に出る）")
    p.add_argument("--force", action="store_true", help="既に人間の記録がある run に書き足す")
    p = sp.add_parser("history"); p.add_argument("id", type=int)
    sp.add_parser("render")
    a = ap.parse_args()
    if a.cmd == "new": cmd_new(a)
    elif a.cmd == "list": cmd_list(a)
    elif a.cmd == "show": cmd_show(a)
    elif a.cmd in ("start", "review", "done", "reopen", "block"):
        cmd_status(a, {"start": "in_progress", "review": "review", "done": "done", "reopen": "todo", "block": "blocked"}[a.cmd])
    elif a.cmd == "set": cmd_set(a)
    elif a.cmd == "append": cmd_append(a)
    elif a.cmd == "attach": cmd_attach(a)
    elif a.cmd == "attachments": cmd_attachments(a)
    elif a.cmd == "detach": cmd_detach(a)
    elif a.cmd == "next": cmd_next(a)
    elif a.cmd == "resumable": cmd_resumable(a)
    elif a.cmd == "run": sys.exit(cmd_run(a))
    elif a.cmd == "sync": cmd_sync(a)
    elif a.cmd == "run-note": cmd_run_note(a)
    elif a.cmd == "history": cmd_history(a)
    elif a.cmd == "render": c = db(); render(c); print(BOARD)


if __name__ == "__main__":
    main()
