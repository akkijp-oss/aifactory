#!/usr/bin/env python3
"""workflow/bin/run: workflow 定義（kit/workflows/<name>.yml）を読んで、sandbox VM の中で step を順に実行する runner（v1）。

  workflow/bin/run <pj> <task-id> <workflow> <ticket.md> [--dry-run] [--keep] [--resume] [--from[=step]] [--branch=名前] [--wait[=秒]]

- pj        : $AIFACTORY_WORKSPACE/projects/<pj>/project.yml（無ければ examples/projects/<pj>/）がある PJ
- task-id   : sandbox take に渡す ID（3 桁など）
- workflow  : kit/workflows/ の名前（hotfix / bug / feature / chore / research）
- ticket.md : チケット（1 行目が題名）
- --dry-run : VM を触らず、定義の検証と各 step の依頼文の組み立てだけ行う（runs/ に出す）
- 置き場（PJ 定義 / runs/）は lib/aifactory_paths.py が決める（AIFACTORY_WORKSPACE。既定は <repo>/workspace/）
- --keep    : 終了後に release しない（中を見たいとき）
- --resume  : 既に貸出中の VM で続きを回す（チケット 338）。再開する step は state.json の工程履歴から決める:
              履歴が空（準備で落ちて 1 工程も終えていない）なら workflow の先頭 step、履歴があれば最後に走った step
              （gates 超過なら gates）。`next: human` をそのまま引き継いで何もせず返却することは無い。
              続きが無い run（PR まで出ている / next: end）は VM に触る前に止まる
- --from    : human で止まった run を、**新しい VM** で指定の step からやり直す（チケット 333）。`--from` だけなら前回の
              state.json の `resume_step`（無ければ history の最後の step）。前回の run は環境変数 AIFACTORY_FROM_RUN で渡す
              （run 名の形しか受け付けない）。前回の work/*.md は新しい VM に持ち込み、review.md は最初の step の
              「前回の結果（直すこと）」として依頼文に入る。--resume とは別物（あちらは貸出中の同じ VM で続ける）
- --branch  : --from のとき、続きに使うブランチ（既定は前回の state.json の `wip_branch`）。origin/<名前> から作業ブランチを作る
- --wait    : プールに空きが無い（sandbox take が「空きなし」）とき、失敗せず空くまで待って take し直す（単独なら 3600 秒、`--wait=秒` で上限を指定。チケット 242）
              pull backend（macOS / Windows / Linux）では「worker を他の run が使っている」＝ lease / 前の操作の競合を同じ待ちに乗せる（373 / ADR-0049）。
              待っている間は state.json の `current` が `wait-vm`（console のジョブ一覧・run 画面・MCP に「VM の空き待ち」と出る）。
              再試行の間隔は AIFACTORY_WAIT_POLL_S 秒（既定 30）。上限を超えたら state.json に `failure: "wait_timeout"` を書いて終わり、kb がチケットを todo に戻す。
              worker の取り合いは `--wait` 無しでも `wait_timeout`（誰が使っているかを `wait_reason` に残す）で終わり、チケットは todo のまま（blocked にしない）

agent が Claude の鍵の利用枠（5 時間 / 7 日の窓、429）で止まったら、追跡済みの変更を `wip: usage limit` としてコミットして wip ブランチに
保全し、戻しの回数を消費せず human で終わる（state.json に `failure: "quota"` / `quota_type` / `retry_after` / `quota_hits`、`resume_step` は
その step 自身）。kb はチケットを todo に戻し、制御系の timer（`glue/bin/dispatch --resume-paused`）が解除時刻の後に `kb run --from` で続きを回す。
鍵そのものが使えない（無効・失効・残高不足）ときは `failure: "key"` で、kb は blocked にする（鍵を直してから `kb run --from`）。チケット 380 / ADR-0043。

要る用途の Claude の鍵（workflow の agent step のモデルから fable / other を決めて `sandbox take --need=…` に渡す）が鍵プールに無ければ、
take が「鍵なし:」で止まり、runner は `failure: "nokey"` で終わる（VM は取らない）。kb はチケットを todo に戻し、鍵が登録されると
`dispatch --resume-paused` が初めから回し直す（ADR-0046）。

チケットの添付（kb attach）は take のときに VM の ~/work/<task>/attachments/ へ置き、各 step の依頼文で場所を案内する（チケット 353）。
artifact は VM の ~/work/<task>/ に置き、終了時に runs/<run>/work/ へ回収する。状態は runs/<run>/state.json。
step の出力はその場で runs/<run>/agent-*.log / code-*.log に流れる（console が途中でも読める）。state.json の `current` が今の step とログ名。
"""
import io, json, os, re, shlex, subprocess, sys, tarfile, tempfile, time, datetime, pathlib

HERE = pathlib.Path(__file__).resolve().parent.parent          # workflow/
ROOT = HERE.parent                                              # repo root
KIT = HERE / "kit"
sys.path.insert(0, str(ROOT / "lib")); import aifactory_paths as paths, aifactory_attachments as attachments, aifactory_gh as gh, aifactory_workflow as wf, aifactory_capabilities as caps, aifactory_sweep as sweep

def die(msg, code=1):
    print(f"[run] error: {msg}", file=sys.stderr); sys.exit(code)

def load_yaml(p):
    import yaml
    with open(p, encoding="utf-8") as f: return yaml.safe_load(f)

def validate(obj, schema_file, what):
    import jsonschema
    schema = json.load(open(schema_file, encoding="utf-8"))
    try:
        jsonschema.validate(obj, schema)
    except jsonschema.ValidationError as e:
        die(f"{what} が schema に合わない: {e.message} (at {'/'.join(map(str, e.absolute_path))})")

def sh(cmd, check=True, capture=True, input_text=None, env=None):
    # errors="replace": 子プロセスの出力に UTF-8 として壊れたバイトが混ざっても落ちない（2026-09-06 に merge step で UnicodeDecodeError で runner ごと死んだ）
    r = subprocess.run(cmd, shell=isinstance(cmd, str), text=True, capture_output=capture, errors="replace",
                       input=input_text, env={**os.environ, **(env or {})})
    if check and r.returncode != 0:
        raise RuntimeError(f"command failed ({r.returncode}): {cmd}\n{(r.stderr or '')[-2000:]}")
    return r

# `timeout <timeout_min>m claude …` が上限で切ったときの終了コード（GNU coreutils の timeout）。
# これを普通の失敗と混ぜると、未コミットの実装が消えたうえに「lint で落ちた」と誤読される（チケット 329）
AGENT_TIMEOUT_RC = 124
DEFAULT_TIMEOUT_MIN = 60
WIP_TIMEOUT_MESSAGE = "wip: step timeout"

# agent が「鍵の利用枠」で止まったとき（チケット 380 / ADR-0043）。時間上限と同じく「その step が失敗した」とは直し方が違う。
#   quota: 利用枠の上限（5 時間 / 7 日の窓、429、overage の枠、日次の支出上限）。待てば戻る → wip を保全して human 行き、
#          kb がチケットを todo に戻し、dispatch --resume-paused（制御系の timer）が解除時刻の後に `kb run --from` で続きを回す
#   key  : 鍵そのものが使えない（無効・失効・未ログイン・残高不足）。待っても戻らない → wip を保全して human 行き、kb は blocked
# 見分ける材料は stream-json の rate_limit_event（status: rejected）と result（is_error）の文言、それに stderr（2>&1 で同じ流れに乗る）。
# 文言は claude CLI が出すもの（"You've hit your limit · resets …" / 旧 "Claude AI usage limit reached|<epoch>" / API の error type）
WIP_QUOTA_MESSAGE = "wip: usage limit"
WIP_KEY_MESSAGE = "wip: token unusable"
PAUSE_KINDS = ("quota", "key")
QUOTA_TEXT = re.compile(r"hit your (?:\w+ )?limit|usage limit reached|Claude AI usage limit|rate_limit_error|API Error: 429|"
                        r"\b429\b.{0,40}rate.?limit|overloaded_error|API Error: 529|spend limit reached|billing_error.{0,120}resets", re.I | re.S)
KEY_TEXT = re.compile(r"credit balance (?:is )?too low|invalid api key|authentication_error|invalid_api_key|OAuth token (?:has )?(?:expired|revoked)|"
                      r"please run /login|not logged in|401 unauthorized|permission_error|billing_error|Invalid authentication", re.I)
# 旧形式の文言に入る解除時刻（epoch 秒）。新形式（"resets 3pm (Asia/Tokyo)"）は人向けなので読まず、rate_limit_event の resetsAt を使う
LIMIT_EPOCH = re.compile(r"usage limit reached\|(\d{9,11})")


def classify_agent_stop(rate_limit, result_ev, plain_text):
    """agent の止まり方が「鍵の利用枠」か「鍵が使えない」か（それ以外は None）。戻り: (kind, info)。
    info は記録に残す事実だけ: quota_type（five_hour / seven_day / … / unknown）と retry_after（オフセット付き ISO。分からなければ None）。
    rate_limit は EventRenderer が拾った最後の rejected の rate_limit_info、result_ev は result イベント（無ければ None）、
    plain_text は JSON でない行（stderr の文言）だけ。tool_result の中身は見ない（agent が読んだコードに "Invalid API key" と
    書いてあるだけで鍵の失効と誤読しないため）。呼び元は agent が失敗したとき（rc≠0 か result が is_error）だけ呼ぶ"""
    res_text = str((result_ev or {}).get("result") or "")
    res_err = bool((result_ev or {}).get("is_error")) or str((result_ev or {}).get("subtype") or "").startswith("error")
    # 1) CLI が「拒否された」と言った rate_limit_event が一番確か（解除時刻も付いてくる）
    if rate_limit:
        reset = rate_limit.get("resetsAt")
        return "quota", {"quota_type": str(rate_limit.get("rateLimitType") or "unknown"), "retry_after": _iso_from_epoch(reset)}
    # 2) result（エラー）か素の行の文言。利用枠の文言を鍵の文言より先に見る（"billing_error … resets" は日次の枠）
    body = res_text if res_err else ""
    for sample in (body, plain_text):
        if not sample: continue
        if QUOTA_TEXT.search(sample):
            m = LIMIT_EPOCH.search(sample)
            return "quota", {"quota_type": "unknown", "retry_after": _iso_from_epoch(int(m.group(1))) if m else None}
        if KEY_TEXT.search(sample):
            return "key", {"quota_type": None, "retry_after": None}
    return None, {}


def _iso_from_epoch(v):
    try: n = int(v)
    except (TypeError, ValueError): return None
    if n <= 0: return None
    return datetime.datetime.fromtimestamp(n).astimezone().isoformat(timespec="seconds")

# sandbox take が「プールに空きが無い」と言うときの目印（sandbox/bin/sandbox の die 文言）。ここを変えるなら sandbox 側も一緒に直す
POOL_BUSY = "に空きなし"
# sandbox take が「要る用途の Claude の鍵が鍵プールに無い」と言うときの目印（同上。ADR-0046）。鍵が登録されるまで一時停止にする
NO_KEY = "鍵なし:"


class NoKey(RuntimeError):
    """sandbox take が鍵プールに要る用途の鍵を見つけられなかった（VM は取っていない）。鍵が登録されれば回せるので、
    利用枠切れと同じく一時停止にする: kb はチケットを todo に戻し、dispatch --resume-paused が鍵の登録を見て回し直す（ADR-0046）"""


class PoolBusy(RuntimeError):
    """VM / worker が塞がっていて take できなかった（待てば空く見込みがある失敗。--wait のときだけ再試行する）。

    reason は「誰がいつから使っているか」の 1 行（pull backend が入れる。チケット 373）。これがある失敗は
    「直す所が無い」ので、--wait を付けていなくてもチケットは todo に戻す（kb が wait_reason を note に写す）。
    Proxmox のプール満杯（sandbox take の「空きなし」）は従来どおり reason 無し"""
    def __init__(self, msg, reason=""):
        super().__init__(msg); self.reason = reason


class PoolTimeout(RuntimeError):
    """--wait の上限まで待っても空きが出なかった。チケットは todo に戻す（kb が failure: wait_timeout を見る）。
    why は最後に見た待ちの理由（PoolBusy.reason。kb の note に出る）"""
    def __init__(self, msg, waited_s, why=""):
        super().__init__(msg); self.waited_s = waited_s; self.why = why


class PrepareFailed(RuntimeError):
    """project.yml の prepare（貸出直後の準備）が失敗した。環境が整っていない VM で agent を起こしても
    「環境起因の赤」を直そうとして時間を焼くだけなので、工程を 1 つも始めずに終わる（チケット 330）"""


class ClockSkew(RuntimeError):
    """貸出直後のゲストの時計が制御系とずれすぎていた（チケット 491）。

    プール VM は RAM 込みの snapshot を巻き戻して貸すので、復元直後のゲストは snapshot 取得時刻から
    時計が再開し、timesyncd の次のポーリングまで数日ずれたまま走る。その間に付いた commit の author date と
    agent が書く ADR の日付が嘘になり、`git log --since` も `--diff-filter=A` も取りこぼす。
    sandbox take 側で合わせてはいるが（sync_clock）、NTP が届かない網では黙って通ってしまうので、
    ここで必ず測り、ずれていれば工程を 1 つも始めずに終わる（嘘の日付を履歴に残さない）"""


# 秘密の伏せ方とトークンの払い出しは lib/aifactory_gh.py に 1 か所（kb も同じものを使う。チケット 345）
SECRET_LINE = gh.SECRET_LINE
scrub = gh.scrub

def ensure_gh_token(pj, repo=""):
    """制御系で `gh` を使う前に GH_TOKEN を用意する（lib/aifactory_gh.py）。戻り: 払い出せなかった理由（要らない / できたときは None）"""
    return gh.ensure_gh_token(pj, repo, log=lambda m: print(f"[run] {m}", flush=True))


def stream(cmd, log_path, render=None, env=None):
    """子プロセスの出力を 1 行ずつ log_path に流す（console が追い読みできる）。render(line) が与えられれば、その戻り値
    （None なら書かない）を書く。戻り: (rc, 書いた全文)。step の途中経過を見えるようにするため（2026-09-06）"""
    out = []
    with open(log_path, "ab") as f:
        p = subprocess.Popen(cmd, shell=isinstance(cmd, str), stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                             env={**os.environ, **(env or {})})
        for raw in p.stdout:
            line = raw.decode("utf-8", "replace")
            text = render(line) if render else line
            if text is None: continue
            if not text.endswith("\n"): text += "\n"
            f.write(text.encode("utf-8")); f.flush(); out.append(text)
        rc = p.wait()
    return rc, "".join(out)


def _short(s, n=300):
    s = str(s).replace("\n", "⏎")
    return s if len(s) <= n else s[:n] + f"…(+{len(s) - n})"


class EventRenderer:
    """claude -p --output-format stream-json の 1 行（JSON）を、人が読める 1〜数行に起こす。JSON でない行はそのまま通す"""
    def __init__(self, t0):
        self.t0 = t0; self.raw = []; self.last_text = ""
        self.plain = []            # JSON でない行（stderr の文言。鍵の失効・利用枠の見分けに使う。tool_result の中身は入らない）
        self.rate_limit = None     # 最後に見た「拒否」の rate_limit_info（利用枠の上限。resetsAt が解除時刻）
        self.result = None         # result イベント（is_error / subtype / result の文言）
    def stamp(self):
        t = int(time.time() - self.t0); return f"[+{t // 60:02d}:{t % 60:02d}]"
    def __call__(self, line):
        line = line.rstrip("\n")
        if not line.strip(): return None
        try: ev = json.loads(line)
        except ValueError:
            self.plain.append(line)
            return f"{self.stamp()} {line}"
        self.raw.append(line)
        t = ev.get("type"); st = self.stamp()
        if t == "rate_limit_event":
            # claude CLI が利用枠の状態を伝えてくる（チケット 380）。拒否だけ覚え、警告は 1 行出すに留める
            info = ev.get("rate_limit_info") or {}
            status = str(info.get("status") or "")
            if status == "rejected":
                self.rate_limit = info
                return f"{st} rate limit: rejected ({info.get('rateLimitType') or '?'}; resets {_iso_from_epoch(info.get('resetsAt')) or '?'})"
            if status == "allowed_warning":
                return f"{st} rate limit: warning ({info.get('rateLimitType') or '?'}; utilization {info.get('utilization', '?')})"
            return None
        if t == "system":
            if ev.get("subtype") == "init": return f"{st} init model={ev.get('model', '?')} tools={len(ev.get('tools', []))} cwd={ev.get('cwd', '')}"
            return None
        if t == "assistant":
            outs = []
            for b in (ev.get("message") or {}).get("content") or []:
                if b.get("type") == "text" and b.get("text", "").strip(): self.last_text = b["text"].strip(); outs.append(f"{st} {self.last_text}")
                elif b.get("type") == "tool_use":
                    inp = b.get("input") or {}
                    arg = inp.get("command") or inp.get("file_path") or inp.get("pattern") or inp.get("path") or inp.get("query") or inp.get("description")
                    outs.append(f"{st} ▶ {b.get('name')}: {_short(arg if arg is not None else json.dumps(inp, ensure_ascii=False))}")
            return "\n".join(outs) if outs else None
        if t == "user":
            outs = []
            for b in (ev.get("message") or {}).get("content") or []:
                if b.get("type") != "tool_result": continue
                c = b.get("content")
                if isinstance(c, list): c = "\n".join(x.get("text", "") for x in c if isinstance(x, dict))
                lines = [l for l in str(c or "").splitlines() if l.strip()]
                head = "\n".join("    " + _short(l, 200) for l in lines[:3]) + (f"\n    …(+{len(lines) - 3} 行)" if len(lines) > 3 else "")
                outs.append(("  ↳ ERROR\n" if b.get("is_error") else "  ↳\n") + head if head else ("  ↳ ERROR (空)" if b.get("is_error") else "  ↳ (空)"))
            return "\n".join(outs) if outs else None
        if t == "result":
            self.result = ev
            cost = ev.get("total_cost_usd"); dur = ev.get("duration_ms") or ev.get("duration_api_ms") or 0
            head = f"{st} result: {ev.get('subtype', '?')} turns={ev.get('num_turns', '?')} duration={int(dur) // 1000}s" + (f" cost=${cost:.2f}" if isinstance(cost, (int, float)) else "")
            body = (ev.get("result") or "").strip()
            return head + ("\n" + body if body and body != self.last_text else "")   # 直前の assistant 文と同じなら繰り返さない
        return None


def run_name(pj, task, dry=False, resume=False):
    recorded = os.environ.get("AIFACTORY_RESUME_RUN") if resume and not dry else None
    if recorded:
        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}-" + re.escape(pj) + "-" + re.escape(task), recorded):
            raise ValueError("invalid recorded resume run")
        return recorded
    return f"{datetime.date.today().isoformat()}-{pj}-{task}" + ("-dry" if dry else "")


# --from / --branch で受け取るブランチ名の形（人が打つ値が初めてシェルに乗る経路。使う所では shlex.quote もする）
BRANCH_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._/-]*")

def valid_branch(b):
    """git のブランチ名として素直に使える形か（`..` や末尾の `/` `.lock` は git が拒む。先頭の `-` は引数に化ける）"""
    return bool(b) and bool(BRANCH_NAME.fullmatch(b)) and ".." not in b and not b.endswith(("/", ".lock"))


# review.md の読み取り。1 行目 `# レビュー: PASS|FAIL` は 5 つの workflow が共有する契約で、変えない（ADR-0036 / ADR-0042）。
# severity は 2 行目以降の `severity: minor|major` 行（FAIL のときだけ reviewer が書く。ADR-0053）
SEVERITY_LINE = re.compile(r"^\s*severity\s*[:：]\s*(minor|major)\b", re.IGNORECASE | re.MULTILINE)

def review_verdict(text):
    """review.md の判定。1 行目に PASS が含まれれば PASS（それ以外は FAIL 扱い）。中身が無ければ None"""
    head = (text or "").splitlines()[:1]
    if not head: return None
    return "PASS" if "PASS" in head[0] else "FAIL"


# report.md の `## 未検証項目`（チケット 552）。実装役の良心に任せず、節が空なら「出力が無い」と同じ扱いにする。
# 「無し」と書けば通る（空欄のまま出せないだけで、書くことを増やす仕掛けではない）
UNVERIFIED_HEADING = re.compile(r"^(#{1,6})\s*未検証項目")


def report_unverified(text):
    """report.md に `## 未検証項目` があり、中身が 1 行でもあるか → (ok, 直し方)。

    review_verdict() と同じく本文の字面だけを見る（VM も state も要らない）。見出しの次の見出しまでに
    本文の行が 1 つも無ければ未記入。
    """
    lines = (text or "").splitlines()
    start = level = None
    for i, l in enumerate(lines):
        m = UNVERIFIED_HEADING.match(l.strip())
        if m: start, level = i + 1, len(m.group(1)); break
    if start is None:
        return False, "report.md に `## 未検証項目` が無い（この環境で確かめられなかった完了条件を文面のまま列挙する。無ければ「無し」と書く）"
    for l in lines[start:]:
        m = re.match(r"^(#{1,6})\s", l)
        if m and len(m.group(1)) <= level: break
        if l.strip(): return True, ""
    return False, "report.md の `## 未検証項目` が空（確かめられなかった完了条件を文面のまま書く。無ければ「無し」と書く）"


def review_severity(text):
    """review.md の `severity: minor|major` 行（無ければ None）。1 行目の判定行は見ない（`# レビュー: PASS` を拾わない）"""
    body = "\n".join((text or "").splitlines()[1:])
    m = SEVERITY_LINE.search(body)
    return m.group(1).lower() if m else None


def resume_start(state, steps):
    """`--resume`（貸出中の VM で続き）の開始工程を、state.json の `next` ではなく工程履歴から決める（チケット 338 / ADR-0047）。

    `next` は「次の遷移先」であって「次に走らせる工程」ではない。失敗した run では必ず `human` なので、
    そのまま開始工程にすると工程ループに 1 度も入らず、何もせず VM を返して終わってしまう
    （Mac の準備が失敗した後の `--resume` で実測。ログは「準備し直した → 返却 → result: human」だけ）。規則:

    - `next` が human / end 以外（Ctrl-C や runner が落ちた途中）→ そのまま `next`
    - `next` が human で工程履歴が空（1 工程も終えていない＝準備で落ちた）→ workflow の先頭工程
    - `next` が human で履歴あり → 最後に走った工程（gates 超過なら gates、implement の時間上限なら implement）
    - 続きが無い run（末尾が成功で `resume_step` も無い＝PR まで出ている）と `next: end` は止める

    止めるのは VM に触る前（`take` の前）。黙って返却するより、止まって人に選ばせる方が安い"""
    steps or die("workflow に step が無い")
    nxt = state.get("next") or "human"
    hist = state.get("history") or []
    if nxt == "end":
        die("この run は end まで終わっている（--resume で続けるものが無い）。kb reopen → kb run で回し直すこと")
    if nxt != "human":
        start = nxt
    elif not hist:
        start = steps[0]                    # 準備（provision / prepare）で落ちた run。先頭から回す
    else:
        last = hist[-1]
        if last.get("ok") and not state.get("resume_step"):
            die("この run に続きは無い（最後の工程は成功していて、やり直す工程も記録に無い）。"
                "kb reopen → kb run か、`kb run <id> --from <step>` で回し直すこと")
        start = last.get("step")
    start in steps or die(f"再開する工程 {start!r} が今の workflow（{' / '.join(steps)}）に無い。`--from <step>` で指定し直すこと")
    return start


# ---- artifact の回収（チケット 557 / ADR-0085）
# VM の ~/work/<task>/ に溜まった成果物（report.md / plan.md / research.md / 画像 / gates/*.log）を
# runs/<run>/work/ へ運ぶ。以前は `scp -r` 1 発で、成否も上限も見ていなかった（届かなくても記録が残らず、
# 「VM には在るのに read_file で見つからない」を後から切り分けられなかった）。いまは
# 列挙 → 上限で選別 → tar 1 接続で取得 → 届いたか検証 → state.json に記録、の 4 段で行う。
ARTIFACT_FILE_MAX = 4 * 1024 * 1024          # 1 ファイルの上限（console の read_file が画像を返せる上限と同じ）
ARTIFACT_TOTAL_MAX = 32 * 1024 * 1024        # 1 run の合計
ARTIFACT_COUNT_MAX = 256                     # 1 run の件数
ARTIFACT_SKIP_MAX = 128                      # state.json に残すスキップ記録の件数（名前は agent が作れるので丸める）
ARTIFACT_SUBDIRS = ("gates", "attachments")  # runner / kit が $WORK の下に作るディレクトリ。ここだけは中身も回収する
ARTIFACT_IMAGES = (".png", ".jpg", ".jpeg", ".gif", ".webp")
SKIP_REASONS = ("directory", "symlink", "non-regular", "size", "total", "count", "name", "missing", "unsafe")


def _artifact_rank(name):
    """回収の優先順。上限に当たったとき、何を先に残すか（報告書 → ゲートログ → 添付 → 画像 → その他）"""
    top = "/" not in name
    low = name.lower()
    if top and low.endswith((".md", ".txt")): return 0
    if name.startswith("gates/"): return 1
    if name.startswith("attachments/"): return 2
    if low.endswith(ARTIFACT_IMAGES): return 3
    return 4


def _artifact_label(name):
    """記録とログに載せる名前（制御文字は落とす。名前を作るのは VM の agent なので、ログに改行を差し込ませない）"""
    return "".join(c if c.isprintable() else "?" for c in name)[:255]


def _safe_artifact_name(name):
    """VM 側の名前をローカルの相対パスとして受け取れるか（`..`・絶対パス・空要素・制御文字・長すぎを拒む）"""
    if not name or name.startswith("/") or "\\" in name or len(name) > 255: return False
    if any(not c.isprintable() for c in name): return False
    parts = name.split("/")
    if any(p in ("", ".", "..") for p in parts): return False
    return parts[0] == name or parts[0] in ARTIFACT_SUBDIRS


def select_artifacts(entries):
    """VM 側の列挙結果から、回収する名前と飛ばした名前（理由つき）を決める純関数。

    entries は `(種別, サイズ, 相対パス)` の列（種別は find の %y。相対パスは bytes でも str でもよい）。
    返すのは `(accepted, skipped)` で、accepted は取得する相対パスの列（優先順）、
    skipped は `{"name", "reason", "size"}` の列。**飛ばしたものは黙って消さず必ず理由が残る**"""
    items = []
    for kind, size, name in entries:
        if isinstance(name, bytes):
            try: text = name.decode("utf-8")
            except UnicodeDecodeError:
                items.append((9, name.decode("utf-8", "replace"), size, "name")); continue
        else:
            text = name
        if kind == "d" and text in ARTIFACT_SUBDIRS: continue      # 中身を別に列挙している入れ物そのもの
        if kind != "f":
            items.append((9, text, size, "directory" if kind == "d" else "symlink" if kind == "l" else "non-regular")); continue
        if not _safe_artifact_name(text):
            items.append((9, text, size, "name")); continue
        items.append((_artifact_rank(text), text, size, None))
    accepted, skipped, total = [], [], 0
    for rank, name, size, reason in sorted(items, key=lambda i: (i[0], i[1])):
        if reason is None:
            if size > ARTIFACT_FILE_MAX: reason = "size"
            elif len(accepted) >= ARTIFACT_COUNT_MAX: reason = "count"
            elif total + size > ARTIFACT_TOTAL_MAX: reason = "total"
        if reason is None:
            accepted.append(name); total += size
        else:
            skipped.append({"name": _artifact_label(name), "reason": reason, "size": size})
    return accepted, skipped


def extract_artifacts(data, dest, accepted):
    """VM から受け取った tar を `dest` の下に展開する → `(written, unsafe)`。

    展開するのは accepted に挙げた名前の通常ファイルだけ。`..` や絶対パス、symlink のメンバーは書かずに
    `unsafe` として返す（tar の中身は VM の agent が作れるので、名前を信用して展開しない）"""
    want = set(accepted)
    written, unsafe = {}, []
    dest = pathlib.Path(dest)
    root = dest.resolve()
    with tarfile.open(fileobj=io.BytesIO(data), mode="r:") as tf:
        for m in tf:
            name = m.name[2:] if m.name.startswith("./") else m.name
            if not m.isreg() or name not in want or not _safe_artifact_name(name):
                if m.isdir(): continue
                unsafe.append({"name": _artifact_label(name), "reason": "unsafe", "size": int(m.size)}); continue
            out = dest / name
            if root not in out.resolve().parents or out.is_symlink() or out.parent.is_symlink():
                unsafe.append({"name": _artifact_label(name), "reason": "unsafe", "size": int(m.size)}); continue
            out.parent.mkdir(parents=True, exist_ok=True)
            src = tf.extractfile(m)
            body = src.read() if src else b""
            with tempfile.NamedTemporaryFile(dir=str(out.parent), delete=False) as f:
                f.write(body); f.flush(); os.fsync(f.fileno()); tmp = f.name
            os.replace(tmp, str(out))
            written[name] = len(body)
    return written, unsafe


class Run:
    # backend（macos / windows / linux）が「待てば解ける失敗」を上げるための入口。
    # backend は Run クラスしか受け取らないので、例外の種類はクラス属性で渡す（チケット 373）
    PoolBusy = PoolBusy
    PoolTimeout = PoolTimeout
    # 鍵プールに要る用途の鍵が無いときの例外と、そのとき保全する wip の文言（pull backend が使う。チケット 391）
    NoKey = NoKey
    WIP_KEY_MESSAGE = WIP_KEY_MESSAGE
    # 条件を満たさない PJ では runner が工程ごと飛ばす code step（今は auto_merge を書いていない PJ の automerge。ADR-0042）。
    # 「その backend が実装していなくても起動を拒む必要がない step」でもあるので、pull backend の起動時検証も
    # ここを読む（判断を 2 か所に書かない。チケット 386）
    SKIPPABLE_CODE_STEPS = frozenset({"pr-automerge.sh"})

    def __init__(self, pj, task, wf_name, ticket, dry=False, keep=False, resume=False, wait_s=0, from_step=None, from_branch=None):
        self.pj, self.task, self.wf_name, self.dry, self.keep, self.resume = pj, task, wf_name, dry, keep, resume
        self.wait_s = wait_s        # プールに空きが無いときに待つ上限（秒。0 なら待たずに失敗する）
        # --from の再開（チケット 333）。--resume（貸出中の同じ VM で続ける）とは別経路で、新しい VM を取り直す
        self.from_step = self.from_branch = self.from_run = None
        self.from_state = {}
        self.last_severity = None    # 直前の reviewer の FAIL の重さ（`severity: minor|major`）。transition() が読む
        self.last_sweep = None       # 直前の step の掃き寄せで拾った / 除外したファイル（history に残す。572）
        self.project_dir = paths.project_dir(pj) or die(f"PJ {pj} の定義が無い（{' / '.join(str(d / pj) for d in paths.PROJECT_DIRS)}）")
        (self.project_dir / "project.yml").exists() or die(f"{self.project_dir}/project.yml が無い")
        self.project = load_yaml(self.project_dir / "project.yml")
        validate(self.project, KIT / "schema" / "project.schema.json", f"{self.project_dir.name}/project.yml")
        if self.project.get("prepare"):     # VM を借りる前に気づく（借りた後だと VM を返す手間が要る。330）
            (self.project_dir / self.project["prepare"]).is_file() or die(
                f"project.yml の prepare が指すスクリプトが無い: {self.project_dir / self.project['prepare']}")
        self.wf = load_yaml(KIT / "workflows" / f"{wf_name}.yml")
        validate(self.wf, KIT / "schema" / "workflow.schema.json", f"kit/workflows/{wf_name}.yml")
        self.steps = {s["id"]: s for s in self.wf["steps"]}
        self.routes = dict(l.split("=", 1) for l in (KIT / "routes.env").read_text().splitlines()
                           if l and not l.startswith("#") and "=" in l)
        self.ticket = pathlib.Path(ticket).read_text(encoding="utf-8")
        self.title = re.sub(r"^#\s*", "", self.ticket.splitlines()[0]).strip()[:70]
        base = self.wf.get("base_branch") or self.project["base_branch"]
        if base == "hotfix_base": base = self.project.get("hotfix_base") or self.project["base_branch"]
        ov = (self.project.get("workflow_overrides") or {}).get(wf_name) or {}
        self.base = ov.get("base_branch", base)
        self.auto_merge = self.normalize_auto_merge(self.project.get("auto_merge"))
        slug = re.sub(r"[^a-z0-9]+", "-", self.title.lower().encode("ascii", "ignore").decode())[:30].strip("-") or wf_name
        self.branch = f"sandbox/{task}-{wf_name}-{slug}"
        # start: pr … チケット 2 行目 `pr: <番号>` の PR head を作業ブランチにし、base はその PR の base
        self.pr_number = None
        if self.wf.get("start") == "pr":
            m = re.search(r"^pr:\s*#?(\d+)\s*$", self.ticket, re.M)
            m or die("start: pr の workflow はチケットに `pr: <番号>` の行が要る")
            self.pr_number = m.group(1)
            if not dry:
                app_err = ensure_gh_token(pj, self.project["repo"])
                r = sh(["gh", "pr", "view", self.pr_number, "-R", self.project["repo"], "--json", "headRefName,baseRefName,state"], check=False)
                if r.returncode != 0:
                    why = (scrub(r.stderr or "").strip() or f"rc={r.returncode}")[-500:]
                    die(f"gh pr view が失敗: {why}" + (f" / GH_TOKEN が無く、`sandbox gh-app token {pj}` も失敗: {app_err}" if app_err else ""))
                info = json.loads(r.stdout)
                info["state"] == "OPEN" or die(f"PR #{self.pr_number} が OPEN でない: {info['state']}")
                self.branch, self.base = info["headRefName"], info["baseRefName"]
            else:
                self.branch = f"(pr #{self.pr_number} head)"
        self.work = f"/home/dev/work/{task}"
        self.run_dir = paths.RUNS / run_name(pj, task, dry, resume)
        # --from の解決は退避より前に行う（指定が悪くて die するとき、前回の run を -attemptN に動かしたままにしない）
        if from_step is not None or from_branch is not None: self.resolve_from(from_step, from_branch)
        self.retired = None
        if self.run_dir.exists() and not resume and not dry:
            # 同じ日の再実行で前回の記録を上書きしない。前回分は -attemptN に退避（2026-09-06 に kumitate 203 の 1 回目を消してしまった）
            n = 1
            while (self.run_dir.parent / f"{self.run_dir.name}-attempt{n}").exists(): n += 1
            self.retired = self.run_dir.parent / f"{self.run_dir.name}-attempt{n}"
            self.run_dir.rename(self.retired)
            # 前回の run が「今日の同じ名前の run」だったなら、それは今退避したディレクトリ
            if self.from_run is not None and self.from_run.name == self.run_dir.name: self.from_run = self.retired
        self.run_dir.mkdir(parents=True, exist_ok=True)
        self.state_file = self.run_dir / "state.json"
        self.state = json.loads(self.state_file.read_text()) if (resume and self.state_file.exists()) else {
            "pj": pj, "task": task, "workflow": wf_name, "branch": self.branch, "base": self.base,
            "started": datetime.datetime.now().astimezone().isoformat(timespec="seconds"), "history": [], "loops": {}, "severity_bonus": {}, "next": self.wf["steps"][0]["id"]}
        if resume:
            self.branch = self.state["branch"]; self.base = self.state["base"]
            # 開始工程は `next`（＝遷移先。失敗した run では必ず human）ではなく履歴から決め直す（338）。
            # 前回の「終わり方」も消す（消さないと kb / console が古い finished と result を見て、続いている run を終わったものと読む）
            self.state["next"] = resume_start(self.state, [s["id"] for s in self.wf["steps"]])
            for field in ("result", "finished", "error", "failure", "elapsed_s", "resume_step", "pr_url", "wip_branch"):
                self.state.pop(field, None)
            self.save()
        if self.from_step:
            # 途中の step から始める。loops は空のまま（review→implement の戻しは、この run で新しく数え直す）
            self.state.update({"next": self.from_step, "from_step": self.from_step, "from_branch": self.from_branch,
                               "resumed_from": self.from_run.name if self.from_run else None})
            # 前回も利用枠で止まっていたなら、その回数を引き継ぐ（続けて何度も VM を取り直さないための上限に使う。380）
            if self.from_state.get("failure") == "quota":
                self.state["quota_hits"] = int(self.from_state.get("quota_hits") or 0)
        (self.run_dir / "ticket.md").write_text(self.ticket, encoding="utf-8")
        if not resume:
            # ticket.md だけの run を残さない。take の途中で落ちても console と kb が読める記録にする（2026-09-08 チケット 238）
            self.state["current"] = {"step": "take", "kind": "take", "log": None,
                                     "since": datetime.datetime.now().astimezone().isoformat(timespec="seconds")}
            self.save()

    AUTO_MERGE_DEFAULTS = {"method": "merge", "wait_min": 20, "delete_branch": True, "require_checks": True}

    @staticmethod
    def normalize_auto_merge(v):
        """project.yml の `auto_merge` を「無し（None）」か「全部の値が埋まった dict」のどちらかにする（ADR-0042）。
        無し / false は今までどおり（PR を作って人間に渡す）。true は既定値、dict は書かれた分だけ上書き"""
        if not v: return None
        return {**Run.AUTO_MERGE_DEFAULTS, **(v if isinstance(v, dict) else {})}

    def resolve_from(self, from_step, from_branch):
        """`--from` の再開: 「どの step から」「どのブランチの続きから」を、指定と前回の run の記録から決める（チケット 333）。

        前回の run は AIFACTORY_FROM_RUN で受け取り、run 名の形（<日付>-<pj>-<task>）しか受け付けない
        （`--resume` の AIFACTORY_RESUME_RUN と同じガード。他チケットの記録や任意のパスを読ませない）。
        step もブランチも決まらなければ die する（推し測って research から回し直さない）。"""
        prev = os.environ.get("AIFACTORY_FROM_RUN") or ""
        if prev:
            if not re.fullmatch(r"\d{4}-\d{2}-\d{2}-" + re.escape(self.pj) + "-" + re.escape(self.task), prev):
                raise ValueError("invalid recorded from run")
            d = paths.RUNS / prev            # 今日の同じ名前なら、この後の退避で -attemptN に付け替える（呼び元）
            if d.is_dir(): self.from_run = d
        if self.from_run and (self.from_run / "state.json").exists():
            try: self.from_state = json.loads((self.from_run / "state.json").read_text(encoding="utf-8"))
            except ValueError: self.from_state = {}
        hist = self.from_state.get("history") or []
        step = from_step or self.from_state.get("resume_step") or (hist[-1].get("step") if hist else None)
        step or die("再開する step が決まらない（前回の記録に resume_step が無い）。--from <step> で指定すること")
        step in self.steps or die(f"step {step} は workflow {self.wf_name} に無い（{' / '.join(self.steps)}）")
        branch = from_branch or self.from_state.get("wip_branch")
        branch or die("続きに使うブランチが記録に無い（前回の wip_branch が空）。--branch=<名前> で指定すること")
        valid_branch(branch) or die(f"ブランチ名として使えない: {branch}")
        self.from_step, self.from_branch = step, branch

    def carry_work(self):
        """前回の run で回収した work/*.md（plan.md / research.md / review.md など）を新しい VM に持ち込む。
        ticket.md と prompt.md は今回のものを使うので運ばない（pr_url は拡張子が無いので対象外）"""
        src = (self.from_run / "work") if self.from_run else None
        if not src or not src.is_dir(): return []
        names = []
        for f in sorted(src.iterdir()):
            if not f.is_file() or f.suffix not in (".md", ".txt") or f.name in ("ticket.md", "prompt.md"): continue
            self.scp_to(f, f"{self.work}/{f.name}"); names.append(f.name)
        self.log(f"前回の run {self.from_run.name} から持ち込み: {', '.join(names) or '(無し)'}")
        return names

    def push_attachments(self):
        """チケットの添付（kb attach で入れた画像・PDF など）を VM の ~/work/<task>/attachments/ に置く（チケット 353）。

        本文（ticket.md）には添付のことが書かれていないので、置いた実績を state.json の `attachments` に残し、
        依頼文の案内はその記録だけを根拠に出す（運べていない backend で嘘の案内をしない）。
        `carry_work`（前回の run の work/*.md を持ち込む）とは別の経路。添付が無ければ何もしない"""
        items = attachments.listing(self.task)
        if not items: return []
        if not self.dry:
            self.sb(f"mkdir -p {self.work}/attachments")
            d = attachments.dir_for(self.task)
            self.scp_files_to([d / it["name"] for it in items], f"{self.work}/attachments/")
        self.state["attachments"] = [{"name": it["name"], "size": it["size"], "type": it["type"]} for it in items]
        self.save()
        self.log(f"チケットの添付 {len(items)} 件: " + ", ".join(it["name"] for it in items))
        return items

    def first_retry_note(self):
        """`--from` で始めるとき、最初の step の依頼文に付ける「前回の結果（直すこと）」。
        前回のレビュー指摘をそのまま渡す（これが無いと、人が読んだ指摘が次の run に伝わらない）。
        review そのものからやり直すときは付けない（reviewer に前回の自分の指摘を書き写させない）"""
        if not self.from_step or not self.from_run: return ""
        if (self.steps.get(self.from_step) or {}).get("role") == "reviewer": return ""
        rv = self.from_run / "work" / "review.md"
        body = rv.read_text(encoding="utf-8", errors="replace").strip() if rv.is_file() else ""
        # PASS した review.md は「直すこと」ではない。review の後の step（sync / pr / resolve）で止まった run を
        # やり直すとき、前回の合格の判定文を指摘として渡してしまっていた（ADR-0053）。FAIL のときだけ渡す
        if review_verdict(body) == "FAIL": return f"前回の run {self.from_run.name} のレビュー指摘（直すこと）:\n\n{body}"
        err = ([l.strip() for l in str(self.from_state.get("error") or "").splitlines() if l.strip()] or [""])[-1]
        if not err: return ""
        note = f"前回の run {self.from_run.name} は次の理由で止まった: {err}"
        if self.from_state.get("failure") in PAUSE_KINDS or (self.from_state.get("history") or [{}])[-1].get("failure") == "timeout":
            # 途中で切られた回の続き。作業ブランチには前回の途中までのコミット（wip）が入っている（380）
            note += ("\n\n前回は途中で中断されたので、作業ブランチには途中までのコミット（`wip:` で始まるもの）が入っている。"
                     "`git log` と `git diff origin/" + self.base + "...HEAD` で何処まで進んだかを確かめ、やり直さずに続きから進めること。")
        return note

    # ---------- VM helpers
    def sb(self, cmd, input_text=None, check=True):
        if self.dry: return ""
        r = sh(["sandbox", "ssh", self.task, cmd], check=check, input_text=input_text)
        return r.stdout
    def vm_read(self, rel):
        return self.sb(f"cat {self.work}/{shlex.quote(rel)} 2>/dev/null", check=False)
    # sandbox CLI と同じ置き場（~/.config/sandbox/state.json と鍵）。SANDBOX_STATE / SB_KEY で差し替えられる（テナント別の設定を使うとき。ADR-0017）
    SANDBOX_STATE = pathlib.Path(os.environ.get("SANDBOX_STATE") or (pathlib.Path.home() / ".config/sandbox/state.json"))
    SB_KEY = pathlib.Path(os.environ.get("SB_KEY") or (pathlib.Path.home() / ".ssh/conf.d/aifactory/sb_ed25519")).expanduser()
    def vm_ip(self):
        st = json.loads(self.SANDBOX_STATE.read_text())
        return st[self.task]["ip"]
    def scp_opts(self):
        o = ["-q", "-i", str(self.SB_KEY), "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null", "-o", "LogLevel=ERROR"]
        if os.environ.get("SB_JUMP"): o += ["-J", os.environ["SB_JUMP"]]
        return o
    def scp_to(self, local, remote):
        if self.dry: return
        sh(["scp", *self.scp_opts(), str(local), f"dev@{self.vm_ip()}:{remote}"])
    def scp_files_to(self, locals, remote_dir):
        """ファイルを 1 回の scp でディレクトリへ置く。**宛先にファイル名を書かない**（名前は scp の protocol で運ばれる）。

        利用者が付けた名前（日本語・空白入り）を宛先パスに書くと、どちらのモードでも安全にできない:
        OpenSSH 9 以降の既定（SFTP）は宛先をリモートシェルに通さないので quote した記号がそのまま名前になり、
        レガシー（`-O` / OpenSSH 8 以前）は逆にシェルを通すので quote しないと空白で切れる。
        宛先をディレクトリに固定すれば、宛先に利用者由来の文字列が入らずどちらでも名前が保たれる"""
        if self.dry or not locals: return
        sh(["scp", *self.scp_opts(), *[str(p) for p in locals], f"dev@{self.vm_ip()}:{remote_dir}"])

    def run_remote(self, cmd, log_path, render=None, timeout=3600):
        return stream(["sandbox", "ssh", self.task, cmd], log_path, render=render)

    # ---------- lifecycle
    # ゲストの時計を測る 1 行（UTC の epoch 秒）。backend が OS ごとに上書きする（windows.py は PowerShell）
    clock_probe_cmd = "date -u +%s"

    def check_clock(self):
        """貸出直後のゲストの時計を制御系と突き合わせる（チケット 491）。工程を始める前の 1 回だけ。

        ずれたまま走らせると、commit の author date も agent が書く ADR の日付も数日前になる（実測: #478 と #486 が
        6 日 17 時間）。履歴に嘘の日付が混ざると `git log --since` や `--diff-filter=A` が取りこぼし、後から直せない。
        測れた値は成否に関わらず state.json に残す（どの run がどれだけずれたかを後から数えられる）。
        run の途中でずれ直すことは kvm-clock では起きない前提なので、測るのはここだけ。`sandbox reset` で
        巻き戻し直したときは sandbox 側の sync_clock がまた合わせる"""
        if self.dry or self.resume: return
        tol = int(os.environ.get("AIFACTORY_CLOCK_TOLERANCE_S") or 120)
        # ssh そのものが通らないときは sb が上げる例外をそのまま通す（「時計が測れない」と言い換えない）
        out = (self.sb(self.clock_probe_cmd) or "").strip().splitlines()
        raw = (out or [""])[-1].strip()
        control = time.time()
        try:
            guest = int(raw)
        except ValueError:
            # 測れなかったものを「ずれていない」と読み替えない（黙って通すと嘘の日付が履歴に入る）
            raise ClockSkew(f"ゲストの時計を測れなかった（`{self.clock_probe_cmd}` が数字を返さない): {raw[:120]!r}")
        off = round(guest - control)
        self.state["clock_offset_s"] = off
        self.save()
        iso = lambda e: datetime.datetime.fromtimestamp(e).astimezone().isoformat(timespec="seconds")
        self.log(f"clock: guest offset {off}s（許容 {tol}s）")
        if abs(off) > tol:
            raise ClockSkew(f"ゲストの時計が制御系と {off} 秒ずれている（許容 {tol} 秒）: "
                            f"guest={iso(guest)} control={iso(control)}。"
                            f"そのまま回し直してよい（次の貸出が時計を合わせ直す）")

    def take(self):
        if self.dry:
            self.push_attachments()      # 転送はしないが、依頼文の案内は dry-run でも組み立てて見せる
            return
        if self.resume: return
        self.log("take")
        # この workflow の agent step が使うモデルから、要る鍵の用途（fable / other）を渡す。無い用途は take が「鍵なし:」で止める（ADR-0046）
        need = self.needed_keys()
        self.state["needed_keys"] = need; self.save()
        r = sh(["sandbox", "take", self.pj, self.task, "--need=" + ",".join(need)], check=False)
        if r.returncode != 0:
            why = scrub((r.stderr or "") + (r.stdout or "")).strip()[-2000:]
            # 「空きなし」だけは待てば解ける失敗なので分けて上げる（--wait。チケット 242）。他の take 失敗は従来どおり即 failed
            if POOL_BUSY in why: raise PoolBusy(why)
            if NO_KEY in why: raise NoKey(([l.strip() for l in why.splitlines() if NO_KEY in l] or [why])[-1])
            raise RuntimeError(f"command failed ({r.returncode}): sandbox take {self.pj} {self.task}\n{why}")
        out_lines = (r.stdout or "").strip().splitlines()
        # take の出力は最後の 1 行（[ok] …）だけ残すが、時計の是正（491）は run の記録に残す。
        # 「どれだけずれていた VM をいつ合わせたか」は、後から日付を疑うときの唯一の手がかりになる
        for l in out_lines[:-1]:
            if l.startswith("[clock]"): print(l)
        print((out_lines or [""])[-1])
        self.taken = True   # ここから先で落ちたら VM を返す（238）
        # checkout より前に時計を見る。ここから先の commit / ADR の日付が全部これに乗る（491）
        self.check_clock()
        self.sb(f"mkdir -p {self.work}")
        if self.from_branch:
            # --from: base ではなく前回の wip ブランチの続きから始める（実装済みのコミットを持ったまま次の step に入る。333）
            wip = shlex.quote(self.from_branch)
            self.sb(f"cd $SANDBOX_APP_DIR && git fetch -q origin {self.base} {wip} && git checkout -q -B {self.branch} origin/{wip} && git log -1 --format='wip: %h %s'")
        elif self.pr_number:
            self.sb(f"cd $SANDBOX_APP_DIR && git fetch -q origin {self.base} {self.branch} && git checkout -q -B {self.branch} origin/{self.branch} && git log -1 --format='head: %h %s'")
        else:
            self.sb(f"cd $SANDBOX_APP_DIR && git fetch -q origin {self.base} && git checkout -q -B {self.branch} origin/{self.base} && git log -1 --format='base: %h %s'")
        # checkout は「両方のコミットで同内容のファイルの局所変更」を持ち越す。テンプレートや前の便の汚れが
        # そのまま基準になるので、agent を入れる前に戻す（572）
        self.clean_start("checkout")
        self.prepare()
        self.clean_start("prepare")     # prepare.sh（依存の入れ直し・migration）が追跡ファイルを書き換えた分も戻す
        if self.from_step: self.carry_work()
        self.push_attachments()
        self.sb(f"cat > {self.work}/ticket.md", input_text=self.ticket)

    def prepare(self):
        """project.yml の `prepare`（任意）を checkout の直後に 1 回だけ走らせる（チケット 330）。

        VM は run のたびにテンプレート（provision.sh を焼いた時点）へ戻るので、そこから base が進んだ分だけ
        環境がずれる（依存の追加、DB migration）。そのずれをここで埋めてから agent を起こす。埋められなければ
        PrepareFailed を投げ、工程を 1 つも始めずに終わる（環境起因の赤を agent に直させない）。
        `--from` や PR 起点の run でも走らせる（続きであっても VM は素のテンプレートなので、環境は揃え直す）。
        pull backend（macOS / Windows / Linux）は take を独自に持ち、そちらは provision.sh が同じ役目を果たす。"""
        name = self.project.get("prepare")
        if not name: return
        src = self.project_dir / name
        # ここは take の後（VM を借りた後）。die（= sys.exit）で抜けると VM を返さず state.json に result も残らないので、
        # 例外にして main の except PrepareFailed に拾わせる（VM を返し failure: prepare で終える）。
        # 借りる前に気づけるよう __init__ でも同じ存在確認をしている（--dry-run でもそこで止まる）
        if not src.is_file(): raise PrepareFailed(f"project.yml の prepare が指すスクリプトが無い: {src}")
        self.log(f"prepare: {name}")
        self.scp_to(src, f"{self.work}/prepare.sh")
        # console と MCP が「今は準備中」と読めるようにする（pull backend の setup_project と同じ step 名・ログ名）
        self.set_current("prepare", "code", "code-prepare.log")
        rc, out = self.run_remote(f"cd $SANDBOX_APP_DIR && bash {self.work}/prepare.sh", self.run_dir / "code-prepare.log")
        if rc != 0:
            why = ([l.strip() for l in scrub(out).splitlines() if l.strip()] or ["(出力なし)"])[-1][:300]
            raise PrepareFailed(f"prepare ({name}) が rc={rc} で失敗: {why}")
    def take_waiting(self):
        """--wait のとき、プールに空きが出るまで take を呼び直す。待っている間は state.json の current を wait-vm にして
        console（ボードの実行中欄・run 画面）と MCP に「VM の空き待ち（n 分）」と見せる。
        再試行は sandbox 側のロック（234）の外なので安全。上限を超えたら PoolTimeout（= failure: wait_timeout）"""
        poll = float(os.environ.get("AIFACTORY_WAIT_POLL_S") or 30)
        started = None
        while True:
            try:
                return self.take()
            except PoolBusy as e:
                if not self.wait_s: raise
                reason = getattr(e, "reason", "")
                if started is None:
                    started = time.time()
                    # since は待ち始めの 1 度だけ（毎回書き直すと console の経過時間が振り出しに戻る）
                    self.state["current"] = {"step": "wait-vm", "kind": "wait", "log": None,
                                             "since": datetime.datetime.now().astimezone().isoformat(timespec="seconds")}
                    self.save()
                waited = int(time.time() - started)
                why = ([l.strip() for l in str(e).splitlines() if l.strip()] or ["(理由なし)"])[-1]
                if waited >= self.wait_s:
                    raise PoolTimeout(f"VM の空き待ちが上限 {self.wait_s // 60} 分（{self.wait_s} 秒）を超えました。{waited} 秒待機: {why}", waited, reason)
                self.log(f"VM 空き待ち {waited // 60} 分（上限 {self.wait_s // 60} 分）: {why}")
                time.sleep(poll)

    # VM 側の列挙。`work/` が無ければ rc 3（回収の失敗と区別する。自死した run では report.md が元から無い）。
    # 直下は 1 段だけ、ARTIFACT_SUBDIRS は中まで。名前に空白・日本語・改行が入っても壊れないよう NUL 区切りで返す
    LIST_SH = ("cd %s || exit 3; find . -mindepth 1 -maxdepth 1 -printf '%%y\\t%%s\\t%%P\\0'; "
               "for d in %s; do [ -d \"$d\" ] && find \"$d\" -mindepth 1 -printf '%%y\\t%%s\\t%%p\\0'; done; exit 0")

    def ssh_bytes(self, cmd, stdin=b"", timeout=120):
        """VM で 1 コマンド走らせて stdout を bytes で受ける（`sh()` は text なので tar を通せない）。

        経路は **`sandbox ssh`**（`sb()` / `run_remote()` と同じ）。`ssh` を直に呼ぶと VM への入り方が
        2 通りになり、`~/.config/sandbox/env` の `SB_JUMP`（CLI だけが読む）を迂回するうえ、
        PATH の偽 `sandbox` で VM を模す test が本物の ssh を掴んで timeout ぶん止まる"""
        return subprocess.run(["sandbox", "ssh", self.task, cmd],
                              input=stdin, capture_output=True, timeout=timeout)

    def artifact_error(self, why):
        self.state["artifacts_error"] = scrub(str(why)).strip()[-500:]
        self.state.setdefault("artifacts_received", False)
        self.save(); self.log(f"artifact 回収に失敗: {self.state['artifacts_error']}")

    def collect_artifacts(self):
        """VM の work/ を列挙 → 上限で選別 → tar 1 接続で取得 → 届いたか検証 → state.json に記録（チケット 557）"""
        work = shlex.quote(self.work)
        r = self.ssh_bytes(self.LIST_SH % (work, " ".join(ARTIFACT_SUBDIRS)))
        if r.returncode == 3:
            self.state["artifacts_received"] = False
            self.state["artifacts_error"] = "no work dir"
            self.save(); self.log(f"artifact 回収: {self.work} が無い"); return
        if r.returncode != 0:
            self.artifact_error(f"列挙に失敗 (rc={r.returncode}): " + r.stderr.decode('utf-8', 'replace')); return
        entries = []
        for rec in r.stdout.split(b"\0"):
            if not rec: continue
            parts = rec.split(b"\t", 2)
            if len(parts) != 3: continue
            kind, size, name = parts
            try: size = int(size)
            except ValueError: size = 0
            entries.append((kind.decode("ascii", "replace"), size, name))
        accepted, skipped = select_artifacts(entries)
        error = ""
        written = {}
        if accepted:
            payload = b"".join(n.encode("utf-8") + b"\0" for n in accepted)
            # scp に名前を並べない: 宛先に利用者由来の名前を書けない（scp_files_to の説明）うえ、1 件ずつでは接続が増える
            t = self.ssh_bytes(f"cd {work} && tar -cf - --null -T -", stdin=payload, timeout=600)
            if t.returncode != 0: error = f"取得に失敗 (rc={t.returncode}): " + t.stderr.decode("utf-8", "replace")
            dest = self.run_dir / "work"
            if dest.is_symlink(): raise RuntimeError(f"artifact の置き場が symlink: {dest}")
            dest.mkdir(parents=True, exist_ok=True)
            if t.stdout:
                try:
                    written, unsafe = extract_artifacts(t.stdout, dest, accepted)
                    skipped += unsafe
                except tarfile.TarError as e:
                    error = error or f"展開に失敗: {e}"
        missing = [n for n in accepted if n not in written]
        skipped += [{"name": _artifact_label(n), "reason": "missing", "size": 0} for n in missing]
        for s in skipped[:ARTIFACT_SKIP_MAX]:
            self.log(f"artifact skipped: {s['name']} ({s['reason']}, {s['size']} bytes)")
        self.state["artifacts_received"] = not missing and not error
        self.state["artifacts_count"] = len(written)
        self.state["artifacts_bytes"] = sum(written.values())
        if skipped: self.state["artifacts_skipped"] = skipped[:ARTIFACT_SKIP_MAX]
        if error: self.state["artifacts_error"] = scrub(error).strip()[-500:]
        self.save()
        self.log(f"artifact 回収: {len(written)} 件 / {sum(written.values())} bytes、skip {len(skipped)} 件"
                 + (f"（失敗: {self.state['artifacts_error']}）" if error else ""))

    def release(self):
        if self.dry: return
        # artifact 回収。**どこで失敗しても例外を外に出さない**（ここで止めると VM が返らずプールを塞ぐ）
        try:
            self.collect_artifacts()
        except Exception as e:
            try: self.artifact_error(f"{type(e).__name__}: {e}")
            except Exception: print(f"[run] artifact 回収に失敗: {e}")
        if self.keep: self.log("keep: release しない"); return
        self.log("release"); sh(["sandbox", "release", self.task], check=False)

    def log(self, msg):
        t = int(time.time() - self.t0) if hasattr(self, "t0") else 0
        print(f"[run {self.pj}/{self.task} {t}s] {msg}", flush=True)
    def save(self):
        self.state_file.write_text(json.dumps(self.state, ensure_ascii=False, indent=2), encoding="utf-8")
    def set_current(self, step_id, kind, log_name):
        """今動いている step とそのログ名を state.json に置く（console が「実行中の step」を追い読みするため）"""
        self.state["current"] = {"step": step_id, "kind": kind, "log": log_name, "since": datetime.datetime.now().astimezone().isoformat(timespec="seconds")}
        self.save()

    def refresh_token(self):
        """GitHub App の installation token は 1 時間で切れる。GitHub に触る前に払い出し直す（2026-09-06 に 84 分の run で失効して merge が失敗した）"""
        if self.dry: return
        r = sh(["sandbox", "reinject", self.task], check=False)
        if r.returncode != 0: print(f"[run] token refresh failed: {(r.stderr or r.stdout)[-300:]}")

    def preserve(self):
        """失敗・human 行きのとき、作業ブランチの HEAD を退避ブランチへ push して release による消失を防ぐ"""
        if self.dry: return ""
        wip = f"sandbox/{self.task}-{self.wf_name}-wip"
        self.refresh_token()
        # ゲストの叩き方は backend ごとに違う（Proxmox は ssh、pull backend は worker queue）。self.sb に寄せて
        # pull backend からも同じ保全が使えるようにする（チケット 282）。stdout しか返らないので stderr を混ぜる
        # HEAD ではなく作業ブランチを押す。gates の base 確認（330）が作業ツリーを戻し切れないと HEAD は origin/<base> に
        # detached のままで、HEAD を押すと実装役のコミットが base で上書きされて release で消える。通常は HEAD == branch
        out = self.sb(f"cd $SANDBOX_APP_DIR && git log --oneline -1 refs/heads/{self.branch} && git push -q --force origin refs/heads/{self.branch}:refs/heads/{wip} 2>&1 && echo pushed", check=False)
        ok = "pushed" in (out or "")
        self.log(f"preserve: {'origin/' + wip if ok else '失敗 ' + (out or '')[-200:]}")
        if not ok:
            # push できなくても作業を失わない: base からの差分をパッチとして run ディレクトリに残す（2026-09-06 に App の workflows 権限不足で push が拒否され、実装が巻き戻しで消えた）
            patch = self.sb(f"cd $SANDBOX_APP_DIR && git format-patch --stdout origin/{self.base}..refs/heads/{self.branch}", check=False)
            if patch.strip():
                (self.run_dir / "wip.patch").write_text(patch, encoding="utf-8")
                self.log(f"preserve: 代わりに {self.run_dir / 'wip.patch'} に差分を残した（git am で復元できる）")
        return wip if ok else ""

    # ---------- steps
    def needed_keys(self):
        """この workflow の agent step が使う鍵の用途（"fable" / "other"）。step のモデル名の系統で決める（Fable → fable、それ以外 → other）。
        どちらも無い（agent step が無い）workflow は other 1 つにしておく（take が何も要求しないと env の鍵で通ってしまうため）"""
        need = []
        for st in self.wf["steps"]:
            if "role" not in st: continue
            g = "fable" if self.token_family(self.model_for(st)[0]) == "FABLE" else "other"
            if g not in need: need.append(g)
        return sorted(need) or ["other"]

    def model_for(self, step):
        """実効モデルとクラス。規則は lib/aifactory_workflow.py が正本（設定画面が同じ答えを出すため。ADR-0062）"""
        r = wf.resolve_model(step, self.routes, os.environ.get("CLAUDE_MODEL"))
        if r is None: raise KeyError("role")                     # code 工程（従来も step["role"] で落ちていた）
        if not r["model_class"]: raise KeyError(step["role"])    # 未知の役割
        if not r["model"]: raise KeyError("MODEL_default")       # 経路表に既定が無い
        return r["model"], r["model_class"]

    def build_prompt(self, step, retry_note=""):
        p = self.project
        parts = [f"# 依頼: {self.title}（workflow: {self.wf_name} / step: {step['id']} / role: {step['role']}）", ""]
        parts += [(KIT / "roles" / "_common.md").read_text(encoding="utf-8"), ""]
        parts += [(KIT / "roles" / f"{step['role']}.md").read_text(encoding="utf-8"), ""]
        if step.get("brief"): parts += ["## この step の追加指示", "", step["brief"].strip(), ""]
        parts += ["## プロジェクト", "", f"- 名前: {p.get('display_name', p['name'])}（{p['repo']}）", f"- スタック: {p.get('stack','')}",
                  f"- アプリのディレクトリ（VM 内）: {p['app_dir']}（cwd はここ）", f"- 作業ブランチ: {self.branch}（元: {self.base}）"]
        parts += [f"- {x}" for x in p.get("facts", [])]
        if p.get("forbidden"): parts += ["", "### この PJ で禁止", ""] + [f"- {x}" for x in p["forbidden"]]
        if step["role"] == "reviewer" and p.get("review_points"): parts += ["", "### この PJ で必ず見る観点", ""] + [f"- {x}" for x in p["review_points"]]
        # この環境に無いと宣言された能力（project.yml の capabilities）と、チケットの完了条件の食い違い。
        # 宣言が無い PJ・false が 1 つも無い PJ では節ごと出ない（computer_use 節と同じ「有るときだけ足す」方式。チケット 552）
        section = self.capability_section()
        if section: parts += ["", section, ""]
        parts += ["", "## チケット", "", self.ticket.strip(), ""]
        # 添付は本文に入らない（正本は workspace の attachments/）。場所と名前だけ案内する（チケット 353）
        att = self.state.get("attachments") or []
        if att:
            parts += [f"- 添付: {self.work}/attachments/（{', '.join(a['name'] for a in att)}。"
                      "画像・PDF は Read で開いて見ること。本文と食い違うときは添付を優先し、その旨を報告に書く）", ""]
        for a in step.get("inputs", []):
            if a in ("git", "pr_url"): continue
            body = self.vm_read(a) if not self.dry else f"（dry-run: {a} の内容）"
            parts += [f"## 入力: {a}", "", "```", body.strip() if body.strip() else "（無し）", "```", ""]
        if step["role"] in ("reviewer",):
            diff = self.diff_summary() if not self.dry else "（dry-run: 差分）"
            parts += ["## 差分（origin/%s...HEAD）" % self.base, "", "```", diff.strip(), "```", "",
                      f"差分の中身は `git diff origin/{self.base}...HEAD` で読むこと。", ""]
        if p.get('computer_use'):
            parts += ["## VMの画面操作", "", "computer MCPツールで、この専用VMの画面取得・クリック・キー入力ができます。操作前にscreenshotで画面を確認し、その画像のピクセル座標を使ってください。typeは日本語対応、keyはWindowsのWINまたはMacのCMDとENTERなどを組み合わせます。操作後もscreenshotで結果を確認し、必要な画像を成果物として残してください。画像は作業ディレクトリ直下に別名の通常ファイルとして保存してください。サブディレクトリに置いた画像は回収されません。全成果物の合計上限は4 MiBです。個人のデスクトップや他のVMは操作しません。", ""]
        if retry_note: parts += ["## 前回の結果（直すこと）", "", retry_note, ""]
        outs = [a for a in step.get("outputs", []) if a not in ("git", "pr_url")]
        parts += ["## 出力（必須）", ""]
        parts += [f"- `{self.work}/{a}` に書く" for a in outs]
        if "git" in step.get("outputs", []):
            # 上限で切られる前提を agent に伝える。切られても commit 済みの分は wip ブランチに残る（チケット 329）
            parts += ["- 変更は作業ブランチにコミットする（push はしない）",
                      f"- この step の時間上限は {step.get('timeout_min', DEFAULT_TIMEOUT_MIN)} 分。30 分ごとに作業ブランチへコミットする"
                      "（WIP でよい。メッセージ先頭に `wip:`）。上限で切られると未コミットの変更は次の attempt に渡らない"]
        parts += ["", "終わったら、何をしたかを 5 行以内で標準出力に報告して終了する。"]
        return "\n".join(parts).replace("~/work/<task>/", self.work + "/")

    def capability_section(self):
        """依頼文の「## この環境で検証できないこと」。判定も文面も lib/aifactory_capabilities.py が正本（チケット 552）"""
        try:
            decl = caps.declared(self.project)
            if not decl: return ""
            return caps.prompt_section(decl, caps.scan(self.ticket, decl)).rstrip()
        except Exception as e:
            self.log(f"capabilities: 照合できなかった（{type(e).__name__}: {e}）。依頼文に節を足さない")
            return ""

    def diff_summary(self):
        return self.sb(f"cd $SANDBOX_APP_DIR && git diff --stat origin/{self.base}...HEAD && echo && git log --oneline origin/{self.base}..HEAD", check=False)

    @staticmethod
    def token_family(model):
        """モデル名 → 鍵の系統。規則は lib/aifactory_workflow.py が正本（設定画面が「その系統の鍵があるか」を
        同じ答えで言うため。ADR-0062 / ADR-0065）"""
        return wf.token_family(model)

    NO_KEY_IN_VM = "none"   # key_probe_command が「その系統の鍵が VM に無い」と言うときの 1 語

    def token_env_prefix(self, model):
        """agent の前に置く env の割り当て。VM の /run/sandbox/env（take が鍵プールから書く）の系統別の鍵をそのまま使う。
        env ファイルの鍵に落ちる経路は無い（ADR-0060）ので、無印の CLAUDE_CODE_OAUTH_TOKEN には戻らない。
        値は VM の中で展開されるので、runner は鍵を持たないし、ログにも出ない"""
        fam = self.token_family(model)
        if not fam: return ""
        return f'CLAUDE_CODE_OAUTH_TOKEN="$CLAUDE_CODE_OAUTH_TOKEN_{fam}" '

    @classmethod
    def key_probe_command(cls, fam):
        """どの鍵で動くかを名前だけ調べるコマンド（VM の中で走る。値は出さない）。
        /run/sandbox/env には take が鍵プールから選んだ鍵の名前が CLAUDE_KEY_NAME_<系統> で入っているので `(pool: <名前>)` を添える。
        その系統の鍵が無ければ `none`（呼び手が起動前に止める。認証エラーまで進ませない）"""
        return (f'test -n "${{CLAUDE_CODE_OAUTH_TOKEN_{fam}:-}}" '
                f'&& echo "CLAUDE_CODE_OAUTH_TOKEN_{fam}${{CLAUDE_KEY_NAME_{fam}:+ (pool: $CLAUDE_KEY_NAME_{fam})}}" '
                f'|| echo {cls.NO_KEY_IN_VM}')

    POOL_KEY_RE = re.compile(r"\(pool: ([A-Za-z0-9._-]+)\)")

    def report_key_launch(self, key_line):
        """鍵プールの鍵で claude を起動したことを制御系の pool に報告する（`sandbox keys used <名前>`。ADR-0044）。
        pool の uses は「割り当てた回数」で実使用と違ったので（2026-09-10）、起動の回数は runner が数える。失敗しても run は止めない"""
        m = self.POOL_KEY_RE.search(key_line or "")
        if not m or self.dry: return
        # sandbox が PATH に無い環境（CI・テスト）では sh() が OSError を投げる（check=False でも握らない）。
        # 報告できないだけで run を止める理由は無いので、ここで握って log に落とす（391）
        try:
            r = sh(["sandbox", "keys", "used", m.group(1)], check=False)
        except OSError as e:
            self.log(f"keys used {m.group(1)}: 報告できなかった（{type(e).__name__}）"); return
        if r.returncode: self.log(f"keys used {m.group(1)}: 報告できなかった（rc={r.returncode}）")

    def agent_command(self, prompt_path, model, timeout_min):
        computer = (" --strict-mcp-config --mcp-config " + shlex.quote(self.work + '/computer-mcp.json')) if self.project.get('computer_use') else ''
        return (f"cd $SANDBOX_APP_DIR && {self.token_env_prefix(model)}timeout {timeout_min}m claude -p \"$(cat {shlex.quote(prompt_path)})\" --model {shlex.quote(model)} "
                "--dangerously-skip-permissions --output-format stream-json --verbose" + computer + " 2>&1 < /dev/null")

    def commit_tracked(self, message):
        """追跡済みの未コミット変更だけをコミットする（step 終わりの掃き寄せと、時間上限・利用枠で切られたときの救済）。
        未追跡は絶対に足さない（`git add -A` が生成物と DB を拾った罠）。さらに依存ファイル（除外の規則は
        lib/aifactory_sweep.py に 1 か所）は拾わず HEAD の内容へ戻す。環境が解決し直しただけの lock / manifest が
        「意図した変更」として PR に載り、CI を 18 件赤にした（チケット 572）。
        拾った / 戻した一覧は本文・stdout・state.json に残す（差分を開かないと気づけない状態をやめる）。
        変更が無ければコミットは作らない（空のコミットを wip ブランチに残さない）。
        `git add` が失敗した回（step を殺されて `.git/index.lock` が残った等）は **戻しもコミットもせず**記録だけ残す
        （未コミットの実装は作業ツリーに残す。救済のための掃き寄せが救済対象を消さない）"""
        app = "cd $SANDBOX_APP_DIR && "
        excl = sweep.excludes(self.project)
        specs = " ".join(shlex.quote(s) for s in sweep.add_pathspecs(excl))
        dirty = sweep.status_paths(self.sb(app + sweep.STATUS_CMD, check=False))
        if not dirty: return
        # 「戻す対象」は **除外の glob だけ**で決める（判定は git 自身にさせる。同じ status を pathspec 付きで
        # もう一度数え、消えた分が除外に当たったファイル）。`git add` の結果から逆算すると、add が失敗した回に
        # 汚れ全部が「除外」になり、実装役の作業を worktree ごと消す（救済の場でこそ起きる）
        kept = sweep.status_paths(self.sb(app + sweep.STATUS_CMD + f" -- {specs}", check=False))
        pre_staged = sweep.nul_paths(self.sb(app + sweep.STAGED_CMD, check=False))
        excluded = sweep.excluded_paths(dirty, kept, pre_staged)
        if sweep.ADD_OK not in self.sb(app + f"git add -u -- {specs} && echo {sweep.ADD_OK}", check=False).split():
            # add が通らなかった回は **何もしない**（戻しもコミットもしない）。未コミットの実装は作業ツリーに残る＝
            # 変更前（`git add -u && (...|| git commit)`）と同じ安全側。黙って落とさず記録する
            self.log(f"掃き寄せ（{message}）: git add が失敗した。戻しもコミットもしない（{', '.join(dirty[:20])}）")
            print(sweep.add_failed_summary(message, dirty), flush=True)
            self.last_sweep = {"message": message, "committed": [], "excluded": [], "add_failed": True, "dirty": dirty}
            return
        committed = sweep.nul_paths(self.sb(app + sweep.STAGED_CMD, check=False))
        if excluded:
            # 作業ツリーごと HEAD へ戻す。ここで戻さないと、gates と reviewer が測る木と push する木がずれる
            # （#542 の実装役が手でやった復旧と同じ）。実パスを渡す（glob は一致 0 件の PJ で失敗する）
            restore = " ".join(shlex.quote(s) for s in sweep.restore_pathspecs(excluded))
            self.sb(app + f"git restore --source=HEAD --staged --worktree -- {restore}", check=False)
        if committed:
            self.sb(app + f"git commit -q -m {shlex.quote(message)} -m {shlex.quote(sweep.commit_body(committed, excluded))}", check=False)
        if committed or excluded:
            self.last_sweep = {"message": message, "committed": committed, "excluded": excluded}
            print(sweep.summary(message, committed, excluded), flush=True)

    def clean_start(self, stage):
        """run の開始時（checkout の直後と prepare の直後）に作業ツリーが汚れていないか確かめ、汚れていれば HEAD へ戻す。

        VM のテンプレートや前の便が残した追跡済みの変更が、そのまま次の便の「基準」になっていた（#542 の planner が
        着手前に `@types/node` の downgrade を見つけた）。掃き寄せの除外とは独立に効く（除外を入れても、汚れが
        残っていること自体が偽の baseline と誤診を生む）。未追跡は触らない（生成物・DB を消さない）。
        run は止めない（テンプレート起因なら全便が止まる）。戻した事実は state.json の `dirty_at_start` に残す。
        pull backend（macOS / Windows / Linux）の take は別実装なので対象外（チケット 572）"""
        app = "cd $SANDBOX_APP_DIR && "
        dirty = sweep.status_paths(self.sb(app + sweep.STATUS_CMD, check=False))
        if not dirty: return
        self.log(f"開始時の汚れ（{stage}）: {', '.join(dirty[:20])}")
        print(sweep.dirty_summary(stage, dirty), flush=True)
        self.sb(app + "git restore --source=HEAD --staged --worktree -- :/", check=False)
        self.state.setdefault("dirty_at_start", []).append({"stage": stage, "restored": dirty})
        self.save()

    def save_agent_changes(self):
        self.commit_tracked("sandbox: uncommitted changes by agent")
        return self.sb("cd $SANDBOX_APP_DIR && git status --porcelain | grep '^??' | head -20", check=False).strip()

    def output_exists(self, name):
        return bool(self.sb(f"test -s {self.work}/{shlex.quote(name)} && echo ok", check=False).strip())

    def has_changes(self):
        return bool(self.sb(f"cd $SANDBOX_APP_DIR && git log --oneline origin/{self.base}..HEAD", check=False).strip())

    def run_agent(self, step, retry_note=""):
        model, cls = self.model_for(step)
        prompt = self.build_prompt(step, retry_note)
        pf = self.run_dir / f"prompt-{step['id']}-{self.state['history'].__len__()}.md"
        pf.write_text(prompt, encoding="utf-8")
        fam = self.token_family(model)
        key = self.sb(self.key_probe_command(fam), check=False).strip() if fam and not self.dry else "CLAUDE_CODE_OAUTH_TOKEN"
        self.log(f"agent {step['id']} ({step['role']} / {cls} → {model}; key={key or 'CLAUDE_CODE_OAUTH_TOKEN'})")
        if key == self.NO_KEY_IN_VM:
            # take は要る用途を鍵プールから選んで VM に書く（ADR-0046）ので、通常ここには来ない。来るのは、貸出後に用途が増えた
            # （--from で別のモデルの step から回した等）か、reinject が別の用途で書き直したとき。認証エラーで工程を無駄にせず、
            # 鍵の失効と同じ扱い（failure: key → 人間待ち。戻しの回数は消費しない。ADR-0043）で止める
            group = "fable" if fam == "FABLE" else "other"
            why = f"VM に {model} 用の Claude の鍵（CLAUDE_CODE_OAUTH_TOKEN_{fam}）が無い。鍵プールに「{'Fable に使う' if group == 'fable' else 'Opus・Sonnet・Haiku に使う'}」鍵を登録して sandbox reinject {self.task} を実行してから、続きを回す"
            self.log(f"agent key: {step['id']} を起動しない（{why}）")
            self.last_fail = {"failure": "key", "reason": why, "last_output": ""}
            return False, f"agent key: {why}"
        self.report_key_launch(key)
        if self.dry: return True, "(dry-run)"
        prompt_path = f"{self.work}/prompt.md"
        self.scp_to(pf, prompt_path)
        # stream-json で 1 行 1 イベントを受け、人が読める形を agent-<step>-<n>.log に、生の JSON を .jsonl（git 追跡外）に流す。
        # console が step の途中でも追い読みできる（2026-09-06）。--verbose は -p + stream-json の必須オプション
        tmin = step.get("timeout_min", DEFAULT_TIMEOUT_MIN)
        cmd = self.agent_command(prompt_path, model, tmin)
        n = len(self.state["history"]); log_path = self.run_dir / f"agent-{step['id']}-{n}.log"
        self.set_current(step["id"], "agent", log_path.name)
        t = time.time(); r = EventRenderer(t)
        rc, out = self.run_remote(cmd, log_path, render=r, timeout=tmin * 60)
        (self.run_dir / f"agent-{step['id']}-{n}.jsonl").write_text("\n".join(r.raw) + ("\n" if r.raw else ""), encoding="utf-8")
        print("\n".join(out.strip().splitlines()[-8:]))
        self.log(f"agent done in {int(time.time()-t)}s (rc={rc})")
        if rc == AGENT_TIMEOUT_RC:
            # 上限で切られた（`timeout` の rc）。ここで保全しないと、未コミットの実装ごと release で消える（チケット 329）。
            # preserve() が HEAD を wip ブランチへ push するので、コミットさえ作れば次の attempt が続きから進める
            self.log(f"agent timeout: {step['id']} は時間上限 {tmin} 分で切られた。未コミットの変更を wip として保全する")
            self.commit_tracked(WIP_TIMEOUT_MESSAGE)
            self.last_fail = {"failure": "timeout", "timeout_min": tmin, "last_output": out[-3000:]}
            return False, f"agent timeout {rc}: 時間上限 {tmin} 分で中断（timeout）\n{out[-3000:]}"
        res_err = bool((r.result or {}).get("is_error")) or str((r.result or {}).get("subtype") or "").startswith("error")
        if rc != 0 or res_err:
            # 鍵の利用枠（quota）か鍵そのもの（key）で止まったなら、時間上限と同じく未コミットの変更を wip に保全して人へ返す。
            # on_fail の戻し（implement へ）は消費しない（呼び元が human に直行させる）。step 自身からやり直せば続きになる（チケット 380）
            kind, info = classify_agent_stop(r.rate_limit, r.result, "\n".join(r.plain))
            if kind:
                self.log(f"agent {kind}: {step['id']} は{'利用枠の上限' if kind == 'quota' else '鍵が使えず'}で止まった"
                         + (f"（{info.get('quota_type')}; 解除見込み {info.get('retry_after') or '不明'}）" if kind == "quota" else "")
                         + "。未コミットの変更を wip として保全する")
                self.commit_tracked(WIP_QUOTA_MESSAGE if kind == "quota" else WIP_KEY_MESSAGE)
                why = ([l.strip() for l in scrub(str((r.result or {}).get("result") or "") + "\n" + "\n".join(r.plain)).splitlines() if l.strip()] or [""])[-1][:200]
                self.last_fail = {"failure": kind, "quota_type": info.get("quota_type"), "retry_after": info.get("retry_after"),
                                  "reason": why, "last_output": out[-3000:]}
                return False, f"agent {kind}: {why}\n{out[-3000:]}"
        if rc != 0:
            self.last_fail = {"last_output": out[-3000:]}
            return False, f"agent exited {rc}: {out[-3000:]}"
        untracked = self.save_agent_changes()
        if untracked: print(f"[run] 未追跡ファイル（push 対象外）:\n{untracked}")
        # outputs の存在確認
        missing = [a for a in step.get("outputs", []) if a not in ("git", "pr_url") and not self.output_exists(a)]
        if "git" in step.get("outputs", []) and not self.has_changes():
            missing.append("git(コミットなし)")
        if missing: return False, f"出力が無い: {', '.join(missing)}"
        # report.md を出す実装役（implement / resolve）は「未検証項目」を空欄のまま出せない（チケット 552）。
        # ゲートが全緑でも、実ブラウザや docker が要る完了条件を満たした証拠にはならないため、そこを明示させる
        if step["role"] == "implementer" and "report.md" in step.get("outputs", []):
            ok, why = report_unverified(self.vm_read("report.md"))
            if not ok: return False, why
        if step["role"] == "reviewer":
            body = self.vm_read("review.md")
            ok = review_verdict(body) == "PASS"
            # FAIL の重さ（reviewer が書いていれば）。transition() が「軽微なら上限を 1 回だけ超えて戻す」判断に使う（ADR-0053）
            if not ok: self.last_severity = review_severity(body)
            return ok, body[:4000]
        return True, ""

    ADR_FILE = re.compile(r"^(\d{4})-[^/]*\.md$")

    def run_sync(self, step):
        """PR を作る直前に base の最新を取り込む（チケット 239）。並列に走った別 run の PR が先にマージされても、
        後発の PR が CONFLICTING で出てこないようにする。衝突は人間ではなく implementer に戻す（呼び元の on_fail）。
        作業ツリーを衝突状態のまま agent に渡さない（`git merge --abort` して、衝突したファイル名だけ渡す）。
        gates は回し直さない（差分は自分の変更 + base なので。ADR-0032）"""
        log_path = self.run_dir / f"code-{step['id']}-{len(self.state['history'])}.log"
        self.set_current(step["id"], "code", log_path.name)
        self.refresh_token()
        out = []
        def say(msg):
            out.append(msg); self.log(f"sync: {msg}")
            with open(log_path, "a", encoding="utf-8") as f: f.write(msg + "\n")
        base = shlex.quote(self.base)
        if "ok" not in self.sb(f"cd $SANDBOX_APP_DIR && git fetch -q origin {base} && echo ok", check=False):
            say(f"git fetch origin {self.base} が失敗した。ネットワークかトークンを確かめること")
            return False, "\n".join(out)
        if "up-to-date" in self.sb(f"cd $SANDBOX_APP_DIR && git merge-base --is-ancestor origin/{base} HEAD && echo up-to-date", check=False):
            say(f"origin/{self.base} は取り込み済み")
        elif "merged" in self.sb(f"cd $SANDBOX_APP_DIR && git merge --no-edit origin/{base} && echo merged", check=False):
            say(f"origin/{self.base} を取り込んだ（マージコミットを作った）")
        else:
            files = self.sb("cd $SANDBOX_APP_DIR && git diff --name-only --diff-filter=U", check=False).split()
            self.sb("cd $SANDBOX_APP_DIR && git merge --abort", check=False)
            say(f"`git merge origin/{self.base}` が衝突した（作業ツリーは merge --abort で元に戻してある）。"
                f"自分で `git merge origin/{self.base}` をやり直し、両方の意図を残す形で解消してマージコミットを作ること。"
                "衝突と無関係な変更はしない。解消したファイルに関係するテストだけ走らせる（全体は次の gates が回す）")
            say(f"衝突したファイル: {', '.join(files) or '(不明)'}")
            return False, "\n".join(out)
        # ADR の採番は別ファイルなので git は衝突と見なさない（先に取り込んだ base と同じ番号でも「成功」する）
        names = self.sb("cd $SANDBOX_APP_DIR && ls docs/adr 2>/dev/null", check=False).split()
        nums = {}
        for n in names:
            m = self.ADR_FILE.match(n)
            if m: nums.setdefault(m.group(1), []).append(n)
        dup = {k: v for k, v in sorted(nums.items()) if len(v) > 1}
        if dup:
            say("base を取り込んだ結果 ADR の番号が重複した。自分が足した側を `ls docs/adr` の次の空き番号に振り直し、"
                "本文・README の一覧・コード・テストの参照も更新すること")
            for k, v in dup.items(): say(f"ADR 番号 {k} が重複: {', '.join(sorted(v))}")
            return False, "\n".join(out)
        say("PASS")
        return True, "\n".join(out)

    def run_code(self, step):
        self.log(f"code {step['id']} ({step['code']})")
        if self.dry: return True, "(dry-run)"
        if step["code"] == "sync-base": return self.run_sync(step)   # runner 内蔵（kit/steps/ にファイルは無い）
        script = KIT / "steps" / step["code"]
        self.refresh_token()
        env = {"PJ": self.pj, "TASK": self.task, "RUN_DIR": str(self.run_dir), "PROJECT_DIR": str(self.project_dir),
               "GATES": self.project["gates"], "WORK": self.work, "APP_DIR": self.project["app_dir"], "BASE": self.base,
               "BRANCH": self.branch, "WORKFLOW": self.wf_name, "TITLE": self.title,
               "PR_NUMBER": self.pr_number or "", "MERGE_METHOD": os.environ.get("MERGE_METHOD", "merge"),
               "KNOWN_RED": " ".join(self.project.get("known_red_gates", [])),
               "REPO": self.project.get("repo") or "",     # gates.sh が「配った PJ 定義が origin/<base> の版か」を見るため（487）
               **self.automerge_env()}
        log_path = self.run_dir / f"code-{step['id']}-{len(self.state['history'])}.log"
        self.set_current(step["id"], "code", log_path.name)
        rc, out = stream(["bash", str(script)], log_path, env=env)
        if step["code"] == "gates.sh": self.note_base_red()
        if step["code"] == "pr-automerge.sh": self.note_merged()
        print(out.strip()[-1500:])
        return rc == 0, out[-4000:]

    def automerge_env(self):
        """pr-automerge.sh に渡す条件。PJ の設定（auto_merge）と workflow の形（review があるか）から決める。
        script 側で project.yml や workflow を読み直させない（読み方の判断は runner に 1 つだけ置く）"""
        am = self.auto_merge or {}
        return {"AUTO_MERGE": "1" if self.auto_merge else "0",
                "AUTO_MERGE_METHOD": str(am.get("method", "merge")),
                "AUTO_MERGE_WAIT_MIN": str(am.get("wait_min", 20)),
                "AUTO_MERGE_DELETE_BRANCH": "1" if am.get("delete_branch", True) else "0",
                "AUTO_MERGE_REQUIRE_CHECKS": "1" if am.get("require_checks", True) else "0",
                "HAS_REVIEW": "1" if any(s.get("role") == "reviewer" for s in self.wf["steps"]) else "0",
                "RUN_NAME": self.run_dir.name}

    def note_merged(self):
        """pr-automerge.sh が実際にマージしたとき、その事実を run の記録に残す（ADR-0042）。

        書き手は runner だけ（ADR-0039 の契約）。kb と console はこれを読むだけで、マージしたかどうかを推し量らない。
        マージしなかった回は merged.json が無いので、ここは何もしない（PR は開いたまま人間へ渡る）"""
        try:
            raw = (self.vm_read("merged.json") or "").strip()
            if not raw: return
            m = json.loads(raw)
        except Exception as e:
            self.log(f"automerge: merged.json を読めなかった（マージ自体は済んでいる可能性がある）: {e}")
            return
        self.state["merged"] = {k: m.get(k) for k in ("at", "sha", "method", "pr_url", "base")}
        self.save()

    def note_base_red(self):
        """gates.sh が「base でも赤い」と実際に確かめたゲート名を run の記録に足す（チケット 330）。

        project.yml は書き換えない。あれは人が書く設定ファイルで、機械が触ると run の途中で PJ 定義が変わってしまう。
        console の sandbox 画面は project.yml の値とここに記録された値を合わせて見せる。
        base で確かめた後に作業ブランチへ戻せていないときは `!restore-failed` が入る（その VM で agent を走らせない）"""
        lines = [l.strip() for l in (self.vm_read("base-red.txt") or "").splitlines() if l.strip()]
        self.base_check_broken = "!restore-failed" in lines
        names = [l for l in lines if not l.startswith("!")]
        if not names: return
        known = list(self.state.get("known_red_gates") or [])
        known += [n for n in names if n not in known]
        self.state["known_red_gates"] = known
        self.save()

    GATE_FAIL = re.compile(r"^FAIL (\S+)")

    def gate_log_excerpts(self, per_gate=3000, lines=40):
        """実装役へ戻す依頼文に、赤いゲートのログ（work/gates/<名前>.log）の抜粋を足す（チケット 331）。

        gates.sh の標準出力には判定と base での結果しか入らないので、これが無いと実装役は VM に入って
        ~/gates/<名前>.log を自分で探すところから始めることになる。載せるのは gates.txt の判定行に残った FAIL だけ。
        INFO（base でも赤い・known_red）は自分の変更が原因ではないので、直させないために入れない（ログ自体は残る）"""
        try:
            txt = self.vm_read("gates.txt") or ""
            blocks = []
            for line in txt.splitlines():
                if line.startswith("=== "): break       # ここから先は base の結果とログ末尾（ログ中の FAIL を拾わない）
                m = self.GATE_FAIL.match(line)
                if not m: continue
                g = m.group(1)
                body = (self.vm_read(f"gates/{g}.log") or "").strip()
                if not body: continue
                head, sep, tail = body.partition("\n=== tail")
                keep = head.splitlines()[:lines]
                if len(head.splitlines()) > lines: keep.append("（中略）")
                if sep:
                    t = (sep.lstrip("\n") + tail).splitlines()
                    if len(t) > lines: keep += ["（中略）"] + t[-lines:]
                    else: keep += t
                blocks.append(f"### {g}（全文は work/gates/{g}.log）\n```\n" + "\n".join(keep)[:per_gate] + "\n```")
            return "\n\n".join(blocks)
        except Exception as e:                          # ログの回収に失敗しても run は止めない（依頼文が痩せるだけ）
            self.log(f"ゲートのログ抜粋を作れなかった: {e}")
            return ""

    def transition(self, step, ok):
        """次の行き先。どこへ向かうかの規則は lib/aifactory_workflow.py が正本で、
        戻れる回数の数え上げ（state.json の loops）と severity の加点（ADR-0053）はここに残す（状態を持つため）"""
        t = wf.transition_of(step, ok)
        if t["max_loops"] is None: return t["to"]
        key = f"{step['id']}->{t['to']}"; n = self.state["loops"].get(key, 0)
        if n < t["max_loops"] + self.severity_bonus(step, {"goto": t["to"], "max_loops": t["max_loops"]}, key):
            self.state["loops"][key] = n + 1; return t["to"]
        return t["else"]

    def severity_bonus(self, step, t, key):
        """reviewer が `severity: minor` と書いた FAIL に限り、戻せる回数を 1 回だけ足す（ADR-0053）。

        軽微な指摘 1 件で human に落ちると、VM を返して人が `kb run --from` を打ち直す手間の方が高い。
        暴走を防ぐため加点は **1 遷移につき 1 回きり**（何度 minor と書かれても増えない）。
        major / 無指定は従来どおり（上限を超えたら human）。事実だけを state.json に残す（文言は console 側。ADR-0025）"""
        used = self.state.setdefault("severity_bonus", {})
        if used.get(key): return 1                      # 既に使った分は上限に足したまま（同じ遷移で 2 回目は増えない）
        if step.get("role") != "reviewer" or getattr(self, "last_severity", None) != "minor": return 0
        n = self.state["loops"].get(key, 0)
        if n < t.get("max_loops", 1): return 0          # まだ上限内。加点を使わずに戻す（使い切ってから足す）
        used[key] = 1
        self.log(f"{step['id']}: レビューの指摘は severity: minor。戻せる回数の上限を 1 回だけ超えて {key.split('->')[-1]} に戻す")
        return 1

    def resume_step_for(self, step):
        """human で止まったとき、次にどの step からやり直せば続きになるか（`kb run --from <step>` に渡る事実）。
        戻し先が決まっている step（review→implement、gates→implement）はその戻し先、そうでなければその step 自身
        （implement が時間上限で切られたなら implement からやり直す）。文言は組まない（ADR-0025 / ADR-0036）"""
        t = step.get("on_fail")
        return t["goto"] if isinstance(t, dict) and t.get("goto") in self.steps else step["id"]

    def fail_before_start(self, e, failure=None, waited_s=None, wait_reason=None):
        """take（VM の取得と準備）で落ちたときの終わり方。工程は 1 つも走っていないので、記録に理由を残して人間へ返す（チケット 238）。
        記録が無いと kb がチケットを `実行中` のまま残し、console も「実行中・工程 0」と見せてしまう。
        failure は「同じ failed でも扱いが違う終わり方」の目印。kb と console がこれを見て見せ方と次の一手を変える。
        今あるのは "wait_timeout"（VM の空き待ちが上限。チケットは todo に戻す。242）と
        "prepare"（貸出直後の準備が失敗。VM か prepare.sh を直してから回し直す。330）と
        "clock"（ゲストの時計が制御系とずれていた。VM は返すので、回し直せば次の貸出が合わせ直す。491）"""
        err = scrub(str(e))[-1500:]
        self.state.update({"result": "failed", "next": "human", "current": None, "error": err, "pr_url": "", "wip_branch": "",
                           "finished": datetime.datetime.now().astimezone().isoformat(timespec="seconds"), "elapsed_s": int(time.time() - self.t0)})
        if failure: self.state["failure"] = failure
        if waited_s is not None: self.state["waited_s"] = int(waited_s)   # 待っていない終わり方に「0 秒待った」と書かない
        # 「誰がいつから使っているか」（pull backend の worker 競合）。kb がそのまま note に写す（373）
        if wait_reason: self.state["wait_reason"] = wait_reason
        self.save()
        self.log(f"take failed: {([l for l in err.splitlines() if l.strip()] or ['(理由なし)'])[-1]}")
        # take が通った後（fetch など）で落ちると VM は貸出中のまま。sandbox backend では返す（take 自体が失敗したなら貸出は無い）。
        # pull backend（macOS / Windows / Linux）の release は artifact 回収込みで、lease は調査のため残す約束なので呼ばない
        if type(self).release is Run.release and getattr(self, "taken", False):
            try: self.release()
            except Exception as e2: self.log(f"release も失敗: {e2}")
        elif type(self).release is not Run.release:
            # lease を取れていない失敗（他 run が使用中、worker が offline）で「lease は残す」と言うと、
            # 自分の lease が残っていると読めて調査を空振りさせる（373）。取れているときだけ言う
            if self.state.get("lease"):
                self.log(f"{getattr(self, 'backend_label', 'pull')}: 調べられるよう lease は残す")
            else:
                self.log(f"{getattr(self, 'backend_label', 'pull')}: lease は取っていない（この run が使っている worker は無い）")
        self.log(f"result: failed  run: {self.run_dir}")
        return 2

    def main(self):
        self.t0 = time.time()
        self.log(f"workflow {self.wf_name}: " + " → ".join(s["id"] for s in self.wf["steps"]) + f"  (branch {self.branch} → {self.base})")
        if self.from_step:
            self.log(f"--from: {self.from_step} から origin/{self.from_branch} の続きを回す"
                     + (f"（前回の run: {self.from_run.name}）" if self.from_run else "（前回の run の記録は無し）"))
        if self.resume:
            self.log(f"--resume: {self.state['next']} から続ける（工程履歴 {len(self.state.get('history') or [])} 件）")
        try:
            self.take_waiting()
        except PoolTimeout as e:
            return self.fail_before_start(e, failure="wait_timeout", waited_s=e.waited_s, wait_reason=e.why)
        except PoolBusy as e:
            # --wait を付けずに worker が他 run に使われていた（pull backend）。待てば解ける失敗なので、
            # 人間待ち（blocked）ではなく todo に戻す。理由が無い失敗（Proxmox のプール満杯）は従来どおり即 failed（373）
            if not getattr(e, "reason", ""): return self.fail_before_start(e)
            return self.fail_before_start(e, failure="wait_timeout", wait_reason=e.reason)
        except PrepareFailed as e:
            # 準備で落ちた run。直す所は VM か prepare.sh 側にあるので、agent を起こさず人間へ返す（330）
            return self.fail_before_start(e, failure="prepare")
        except ClockSkew as e:
            # 貸出直後のゲストの時計がずれていた（491）。嘘の日付のコミットを積ませないよう工程を 1 つも始めずに終える。
            # VM は返す（次の take が巻き戻し直して合わせる）
            return self.fail_before_start(e, failure="clock")
        except NoKey as e:
            # 要る用途の Claude の鍵が鍵プールに無い。VM は取っていない。鍵が登録されれば回せるので一時停止（kb が todo に戻し、timer が回し直す。ADR-0046）
            return self.fail_before_start(e, failure="nokey")
        except Exception as e:
            return self.fail_before_start(e)
        cur = self.state["next"]; retry_note = self.first_retry_note(); result = "end"
        while cur not in ("end", "human"):
            step = self.steps.get(cur) or die(f"step {cur} が無い")
            # auto_merge の無い PJ では automerge の工程そのものを回さない（PR を作って人間に渡す、今までどおりの終わり方）。
            # workflow の定義は全 PJ 共通なので、飛ばす判断は PJ の設定を持っている runner 側に置く（ADR-0042）
            if step.get("code") in self.SKIPPABLE_CODE_STEPS and not self.auto_merge:
                self.log("automerge: この PJ は auto_merge が無いので飛ばす（PR は人間が判断する）")
                self.state["next"] = cur = "human"; self.state["current"] = None; self.save()
                continue
            self.last_fail = {}                     # 直前の step の失敗の内訳（timeout の目印と stdout の末尾）を持ち越さない
            self.last_severity = None               # 同上（前の review の severity を次の step の判断に持ち越さない）
            self.last_sweep = None                  # 同上（前の step の掃き寄せの一覧を次の step の記録に混ぜない）
            self.base_check_broken = False          # 同上（gates.sh が base を見た後にツリーを戻せなかった、の目印）
            if "role" in step: ok, info = self.run_agent(step, retry_note)
            else: ok, info = self.run_code(step)
            # 作業ツリーが base を見たまま戻っていない VM に agent を入れない。戻す回数を数えず、そのまま人間へ（330）。
            # 鍵の利用枠 / 鍵の失効で止まった step も同じ（その step が悪いのではないので、戻しの回数を消費しない。380）
            paused = (self.last_fail or {}).get("failure") in PAUSE_KINDS
            nxt = "human" if self.base_check_broken or paused else self.transition(step, ok)
            entry = {"step": cur, "ok": ok, "next": nxt, "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds")}
            fail = self.last_fail if not ok else {}
            # 「時間上限で切られた」は「その step が失敗した」とは直し方が違う（上限を上げるか、チケットを小さくする）。
            # console と MCP がそれを区別できるよう history に目印を残す（チケット 329）
            # 掃き寄せ（commit_tracked）が何を拾い、何を除外して戻したか。差分を開かずに気づける唯一の記録（572）
            if self.last_sweep: entry["swept"] = self.last_sweep
            if fail.get("failure") in PAUSE_KINDS: entry.update({"failure": fail["failure"], "quota_type": fail.get("quota_type"), "retry_after": fail.get("retry_after")})
            elif fail.get("failure"): entry.update({"failure": fail["failure"], "timeout_min": fail.get("timeout_min")})
            self.state["history"].append(entry)
            self.state["next"] = nxt; self.state["current"] = None
            # agent の stdout の末尾は error に混ぜず別フィールドに置く（error の最終行が lint の集計行になって誤読された。チケット 329）
            if fail.get("last_output"): self.state["last_output"] = fail["last_output"]
            self.save()
            self.log(f"{cur}: {'PASS' if ok else 'FAIL'} → {nxt}")
            # 戻すときは前回の結果を添える
            # base 確認で作業ツリーを戻せなかったときは、赤が全部 INFO に落ちて ok=True でも人間へ回す。理由と再開先を残す
            if (not ok or self.base_check_broken) and nxt == "human":
                # 自動マージしなかった回（ADR-0042）。工程が失敗したのではなく PR ができた上での終わり方なので、
                # 「戻せる回数を使い切った」とは書かず、続きから回す口（resume_step）も付けない
                if step.get("code") == "pr-automerge.sh" and not self.base_check_broken:
                    why = ([l.strip() for l in str(info).splitlines() if l.strip()] or ["理由なし"])[-1][:300]
                    self.state["error"] = f"automerge: {why.removeprefix('NOMERGE: ')}"
                    self.save()
                    cur = nxt
                    continue
                # やり直すならどの step からか、という事実を残す（kb と console がここから再開コマンドを組む。ADR-0036）。
                # 利用枠 / 鍵で止まった step は「その step 自身」から（戻し先ではない。wip の続きを同じ役割が引き取る。380）
                self.state["resume_step"] = cur if paused else self.resume_step_for(step)
                # 人間に渡す理由を記録に残す（kb の note と console がこれを読む。チケット 239）。1 行にする
                if self.base_check_broken:
                    self.state["error"] = f"{cur}: base で確かめた後に作業ブランチへ戻せなかった。VM の作業ツリーを人が確かめること"
                elif paused:
                    # run 全体の目印。kb（todo に戻す / blocked）と dispatch --resume-paused（解除時刻を過ぎたら続きを回す）が読む。
                    # quota_hits は続けて利用枠で止まった回数（前回の run から引き継ぐ。際限なく VM を取り直さないための上限に使う）
                    self.state["failure"] = fail["failure"]
                    self.state["quota_type"] = fail.get("quota_type")
                    self.state["retry_after"] = fail.get("retry_after")
                    self.state["quota_hits"] = (self.state.get("quota_hits") or 0) + 1 if fail["failure"] == "quota" else 0
                    if fail["failure"] == "quota":
                        self.state["error"] = (f"{cur}: 鍵の利用枠の上限で中断（quota・{fail.get('quota_type') or 'unknown'}。"
                                               f"解除見込み {fail.get('retry_after') or '不明'}）")
                    else:
                        self.state["error"] = f"{cur}: 鍵が使えず中断（key）: {fail.get('reason') or '理由なし'}"
                elif fail.get("failure") == "timeout":
                    self.state["error"] = f"{cur}: 時間上限 {fail.get('timeout_min')} 分で中断（timeout）"
                else:
                    why = ([l.strip() for l in str(info).splitlines() if l.strip()] or ["理由なし"])[-1][:300]
                    self.state["error"] = f"{cur} で止まった（失敗、または戻せる回数を使い切った）: {why}"
                self.save()
            retry_note = "" if ok else (info if "role" in step else f"```\n{info}\n```")
            if not ok and nxt in self.steps and "role" in self.steps[nxt] and step.get("code") == "gates.sh":
                # base を実際に見られなかった回（stash できない、origin/<base> が無い など）は言い切らない。
                # 確かめていないのに「残る FAIL は自分の原因」と書くと、元からの赤を実装役に追わせることになる
                checked = "BASE-CHECK-SKIP" not in str(info)
                judged = ("**base でも赤いゲートは runner が base で実際に回して確かめ済みで、`INFO <名前> red (also red on base; not a gate)` "
                          "に落としてある**（結果は gates.txt の `=== base check:` 以降にある）。"
                          "そこに残っている `FAIL` は自分の変更が原因なので、推し測らずに直すこと。"
                          if checked else
                          "**base での確認は今回できなかった**（gates.txt の `=== base check:` に `BASE-CHECK-SKIP` の理由がある）。"
                          "赤が base でも赤いと思うなら、直さずに理由を report.md に書くこと。")
                excerpts = self.gate_log_excerpts()
                retry_note = ("ゲートの結果（赤あり）。ログを読んで原因を直し、ゲートを全緑にしてコミットすること。\n"
                              + judged + "\n\n"
                              f"```\n{info}\n```"
                              + (f"\n\n## 赤いゲートのログ（抜粋）\n\n{excerpts}" if excerpts else ""))
            cur = nxt
        result = cur
        wip = self.preserve() if result == "human" else ""
        pr = self.vm_read("pr_url").strip() if not self.dry else ""
        self.state.update({"result": result, "pr_url": pr, "wip_branch": wip, "finished": datetime.datetime.now().astimezone().isoformat(timespec="seconds"), "elapsed_s": int(time.time()-self.t0)})
        self.save()
        self.release()
        self.log(f"result: {result}  PR: {pr or 'なし'}{'  wip: origin/' + wip if wip else ''}  run: {self.run_dir}")
        return 0 if result == "end" or pr or (self.dry and all(h["ok"] for h in self.state["history"])) else 2

if __name__ == "__main__":
    args = [a for a in sys.argv[1:] if not a.startswith("--")]; flags = set(a for a in sys.argv[1:] if a.startswith("--"))
    if len(args) != 4: print(__doc__); sys.exit(1)
    pd = paths.project_dir(args[0])
    project = load_yaml(pd / "project.yml") if pd and (pd / "project.yml").exists() else {}
    runner = Run
    if project.get("backend") in ("macos-pull", "windows-pull", "linux-pull"):
        sys.path.insert(0, str(HERE / "lib"))
        if project["backend"] == "macos-pull":
            from macos import backend
        elif project["backend"] == "windows-pull":
            from windows import backend
        else:
            from linux import backend
        runner = backend(Run)
    wait_s = 0
    from_step = from_branch = None
    for f in flags:
        if f == "--wait": wait_s = 3600
        elif f.startswith("--wait="): wait_s = int(f.split("=", 1)[1])
        elif f == "--from": from_step = ""                       # step の指定なし＝前回の記録（resume_step）に任せる
        elif f.startswith("--from="): from_step = f.split("=", 1)[1]
        elif f.startswith("--branch="): from_branch = f.split("=", 1)[1]
        elif f == "--branch": die("--branch=<名前> の形で指定すること")
    if from_step is not None or from_branch is not None:
        if "--resume" in flags: die("--from と --resume は一緒に使えない（--resume は貸出中の VM で続き、--from は新しい VM を取り直す）")
        # pull backend（macOS / Windows / Linux）は take を独自に持ち、wip ブランチからの checkout をしない（チケット 333 の範囲外）
        if project.get("backend") in ("macos-pull", "windows-pull", "linux-pull"): die("--from は sandbox backend の PJ だけで使える")
    sys.exit(runner(*args, dry="--dry-run" in flags, keep="--keep" in flags, resume="--resume" in flags, wait_s=wait_s,
                    from_step=from_step, from_branch=from_branch).main())
