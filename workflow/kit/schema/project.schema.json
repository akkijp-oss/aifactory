{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akkijp-oss/aifactory/workflow/kit/schema/project.schema.json",
  "title": "aifactory project definition ($AIFACTORY_WORKSPACE/projects/<pj>/project.yml or examples/projects/<pj>/project.yml)",
  "description": "PJ \u56fa\u6709\u306e\u4e8b\u5b9f\u3068\u65b9\u91dd\u3002\u624b\u9806\uff08workflow\uff09\u306f\u5e38\u5099\u5074\u306b\u3042\u308a\u3001\u3053\u3053\u306b\u306f\u300e\u3069\u3053\u306b\u4f55\u304c\u3042\u308b\u304b\u300f\u300e\u4f55\u3092\u5b88\u308b\u304b\u300f\u3060\u3051\u3092\u66f8\u304f\u3002",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "repo",
    "base_branch",
    "app_dir",
    "gates"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "PJ slug\u3002sandbox take <pj> \u3068 templates/<pj>/ \u306b\u4e00\u81f4"
    },
    "display_name": {
      "type": "string"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_branch": {
      "type": "string",
      "description": "\u901a\u5e38\u306e\u4f5c\u696d\u30d6\u30e9\u30f3\u30c1\u306e\u5143\u3068 PR \u306e\u5b9b\u5148"
    },
    "hotfix_base": {
      "type": "string",
      "description": "hotfix \u306e\u5b9b\u5148\uff08\u7701\u7565\u6642\u306f base_branch\uff09"
    },
    "app_dir": {
      "type": "string",
      "description": "VM \u5185\u306e\u30a2\u30d7\u30ea\u306e\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\uff08\u30ea\u30dd\u30b8\u30c8\u30ea\u76f4\u4e0b\u3068\u9055\u3046\u3053\u3068\u304c\u3042\u308b\uff09"
    },
    "url": {
      "type": "string",
      "description": "VM \u5185\u304b\u3089\u898b\u305f\u30a2\u30d7\u30ea\u306e URL\uff08\u753b\u9762\u78ba\u8a8d\u7528\uff09"
    },
    "gates": {
      "type": "string",
      "description": "\u30b2\u30fc\u30c8\u30b9\u30af\u30ea\u30d7\u30c8\u3002templates/<pj>/ \u304b\u3089\u306e\u76f8\u5bfe\u30d1\u30b9\u3002VM \u5185\u3067 app_dir \u3092 cwd \u306b\u5b9f\u884c\u3055\u308c\u3001\u5168\u7dd1\u306a\u3089 0"
    },
    "prepare": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.sh$",
      "description": "\u8cb8\u51fa\u76f4\u5f8c\u306e\u6e96\u5099\u30b9\u30af\u30ea\u30d7\u30c8\uff08\u4efb\u610f\uff09\u3002templates/<pj>/ \u304b\u3089\u306e\u76f8\u5bfe\u30d1\u30b9\uff08\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u3092\u8de8\u3052\u306a\u3044\uff09\u3002VM \u3092\u53d6\u3063\u3066 checkout \u3057\u305f\u76f4\u5f8c\u306b app_dir \u3092 cwd \u306b\u3057\u3066 1 \u56de\u3060\u3051\u5b9f\u884c\u3057\u3001\u975e 0 \u306a\u3089 agent \u3092\u8d77\u52d5\u305b\u305a failure: prepare \u3067\u7d42\u308f\u308b\u3002\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3092\u713c\u3044\u305f\u6642\u70b9\u304b\u3089 base \u304c\u9032\u3093\u3067\u74b0\u5883\u304c\u305a\u308c\u308b\u5206\uff08\u4f9d\u5b58\u30fbDB migration\uff09\u3092\u3053\u3053\u3067\u63c3\u3048\u308b\u3002sandbox\uff08proxmox\uff09backend \u3060\u3051\u3002pull backend \u306f provision.sh \u304c\u540c\u3058\u5f79\u76ee"
    },
    "stack": {
      "type": "string",
      "description": "1 \u884c\u306e\u6280\u8853\u30b9\u30bf\u30c3\u30af\uff08\u4f9d\u983c\u6587\u306e\u5192\u982d\u306b\u51fa\u3059\uff09"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "agent \u306b\u6bce\u56de\u4f1d\u3048\u308b\u4e8b\u5b9f\uff08\u30c6\u30b9\u30c8\u306e\u8d70\u3089\u305b\u65b9\u3001\u65e2\u77e5\u306e\u554f\u984c\u3001\u751f\u6210\u7269\u306e\u7f6e\u304d\u5834\u306a\u3069\uff09\u30021 \u9805\u76ee 1 \u884c"
    },
    "review_points": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "reviewer \u304c\u5fc5\u305a\u898b\u308b\u89b3\u70b9\uff08PJ \u56fa\u6709\uff09"
    },
    "forbidden": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "agent \u304c\u3084\u3063\u3066\u306f\u3044\u3051\u306a\u3044\u3053\u3068\uff08PJ \u56fa\u6709\uff09\u3002\u5171\u901a\u306e\u7981\u6b62\u4e8b\u9805\u306f kit/roles/ \u306b\u3042\u308b"
    },
    "workflow_overrides": {
      "type": "object",
      "description": "workflow \u540d \u2192 \u4e0a\u66f8\u304d\uff08v1 \u306f base_branch \u306e\u307f\uff09",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "base_branch": {
            "type": "string"
          }
        }
      }
    },
    "known_red_gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "base \u30d6\u30e9\u30f3\u30c1\u3067\u65e2\u306b\u8d64\u3044\u30b2\u30fc\u30c8\u540d\uff08gates.sh \u306e\u540d\u524d\uff09\u3002runner \u306f FAIL \u3092 INFO \u306b\u683c\u4e0b\u3052\u3057\u3001agent \u306b\u300e\u76f4\u305b\u300f\u3068\u623b\u3055\u306a\u3044\u3002\u76f4\u3059 PR \u304c\u30de\u30fc\u30b8\u3055\u308c\u305f\u3089\u6d88\u3059"
    },
    "sweep_exclude": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u6383\u304d\u5bc4\u305b\uff08step \u306e\u7d42\u308f\u308a\u306b\u672a\u30b3\u30df\u30c3\u30c8\u306e\u5909\u66f4\u3092 `sandbox: uncommitted changes by agent` \u3068\u3057\u3066\u6551\u6e08\u3059\u308b\u30b3\u30df\u30c3\u30c8\uff09\u3067\u62fe\u308f\u306a\u3044 glob\u3002\u66f8\u304b\u306a\u3051\u308c\u3070\u65e2\u5b9a\uff08`**/package.json` / `**/pnpm-lock.yaml`\uff09\u3002`[]` \u3068\u66f8\u3051\u3070\u9664\u5916\u306a\u3057\uff08\u5168\u90e8\u62fe\u3046\uff09\u3002\u74b0\u5883\u304c\u89e3\u6c7a\u3057\u76f4\u3057\u305f\u3060\u3051\u306e\u4f9d\u5b58\u30d5\u30a1\u30a4\u30eb\u304c\u610f\u56f3\u3057\u305f\u5909\u66f4\u3068\u3057\u3066 PR \u306b\u8f09\u308b\u306e\u3092\u9632\u3050\uff08\u30c1\u30b1\u30c3\u30c8 572\uff09"
    },
    "auto_merge": {
      "type": [
        "boolean",
        "object"
      ],
      "description": "\u30b2\u30fc\u30c8\u7dd1\u30fb\u30ec\u30d3\u30e5\u30fc PASS\u30fbCI \u7dd1\u306a\u3089 runner \u304c PR \u3092 base_branch \u3078\u30de\u30fc\u30b8\u3059\u308b\uff08automerge step\uff09\u3002\u7701\u7565\u30fbfalse \u306a\u3089\u4eca\u307e\u3067\u3069\u304a\u308a PR \u3092\u4f5c\u3063\u3066\u4eba\u9593\u306b\u6e21\u3059\u3002true \u306f\u65e2\u5b9a\u5024\u3067\u6709\u52b9\u306b\u3059\u308b\u306e\u3068\u540c\u3058\u3002\u5168 workflow\uff08hotfix \u3082\uff09\u306b\u52b9\u304f\u306e\u3067\u3001hotfix_base \u304c main \u306e PJ \u3067\u306f hotfix \u304c main \u306b\u81ea\u52d5\u3067\u5165\u308b\u3053\u3068\u306b\u6ce8\u610f",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "merge",
            "squash",
            "rebase"
          ],
          "description": "gh pr merge \u306e\u65b9\u6cd5\uff08\u65e2\u5b9a merge\uff09"
        },
        "wait_min": {
          "type": "integer",
          "minimum": 1,
          "description": "CI checks \u304c\u7d42\u308f\u308b\u306e\u3092\u5f85\u3064\u4e0a\u9650\uff08\u5206\u3002\u65e2\u5b9a 20\uff09"
        },
        "delete_branch": {
          "type": "boolean",
          "description": "\u30de\u30fc\u30b8\u5f8c\u306b origin \u306e\u4f5c\u696d\u30d6\u30e9\u30f3\u30c1\u3092\u6d88\u3059\u304b\uff08\u65e2\u5b9a true\uff09"
        },
        "require_checks": {
          "type": "boolean",
          "description": "checks \u304c 0 \u672c\u306e\u3068\u304d\u306f\u30de\u30fc\u30b8\u3057\u306a\u3044\u304b\uff08\u65e2\u5b9a true\uff09\u3002CI \u304c\u7121\u3044 PJ \u306f false \u306b\u3059\u308b"
        }
      }
    },
    "backend": {
      "type": "string",
      "enum": [
        "proxmox",
        "macos-pull",
        "windows-pull",
        "linux-pull"
      ]
    },
    "worker": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$"
    },
    "computer_use": {
      "type": "boolean",
      "description": "Enable the dedicated VM desktop MCP tool for workflow agents. Requires preinstalled desktop helpers."
    },
    "display": {
      "type": "object",
      "description": "Mac \u30b2\u30b9\u30c8\u306e\u8868\u793a\u89e3\u50cf\u5ea6\u3002\u7701\u304f\u3068\u57fa\u6e96 VM \u306e\u307e\u307e\uff081024x768\uff09\u3002scale \u306f\u672a\u5bfe\u5fdc\uff08ADR-0057\uff09",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 800,
          "maximum": 2560
        },
        "height": {
          "type": "integer",
          "minimum": 600,
          "maximum": 2560
        }
      }
    },
    "capabilities": {
      "type": "object",
      "description": "\u3053\u306e PJ \u306e\u5b9f\u884c\u74b0\u5883\uff08VM \u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\uff09\u306b\u3042\u308b\u80fd\u529b\u3002\u66f8\u3044\u305f\u30ad\u30fc\u3060\u3051\u304c\u7968\u306e\u5b8c\u4e86\u6761\u4ef6\u3068\u306e\u7167\u5408\u306b\u4f7f\u308f\u308c\u3001\u66f8\u304b\u306a\u3044\u30ad\u30fc\u306f\u300c\u672a\u5ba3\u8a00\uff1d\u7167\u5408\u3057\u306a\u3044\u300d\uff08false\uff1d\u7121\u3044\u3068\u78ba\u304b\u3081\u305f\u3001\u3068\u306f\u533a\u5225\u3059\u308b\uff09\u3002\u7167\u5408\u306f\u8b66\u544a\u3060\u3051\u3067\u3001\u8d77\u7968\u3082\u8d77\u52d5\u3082\u6b62\u3081\u306a\u3044\uff08\u30c1\u30b1\u30c3\u30c8 552\uff09",
      "additionalProperties": false,
      "properties": {
        "browser": {
          "type": "boolean",
          "description": "\u753b\u9762\u306e\u3042\u308b\u5b9f\u30d6\u30e9\u30a6\u30b6\u3067\u76ee\u8996\u30fb\u64cd\u4f5c\u3067\u304d\u308b\u304b\uff08\u30d8\u30c3\u30c9\u30ec\u30b9\u3057\u304b\u7121\u3044\u306a\u3089 false\uff09"
        },
        "docker": {
          "type": "boolean",
          "description": "docker / compose \u3067\u30b3\u30f3\u30c6\u30ca\u3092\u8d77\u52d5\u3067\u304d\u308b\u304b"
        },
        "egress": {
          "type": "boolean",
          "description": "\u5916\u90e8\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u304b\u3089\u53d6\u5f97\u3067\u304d\u308b\u304b"
        },
        "gui": {
          "type": "boolean",
          "description": "\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u753b\u9762\u3092\u64cd\u4f5c\u3067\u304d\u308b\u304b\uff08computer_use: true \u306e\u3068\u304d\u306f true \u76f8\u5f53\uff09"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "backend": {
            "const": "macos-pull"
          }
        },
        "required": [
          "backend"
        ]
      },
      "then": {
        "required": [
          "worker"
        ],
        "properties": {
          "app_dir": {
            "type": "string",
            "pattern": "^/Users/[a-zA-Z0-9_-]+/app$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "backend": {
            "const": "windows-pull"
          }
        },
        "required": [
          "backend"
        ]
      },
      "then": {
        "required": [
          "worker"
        ],
        "properties": {
          "app_dir": {
            "type": "string",
            "pattern": "^[A-Za-z]:/[^\\r\\n]*?/app$"
          },
          "gates": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\.ps1$"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "display"
        ]
      },
      "then": {
        "required": [
          "backend"
        ],
        "properties": {
          "backend": {
            "const": "macos-pull"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "computer_use": {
            "const": true
          }
        },
        "required": [
          "computer_use"
        ]
      },
      "then": {
        "required": [
          "backend"
        ],
        "properties": {
          "backend": {
            "enum": [
              "macos-pull",
              "windows-pull",
              "linux-pull"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "backend": {
            "const": "linux-pull"
          }
        },
        "required": [
          "backend"
        ]
      },
      "then": {
        "required": [
          "worker"
        ],
        "properties": {
          "app_dir": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9_./-]+/app$"
          },
          "gates": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\.sh$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "computer_use": {
            "const": true
          }
        },
        "required": [
          "computer_use"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "gui": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
