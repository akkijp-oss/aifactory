# ~/.config/sandbox/env  (chmod 600)。sandbox CLI と proxmox/run.sh が読む。
# このファイルはリポジトリにコミットしない（.gitignore: *.env / env）

# Proxmox への口は 2 つ（どちらか。ADR-0017）:
#   ssh モード: PVE_HOST に root で ssh して qm を叩く（ホスト管理者 = メンテナの手元）
#   API モード: PVE_API_TOKEN があればこちら。テナントのリソースプールだけに効く API トークンで、制御系 LXC（<prefix>-ctl）はこれで動く。
#              25-control-lxc.sh が制御系の ~/.config/sandbox/env に自動で書くので、手で書くのは手元から API で使いたいときだけ
# Proxmox ホストの ssh エイリアスかホスト名（ssh モードで必須。既定値なし）
PVE_HOST=pve1
# API モード（PVE_API_TOKEN を書くと ssh モードは使わない）。トークンは `SB_TENANT=<t> sandbox/proxmox/run.sh 05-tenant.sh token` が表示する
#PVE_API_URL=https://<node>:8006                # 証明書の SAN に合わせてノード名。SDN 側の IP へは PVE_API_RESOLVE で向ける
#PVE_API_RESOLVE=<node>:8006:10.77.0.1
#PVE_API_TOKEN=sb-main@pve!ctl=<uuid>
#PVE_API_CA=~/.config/sandbox/pve-ca.pem      # クラスタ CA（ホストの /etc/pve/pve-root-ca.pem）。無ければ PVE_API_INSECURE=1
#SB_POOL=sb-main                               # テナントのリソースプール（既定は sb-<SB_TENANT>。05-tenant.sh）
# ゲートウェイ LXC への ssh 先（必須。既定値なし）。10.77.0.2 は sandbox ネットワーク上の sb-gw のアドレス（SB_NET.0.2）。
# SB_NET を変えた場合はここも合わせる。tailnet 経由（subnet router）で届く
GW_SSH=root@10.77.0.2
# VM / LXC 用の秘密鍵
SB_KEY=~/.ssh/conf.d/aifactory/sb_ed25519
# DNS ドメイン（既定は <SB_TENANT>.sb.internal。書くのは変えるときだけ）
#SB_DOMAIN=main.sb.internal
APP_PORT=3000
# Pull worker HTTPS endpoint (disabled by default). Allows gw -> ctl only.
#SB_WORKER_PORT=8766
# 通常は空（tailnet 直結）。tailnet 未承認・不調時は Proxmox ホストの ssh エイリアス（例: pve1）を入れるとホスト経由（ProxyJump）で VM / sb-gw に入る。
# このとき url の名前解決は効かないので、ブラウザは http://10.77.1.NN:3000 を直接開く（sandbox ls の IP）
SB_JUMP=

# --- idle-stop（252 / ADR-0035）: 貸出されていないプール VM を止める。2 段で決める:
#   SB_IDLE_STOP_HOURS  最終利用から何時間経ったら「停止候補」にするか（既定 24。0 で無効 = 止めない）
#   SB_IDLE_STOP_KEEP   候補のうち起動したまま残す台数（足切り。既定 10。候補がこれを超えた分だけ古い順に止める。0 で候補を全部止める）
# 制御系 LXC の aifactory-idle-stop.timer が 15 分ごとに `sandbox idle-stop` を呼ぶ。止まった VM は次の take が
# 自動で起動する（+30〜60 秒）。常時起動にしたい PJ は pj/<pj>.env に SB_IDLE_STOP_HOURS=0 と書く
#SB_IDLE_STOP_HOURS=24
#SB_IDLE_STOP_KEEP=10

# --- テナント（貸出先の組織 = 独立した sandbox 環境。ADR-0017）。slug は [a-z0-9]{1,6}、最初の環境は main
# 命名規則: すべての名前に sb と <t> を含める。DNS <t>.sb.internal、zone sb<t>、vnet vn<t>、VM 名 sb-<t>-…、firewall group sb-<t>、
# pool / ユーザー sb-<t>。proxmox/_tenant.sh が導出し、sandbox CLI も同じ既定を使う（SB_PREFIX / SB_DOMAIN / SB_POOL で個別上書き可）
# 別テナントの設定は ~/.config/sandbox/tenants/<t>.env に置き、SB_TENANT=<t> で run.sh / sandbox が読む。
# テナントごとに SB_NET（/16）と SB_VMID_BASE（1000 刻み）を必ず変える
SB_TENANT=main
# VMID 帯の起点（gw = +0、ctl = +1、base = +100、PJ テンプレート = +110..、プール = +200..）
SB_VMID_BASE=9000

# --- sandbox ネットワークの設計値（既定のままなら書かなくてよい。変える場合は手元側と Proxmox 側で揃える）
# プール VM が並ぶ /24 のプレフィックス（sandbox CLI が VMID から IP を出すのに使う。SB_NET.1 と揃える）
SB_POOL_NET=10.77.1
# プール VM の VMID 起点（IP = SB_POOL_NET.(VMID - SB_POOL_BASE)。40-pool.sh と揃える）
SB_POOL_BASE=9200
# 以下は proxmox/run.sh がリモートへそのまま渡す（Proxmox 側スクリプトの既定値を上書きする）
# sandbox ネットワークの /16 プレフィックス（10-sdn.sh の subnet、sb-gw = SB_NET.0.2、ホスト = SB_NET.0.1）
SB_NET=10.77
# SDN zone を載せる Proxmox ノード名（空 = ホストの hostname）
SB_NODE=
# ゲートウェイ LXC sb-gw の VMID
SB_GW_CT=9000
# ベーステンプレート sb-base の VMID
SB_BASE_VMID=9100

# トークンは PJ ごとに ~/.config/sandbox/pj/<pj>.env に置くのが基本（`sandbox token set <pj> [claude|gh]`）。
# ここに書くと全 PJ の既定になる（PJ 別ファイルが上書きする）。一回限りは SANDBOX_CLAUDE_TOKEN / SANDBOX_GH_TOKEN で上書きできる（シェルの CLAUDE_CODE_OAUTH_TOKEN は無視）。
# Claude Code の長期トークン: Mac で `claude setup-token` を実行した出力。take 時に VM の tmpfs へ注入
CLAUDE_CODE_OAUTH_TOKEN=
# モデル系統別の鍵（任意。`sandbox token set <pj|global> claude:<fable|opus|sonnet|haiku>`）。
# runner は step のモデル名（routes.env: judgment=fable / coding=opus / research=sonnet）から系統を選び、その鍵があればそれを、
# 無ければ上の CLAUDE_CODE_OAUTH_TOKEN を使う。Fable と Opus を別のアカウント（別の鍵）で動かしたいときに使う
#CLAUDE_CODE_OAUTH_TOKEN_FABLE=
#CLAUDE_CODE_OAUTH_TOKEN_OPUS=
#CLAUDE_CODE_OAUTH_TOKEN_SONNET=
# 鍵を複数持つなら、この 2 段より前に「制御系の鍵プール」（~/.config/sandbox/keys.json。ADR-0043）がある。
# `sandbox keys add <名前> --fable|--other` で名前とフラグを付けて並べておくと、take が系統ごとに最後に使ってから
# 最も時間が経った鍵を 1 本選んで VM に渡す。候補が無い系統だけ、上のここの値に落ちる（プールが空なら今までどおり）
# GitHub の push / PR 権限は通常 GitHub App（~/.config/sandbox/gh-app/、ADR-0008）が払い出す。ここに書くのは App 未設定時のフォールバック
GH_TOKEN=
# PJ 別ファイル（pj/<pj>.env）には GH_REPO=owner/name を書く（App のトークンをそのリポジトリに限定するため）
