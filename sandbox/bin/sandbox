#!/usr/bin/env bash
# sandbox: aifactory sandbox CLI（Mac 側）。区画間の契約はこの5操作 + ls。
#   sandbox take <pj> <task-id>      空き VM を貸し出す（DNS: task-<id>.sb.internal、env 注入）
#   sandbox ssh <task-id> [cmd...]   dev で入る / コマンド実行（login shell 経由）
#   sandbox url <task-id>            http://task-<id>.sb.internal:3000
#   sandbox reset <task-id>          snapshot clean に巻き戻す（貸出継続、env 再注入）
#   sandbox release <task-id> [--force]  巻き戻して返却（--force: 巻き戻せなくても台帳から消す。手で直した VM 用）
#   sandbox ls                       貸出状況
#   sandbox status [pj]              プールの台数を PJ ごとに（定義 / 実体 / 貸出 / 空き）
# 運用補助（契約外）:
#   sandbox token set <pj|global> [claude|gh]   トークンを対話入力して保存（既定 claude）。PJ 別ファイルに書く
#   sandbox token rotate [claude|gh]            1 回の入力で global・全 PJ・ctl.env を差し替え（console restart と reinject --all まで）
#   sandbox token show [pj]                     どのトークンが効いているか（マスク表示・発行からの日数・ホスト種別）
#   sandbox token clear <pj|global> [claude|gh] トークンを消す
#   sandbox reinject <task-id>|--all            貸出中の VM に現在の設定を再注入（巻き戻しなし。鍵の差し替え用）
#   sandbox gh-app status|token <pj>|refresh    GitHub App: 設定確認 / <pj> の installation token を表示 / 貸出中 VM の GH_TOKEN を全部払い出し直す
#   sandbox idle-stop [--hours N] [--keep K] [--dry-run]   使われていないプール VM を止めて CPU / メモリを空ける（最終利用から N 時間=既定 24 で候補、候補が K 台=既定 10 を超えた分を古い順に停止。timer が 15 分ごとに呼ぶ。次の take が起動し直す）
# GitHub トークン: ~/.config/sandbox/gh-app/{app.env,private-key.pem} があれば take / reinject / gh-app refresh のたびに
#   その PJ のリポジトリ（pj/<pj>.env の GH_REPO）だけに効く 1 時間有効の installation token を払い出して注入する（ADR-0008）。
#   無ければ pj/<pj>.env か env の GH_TOKEN（静的トークン）を使う。
# 設定: ~/.config/sandbox/env（全体既定）→ ~/.config/sandbox/pj/<pj>.env（PJ 別上書き）→ SANDBOX_CLAUDE_TOKEN / SANDBOX_GH_TOKEN（一回限りの上書き）
#   シェルに export された CLAUDE_CODE_OAUTH_TOKEN / GH_TOKEN は無視する
#   テナント（ADR-0017）: SB_TENANT=<t>（既定 main）。名前の既定は規則から導く（SB_PREFIX=sb-<t>、SB_DOMAIN=<t>.sb.internal、SB_POOL=sb-<t>）。
#   別テナントの設定で動かす（ホスト管理者が複数テナントを手元から見るとき）: SB_TENANT=<t> で ~/.config/sandbox/tenants/<t>.env を読む
#   か SANDBOX_ENV_FILE=<path>。このとき状態と PJ 別設定は同じ場所の <t>.state.json / <t>.pj/ になる
# Proxmox への口（2 つ。ADR-0017）:
#   ssh モード  PVE_HOST（root で ssh して qm を叩く。ホスト管理者向け）
#   API モード  PVE_API_TOKEN + PVE_API_URL + SB_POOL（テナントのリソースプールだけに効く API トークン。制御系 LXC はこちら。
#               PVE_API_CA にクラスタ CA を置くか PVE_API_INSECURE=1。PVE_API_RESOLVE=<node>:8006:<ip> で名前解決を SDN 側の IP に向ける）。
#               PVE_API_TOKEN があれば API モード
# 状態: ~/.config/sandbox/state.json（同時 take の直列化に state.json.lock を使う）
#   rollback は最大 SB_ROLLBACK_TRIES 回（既定 3）・SB_ROLLBACK_WAIT 秒間隔（既定 10）で再試行し、
#   全部失敗したら release / reset は非 0 で終わる（state は消さない）
set -euo pipefail

CONF_DIR="$HOME/.config/sandbox"
if [[ -n "${SANDBOX_ENV_FILE:-}" ]]; then ENV_FILE="$SANDBOX_ENV_FILE"
elif [[ -n "${SB_TENANT:-}" && -f "$CONF_DIR/tenants/$SB_TENANT.env" ]]; then ENV_FILE="$CONF_DIR/tenants/$SB_TENANT.env"
else ENV_FILE="$CONF_DIR/env"; fi
if [[ "$ENV_FILE" == "$CONF_DIR/env" ]]; then PJ_DIR="$CONF_DIR/pj"; STATE="$CONF_DIR/state.json"
else PJ_DIR="${ENV_FILE%.env}.pj"; STATE="${ENV_FILE%.env}.state.json"; fi
PJ_DIR="${SANDBOX_PJ_DIR:-$PJ_DIR}"; STATE="${SANDBOX_STATE:-$STATE}"
# 制御系（ctl LXC）のプロセス用 env。console の systemd が EnvironmentFile で読む。token rotate だけが触る（ADR-0029）
CTL_ENV="${SANDBOX_CTL_ENV:-$HOME/.config/aifactory/ctl.env}"
[[ -f "$ENV_FILE" ]] || { echo "[error] $ENV_FILE がありません（sandbox/templates/env.example をコピー）" >&2; exit 1; }
# 一回限りの上書きは専用の変数名だけを見る（SANDBOX_CLAUDE_TOKEN / SANDBOX_GH_TOKEN）。
# シェルに export されている CLAUDE_CODE_OAUTH_TOKEN / GH_TOKEN は PJ 設定を黙って上書きしてしまうので無視する（2026-09-06 に踏んだ）
_ovr_claude="${SANDBOX_CLAUDE_TOKEN:-}"; _ovr_gh="${SANDBOX_GH_TOKEN:-}"
unset CLAUDE_CODE_OAUTH_TOKEN GH_TOKEN
set -a; # shellcheck disable=SC1090
source "$ENV_FILE"; set +a
_src_claude="${CLAUDE_CODE_OAUTH_TOKEN:+global(env)}"; _src_gh="${GH_TOKEN:+global(env)}"
# load_pj <pj>: PJ 別の上書きファイルを重ねる（無ければ何もしない）。pj が分かった時点で1回呼ぶ
CUR_PJ=""
load_pj() {
  local pj=$1; CUR_PJ=$pj
  if [[ -f "$PJ_DIR/$pj.env" ]]; then
    local _c0="${CLAUDE_CODE_OAUTH_TOKEN:-}" _g0="${GH_TOKEN:-}"
    set -a; # shellcheck disable=SC1090
    source "$PJ_DIR/$pj.env"; set +a
    [[ "${CLAUDE_CODE_OAUTH_TOKEN:-}" != "$_c0" ]] && _src_claude="pj/$pj.env"
    [[ "${GH_TOKEN:-}" != "$_g0" ]] && _src_gh="pj/$pj.env"
  fi
  [[ -n "$_ovr_claude" ]] && { CLAUDE_CODE_OAUTH_TOKEN="$_ovr_claude"; _src_claude="SANDBOX_CLAUDE_TOKEN(一回限り)"; }
  [[ -n "$_ovr_gh" ]] && { GH_TOKEN="$_ovr_gh"; _src_gh="SANDBOX_GH_TOKEN(一回限り)"; }
  return 0
}
# テナントの規則（_tenant.sh と同じ。env に明示があればそれが勝つ）
: "${SB_TENANT:=main}"
: "${SB_PREFIX:=sb-$SB_TENANT}"          # VM 名の接頭辞 → sb-<t>-<pj>-NN
: "${SB_DOMAIN:=$SB_TENANT.sb.internal}" # DNS ドメイン → task-<id>.<t>.sb.internal
: "${SB_POOL:=sb-$SB_TENANT}"            # リソースプール（API モード）
# Proxmox への口: PVE_API_TOKEN があれば API モード（テナントのプール限定）、無ければ PVE_HOST に ssh（ホスト管理者）
API_MODE=0; [[ -n "${PVE_API_TOKEN:-}" ]] && API_MODE=1
if (( API_MODE )); then
  [[ -n "${PVE_API_URL:-}" ]] || { echo "[error] PVE_API_URL が未設定（例: https://10.77.0.1:8006）" >&2; exit 1; }
else
  [[ -n "${PVE_HOST:-}" ]] || { echo "[error] PVE_HOST が未設定。~/.config/sandbox/env に Proxmox ホストの ssh エイリアスを書く（sandbox/templates/env.example 参照）。制御系 LXC なら PVE_API_TOKEN（API モード）" >&2; exit 1; }
fi
[[ -n "${GW_SSH:-}" ]] || { echo "[error] GW_SSH が未設定。~/.config/sandbox/env にゲートウェイ LXC の ssh 先（例: root@10.77.0.2）を書く（sandbox/templates/env.example 参照）" >&2; exit 1; }
: "${SB_KEY:=$HOME/.ssh/conf.d/aifactory/sb_ed25519}"
: "${APP_PORT:=3000}"
: "${SB_POOL_NET:=10.77.1}"   # プール VM が並ぶ /24 のプレフィックス（Proxmox 側 SB_NET.1 と揃える）
: "${SB_POOL_BASE:=9200}"     # プール VM の VMID 起点（Proxmox 側 40-pool.sh の SB_POOL_BASE と揃える）
: "${SB_JUMP:=}"     # 空なら tailnet 直結。Proxmox ホストの ssh エイリアス（例: pve1）を入れるとホスト経由（tailnet 未承認・不調時の代替）
[[ -f "$STATE" ]] || echo '{}' > "$STATE"
command -v jq >/dev/null || { echo "[error] jq が必要（brew install jq / apt install jq）" >&2; exit 1; }

SSH_OPTS=(-i "$SB_KEY" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=8)
[[ -n "$SB_JUMP" ]] && SSH_OPTS+=(-J "$SB_JUMP")
pve() { ssh -o BatchMode=yes "$PVE_HOST" "$@"; }
gw()  { ssh "${SSH_OPTS[@]}" "$GW_SSH" "$@"; }
vm()  { local ip=$1; shift; ssh "${SSH_OPTS[@]}" "dev@$ip" "$@"; }

die() { echo "[error] $*" >&2; exit 1; }

# ---------- Proxmox の操作（ssh / API の 2 実装。呼ぶ側はこの 9 つだけ使う）
api() { # method path [curl args...] → .data（JSON）
  local m=$1 path=$2; shift 2
  local ca=(); [[ -n "${PVE_API_CA:-}" ]] && ca=(--cacert "$PVE_API_CA"); [[ "${PVE_API_INSECURE:-}" == 1 ]] && ca=(-k)
  # 証明書の SAN はノード名と LAN の IP だけで、SDN 側の IP（SB_NET.0.1）は入っていない。URL はノード名にして、名前解決だけ SDN 側の IP に向ける
  [[ -n "${PVE_API_RESOLVE:-}" ]] && ca+=(--resolve "$PVE_API_RESOLVE")
  local scheme="PVEAPIToken" out
  out="$(curl -sS -f --connect-timeout 8 "${ca[@]}" -X "$m" -H "Authorization: $scheme=$PVE_API_TOKEN" "$PVE_API_URL/api2/json$path" "$@")" \
    || die "Proxmox API $m $path が失敗（PVE_API_URL / PVE_API_TOKEN / プール $SB_POOL の権限を確認）"
  jq -c '.data' <<< "$out"
}
_members=""
members() { # プールの qemu メンバー（JSON 行）。1 回だけ取る
  [[ -n "$_members" ]] || _members="$(api GET "/pools/$SB_POOL" | jq -c '.members[] | select(.type=="qemu")')"
  printf '%s\n' "$_members"
}
pve_node() { members | jq -r --arg v "$1" 'select(.vmid==($v|tonumber)) | .node' | head -1; }
api_wait() { # node upid → exitstatus OK なら 0
  local node=$1 upid; upid="$(jq -rn --arg u "$2" '$u|@uri')"
  local i st
  for i in $(seq 1 120); do
    st="$(api GET "/nodes/$node/tasks/$upid/status" | jq -r '"\(.status) \(.exitstatus // "")"')"
    [[ "$st" == stopped* ]] && { [[ "$st" == "stopped OK" ]] && return 0 || { echo "[api] task: $st" >&2; return 1; }; }
    sleep 2
  done; return 1
}
pve_vms() { # → "vmid name status"（テンプレート除く。ls / take が使う）
  if (( API_MODE )); then members | jq -r 'select((.template // 0) == 0) | "\(.vmid) \(.name) \(.status)"'
  else pve "qm list" | awk -v p="^$SB_PREFIX-" -v lo="$SB_POOL_BASE" -v hi="$((SB_POOL_BASE + 100))" '$2 ~ p && $1 > lo && $1 < hi {print $1, $2, $3}'; fi   # このテナントのプール帯だけ（接頭辞が前方一致する別テナントを除く）
}
pve_has_clean() { # vmid
  if (( API_MODE )); then api GET "/nodes/$(pve_node "$1")/qemu/$1/snapshot" | jq -e '.[] | select(.name=="clean")' >/dev/null
  else pve "qm listsnapshot $1" | grep -q '`-> clean\|clean '; fi
}
pve_lock() { # vmid → lock 名か空
  if (( API_MODE )); then api GET "/nodes/$(pve_node "$1")/qemu/$1/config" | jq -r '.lock // empty'
  else pve "qm config $1" | sed -n 's/^lock: //p'; fi
}
pve_rollback() { # vmid
  if (( API_MODE )); then local node; node="$(pve_node "$1")"; api_wait "$node" "$(api POST "/nodes/$node/qemu/$1/snapshot/clean/rollback" | jq -r .)"
  else pve "qm rollback $1 clean" >/dev/null 2>&1; fi
}
pve_status() { # vmid → running / stopped
  if (( API_MODE )); then api GET "/nodes/$(pve_node "$1")/qemu/$1/status/current" | jq -r .status
  else pve "qm status $1" | awk '{print $2}'; fi
}
pve_start() { # vmid
  if (( API_MODE )); then local node; node="$(pve_node "$1")"; api_wait "$node" "$(api POST "/nodes/$node/qemu/$1/status/start" | jq -r .)"
  else pve "qm start $1" >/dev/null; fi
}
# 以下 3 つは idle-stop（252）が使う。止める側は shutdown（guest agent / ACPI）→ 落ちなければ stop の 2 段。
# forceStop は使わない: ログで「行儀よく止まった」と「叩き落とした」を区別できるようにする
pve_uptime() { # vmid → 起動からの秒数。取れなければ空（= 不明。呼ぶ側は安全側に倒して止めない）
  if (( API_MODE )); then api GET "/nodes/$(pve_node "$1")/qemu/$1/status/current" | jq -r '.uptime // empty'
  else pve "qm status $1 --verbose" 2>/dev/null | sed -n 's/^uptime: //p'; fi
}
pve_shutdown() { # vmid → 120 秒で止まらなければ非 0
  if (( API_MODE )); then local node; node="$(pve_node "$1")"
    api_wait "$node" "$(api POST "/nodes/$node/qemu/$1/status/shutdown" --data-urlencode timeout=120 | jq -r .)"
  else pve "qm shutdown $1 --timeout 120" >/dev/null; fi
}
pve_stop() { # vmid（電源を落とす。shutdown が効かなかったときだけ）
  if (( API_MODE )); then local node; node="$(pve_node "$1")"; api_wait "$node" "$(api POST "/nodes/$node/qemu/$1/status/stop" | jq -r .)"
  else pve "qm stop $1" >/dev/null; fi
}
# ---------- state（台帳とロック）
# 「空き VM を選ぶ → 予約を書く」の間に別プロセスの take が割り込むと同じ VM が二重に貸し出される（2026-09 の 234）。
# 選定と予約の書き込みは $STATE.lock の排他区間の中でやる。読み取り（ls / ssh など）はロック無しのまま（mv が原子的なので壊れて見えない）
STATE_LOCK="$STATE.lock"
# ロックの待ち時間（秒）。idle-stop は shutdown が終わるまでロックを持つので、take 側の待ちはその分伸びる（252）
: "${SB_LOCK_WAIT:=150}"
# 台帳の隣に置く 2 つ。state.json（貸出の正本）には混ぜない
LAST_USED="${STATE%state.json}last-used.json"       # vmid → 最後に take / reset / release / reinject した時刻（ADR-0026 の書式）
IDLE_STOP_FILE="${STATE%state.json}idle-stop.json"  # 直近の idle-stop の結果（ls / console / MCP が「節電で停止中」を出すのに読む）
_state_locked=0; _lock_style=""; _reserved_task=""; _reserved_dns=""
state_lock_acquire() {
  local use_mkdir=0
  [[ "${SANDBOX_LOCK_MKDIR:-}" == 1 ]] && use_mkdir=1
  command -v flock >/dev/null 2>&1 || { use_mkdir=1; echo "[warn] flock が無いので mkdir でロックする（$STATE_LOCK.d）" >&2; }
  if (( use_mkdir )); then   # Mac の既定には flock が無い
    local i
    for i in $(seq 1 $(( SB_LOCK_WAIT * 5 ))); do
      if mkdir "$STATE_LOCK.d" 2>/dev/null; then _lock_style=mkdir; break; fi
      sleep 0.2
    done
    [[ "$_lock_style" == mkdir ]] || die "state.json のロックが取れない（$STATE_LOCK.d が $SB_LOCK_WAIT 秒消えない。別の sandbox が動いている？ 動いていなければ rmdir で消す）"
  else
    exec 9>"$STATE_LOCK"
    flock -w "$SB_LOCK_WAIT" 9 || die "state.json のロックが取れない（$STATE_LOCK。別の sandbox が動いている？）"
    _lock_style=flock
  fi
  _state_locked=1
  trap _on_exit EXIT   # $(reserve_vm ...) のサブシェルには親の trap が渡らないので、取った側でも張る
}
state_lock_release() {
  (( _state_locked )) || return 0
  _state_locked=0
  if [[ "$_lock_style" == mkdir ]]; then rmdir "$STATE_LOCK.d" 2>/dev/null || true; else exec 9>&-; fi
  _lock_style=""
}
with_state_lock() { # cmd...: 呼び手が既にロックを持っていれば取り直さない
  if (( _state_locked )); then "$@"; return; fi
  state_lock_acquire
  local rc=0; "$@" || rc=$?
  state_lock_release
  return "$rc"
}
_on_exit() { # 予約したまま落ちたら（rollback 失敗など）予約と DNS を戻す。ロックも返す
  local rc=$?
  if [[ -n "$_reserved_task" ]]; then
    local t="$_reserved_task"; _reserved_task=""
    [[ -n "$_reserved_dns" ]] && { _reserved_dns=""; dns_del "$t" >/dev/null 2>&1 || true; }
    state_del "$t" || true
    echo "[warn] task $t の仮予約を取り消した" >&2
  fi
  state_lock_release
  return "$rc"
}
trap _on_exit EXIT

state_get() { jq -r --arg id "$1" '.[$id] // empty | tostring' "$STATE"; }
state_field() { jq -r --arg id "$1" --arg f "$2" '.[$id][$f] // empty' "$STATE"; }
_state_set_raw() { local tmp; tmp=$(mktemp); jq --arg id "$1" --argjson v "$2" '.[$id]=$v' "$STATE" > "$tmp" && mv "$tmp" "$STATE"; }
_state_del_raw() { local tmp; tmp=$(mktemp); jq --arg id "$1" 'del(.[$id])' "$STATE" > "$tmp" && mv "$tmp" "$STATE"; }
state_set() { with_state_lock _state_set_raw "$@"; }
state_del() { with_state_lock _state_del_raw "$@"; }

# 最終利用の記録（252）。take / reset / release / reinject のたびに呼ぶ。返却した VM も「今使った」ことにするので、
# 返却直後に idle-stop が止めてしまうことはない
_touch_used_raw() {
  local tmp; tmp=$(mktemp)
  [[ -f "$LAST_USED" ]] || echo '{}' > "$LAST_USED"
  jq --arg v "$1" --arg t "$(date -Iseconds)" '.[$v]=$t' "$LAST_USED" > "$tmp" && mv "$tmp" "$LAST_USED"
}
touch_used() { [[ -n "${1:-}" ]] || return 0; with_state_lock _touch_used_raw "$1"; }
# ls / status の脚注。`[` 始まりなので console の parse_ls は捨てる（表の列は増やさない）
idle_stop_note() {
  [[ -f "$IDLE_STOP_FILE" ]] || return 0
  local n c; n="$(jq -r '(.stopped // []) | length' "$IDLE_STOP_FILE" 2>/dev/null || echo 0)"
  c="$(jq -r '(.candidates // []) | length' "$IDLE_STOP_FILE" 2>/dev/null || echo 0)"
  [[ "$n" =~ ^[0-9]+$ && "$c" =~ ^[0-9]+$ ]] || return 0
  (( n > 0 )) && echo "[idle-stop] $n 台が節電で停止中（次の take で起動、+30〜60 秒）。最終実行 $(jq -r '.last_run // "?"' "$IDLE_STOP_FILE")"
  # 候補（使われていないが足切りの内なので起動したまま）。候補が増えて足切りを超えると、古いものから止まる
  (( c > 0 )) && echo "[idle-stop] $c 台が停止候補（最終利用から $(jq -r '.hours // "?"' "$IDLE_STOP_FILE")h 超。$(jq -r '.keep // "?"' "$IDLE_STOP_FILE") 台までは起動したまま残す）"
  return 0
}

wait_port() { # ip port tries
  local i; for i in $(seq 1 "${3:-40}"); do
    if [[ -n "$SB_JUMP" ]]; then ssh -o BatchMode=yes "$SB_JUMP" "timeout 2 bash -c '</dev/tcp/$1/$2'" 2>/dev/null && return 0
    elif command -v nc >/dev/null; then nc -z -w 2 "$1" "$2" 2>/dev/null && return 0
    else timeout 2 bash -c "</dev/tcp/$1/$2" 2>/dev/null && return 0; fi
    sleep 3
  done; return 1
}

pool_ip() { echo "$SB_POOL_NET.$(( $1 - SB_POOL_BASE ))"; }   # プール VM の IP は VMID から一意に決まる（PJ 横断）
pool_list() { # pj -> lines "vmid name ip status"
  local pj=$1
  pve_vms | awk -v p="$SB_PREFIX-$pj-" '$2 ~ "^"p {print $1, $2, $3}' | while read -r vmid name status; do
    echo "$vmid $name $(pool_ip "$vmid") $status"
  done
}
# 「定義台数」（設定の値）と「実体台数」（Proxmox にある VM の数）は別物で、実体が足りないと take が空きなしで落ちる（241）。
# 定義の正本は SANDBOX_POOL_PER_PJ（glue/bin/dispatch と同じ変数名）。貸出は台帳の vmid の異なり（同じ VM の複数貸出を 2 台と数えない）
pool_counts() { # pj -> "定義 実体 貸出"
  local pj=$1 defined actual lent
  defined="${SANDBOX_POOL_PER_PJ:-3}"
  actual="$(pool_list "$pj" | grep -c '^' || true)"
  lent="$(jq -r --arg p "$pj" '[.[] | select(.pj==$p) | .vmid] | unique | length' "$STATE")"
  echo "$defined $actual $lent"
}

# ---------- GitHub App（ADR-0008）: JWT → installation token
GHAPP_DIR="$CONF_DIR/gh-app"
ghapp_ready() { [[ -f "$GHAPP_DIR/app.env" && -f "$GHAPP_DIR/private-key.pem" ]]; }
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
ghapp_jwt() { # -> JWT（10 分）
  local app_id; app_id="$(sed -n 's/^APP_ID=//p' "$GHAPP_DIR/app.env")"
  local now; now=$(date +%s)
  local h p sig
  h=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  p=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now-60)) $((now+540)) "$app_id" | b64url)
  sig=$(printf '%s.%s' "$h" "$p" | openssl dgst -sha256 -sign "$GHAPP_DIR/private-key.pem" -binary | b64url)
  printf '%s.%s.%s' "$h" "$p" "$sig"
}
ghapp_api() { # method path [json]
  local m=$1 path=$2 body=${3:-}
  curl -sS -X "$m" -H "Authorization: Bearer $(ghapp_jwt)" -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
    ${body:+-d "$body"} "https://api.github.com$path"
}
# ghapp_token <owner/repo> -> ghs_...（1 時間有効。そのリポジトリだけ・contents/pull_requests/workflows write）
ghapp_token() {
  local repo=$1 owner=${1%%/*} name=${1##*/} inst installation
  installation="$(ghapp_api GET "/repos/$repo/installation")"
  inst="$(jq -r '.id // empty' <<< "$installation")"
  [[ -n "$inst" ]] || { echo "[error] GitHub App が $repo に install されていない（sandbox gh-app status で install リンクを表示）" >&2; return 1; }
  # 要求する権限 = 欲しい権限のうち App が持っているもの（App 側で権限を足して installation が承認すれば、自動でトークンに乗る）
  #   contents/pull_requests write（push と PR）、workflows write（.github/workflows を含む push。無いと GitHub が拒否する）、metadata read、actions read（CI 履歴: gh run list）、checks read（gh pr checks）
  local have want
  have="$(jq -c '.permissions // {}' <<< "$installation")"
  want="$(jq -nc --argjson h "$have" '{contents:"write",pull_requests:"write",workflows:"write",metadata:"read",actions:"read",checks:"read"} | with_entries(select($h[.key] != null))')"
  local missing; missing="$(jq -nc --argjson h "$have" '["actions","checks","workflows"] | map(select($h[.] == null)) | join(",")' -r)"
  [[ -n "$missing" ]] && echo "[gh] 注意: App に $missing 権限が無い（actions=CI 履歴に必要 / checks=gh pr checks に任意 / workflows=.github/workflows を触る push に必要。sandbox gh-app status に変更 URL）" >&2
  local response token
  response="$(ghapp_api POST "/app/installations/$inst/access_tokens" "$(jq -nc --arg r "$name" --argjson p "$want" '{repositories:[$r],permissions:$p}')")"
  token="$(jq -r '.token // empty' <<< "$response")"
  [[ -n "$token" ]] || { echo "[error] installation token: $(jq -r '.message // "empty response"' <<< "$response")" >&2; return 1; }
  printf '%s\n' "$token"
}
# resolve_gh_token <pj>: App があれば払い出し、無ければ静的 GH_TOKEN。結果を GH_TOKEN に入れる
resolve_gh_token() {
  local pj=$1 repo="${GH_REPO:-}"
  [[ -n "$_ovr_gh" ]] && { GH_TOKEN="$_ovr_gh"; return 0; }
  if ghapp_ready && [[ -n "$repo" ]]; then
    local t; t="$(ghapp_token "$repo")" || return 1
    [[ -n "$t" ]] || { echo "[error] installation token を取得できない（$repo）" >&2; return 1; }
    GH_TOKEN="$t"; GH_TOKEN_SOURCE="app:$repo"
  else
    GH_TOKEN_SOURCE="${GH_TOKEN:+static}"
  fi
  return 0
}

inject_env() { # ip task pj
  local ip=$1 task=$2 pj=$3
  resolve_gh_token "$pj" || return 1
  local exp=""; [[ "${GH_TOKEN_SOURCE:-}" == app:* ]] && exp="$(date -u -v+55M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d '+55 min' +%Y-%m-%dT%H:%M:%SZ)"
  vm "$ip" 'umask 077; cat > /run/sandbox/env' <<EOF
TASK_ID=$task
SANDBOX_PJ=$pj
SANDBOX_HOST=task-$task.$SB_DOMAIN
CLAUDE_CODE_OAUTH_TOKEN=${CLAUDE_CODE_OAUTH_TOKEN:-}
GH_TOKEN=${GH_TOKEN:-}
GH_REPO=${GH_REPO:-}
GH_TOKEN_EXPIRES_AT=$exp
EOF
  [[ -n "$exp" ]] && echo "[gh] installation token for ${GH_REPO} (expires $exp UTC; 延長は sandbox gh-app refresh)"
  return 0
}

dns_set() { gw "sed -i '/ task-$1\$/d' /etc/sandbox/hosts; echo '$2 task-$1' >> /etc/sandbox/hosts; systemctl reload dnsmasq"; }
dns_del() { gw "sed -i '/ task-$1\$/d' /etc/sandbox/hosts; systemctl reload dnsmasq"; }

# rollback の再試行（Proxmox の lock は一過性なので待って試す）。運用で足りなければ env で伸ばす
: "${SB_ROLLBACK_TRIES:=3}"
: "${SB_ROLLBACK_WAIT:=10}"
_rollback_err=""
rollback() { # vmid ip → 0 / 1（失敗理由は $_rollback_err）
  # die しないで rc を返す。「巻き戻せていないのに released」と言わないため、state を消すかどうかは呼び手が決める（245）
  # 直前の rollback（RAM 復元）のロックが残っていることがあるので、解放を待ってからリトライする。
  # 無言で再試行すると失敗ログの直後に [ok] が出て「無視した」ように見えるので、失敗のたびに理由を出す
  local i lock out n=$SB_ROLLBACK_TRIES w=$SB_ROLLBACK_WAIT started=0 t0=$SECONDS
  _rollback_err=""
  for (( i = 1; i <= n; i++ )); do
    lock="$(pve_lock "$1" || true)"
    if [[ -n "$lock" ]]; then
      _rollback_err="ロック中: $lock"
    elif out="$(pve_rollback "$1" 2>&1)"; then
      _rollback_err=""; break
    else
      _rollback_err="$(printf '%s' "$out" | tail -1)"; [[ -n "$_rollback_err" ]] || _rollback_err="rollback API が失敗"
    fi
    if (( i < n )); then
      echo "[warn] vm $1: rollback 失敗 ($i/$n): $_rollback_err。${w}秒後に再試行" >&2
      sleep "$w"
    else
      echo "[warn] vm $1: rollback 失敗 ($i/$n): $_rollback_err" >&2
      return 1
    fi
  done
  # idle-stop（252）が止めた VM はここで起動する。黙って 30〜60 秒待つと runner のログでは固まったように見えるので、待った理由を出す
  if [[ "$(pve_status "$1")" != running ]]; then
    pve_start "$1" || { _rollback_err="vm $1: 起動に失敗"; return 1; }
    started=1
  fi
  if ! wait_port "$2" 22; then _rollback_err="vm $1 ($2): ssh が上がらない"; return 1; fi
  if (( started )); then echo "[start] vm $1: 停止中だったので起動した（$(( SECONDS - t0 )) 秒）"; fi
  return 0
}

# ---------- take（予約 → 準備 → 確定）
# reserve_vm <pj> <task>: ロックの中で空き VM を選び、phase=taking の仮予約を state.json に書いて "vmid name ip status" を返す。
# ロックの中でやるのは Proxmox の読み取り（pool_list / pve_has_clean）だけ。rollback / ssh / DNS は外でやる
_reserve_vm_locked() {
  local pj=$1 task=$2
  [[ -z "$(state_get "$task")" ]] || die "task $task は貸出中（$(state_field "$task" name)）"
  local busy; busy="$(jq -r '.[].vmid' "$STATE" | tr '\n' ' ')"
  local pick="" noclean=0
  while read -r vmid name ip status; do
    [[ " $busy " == *" $vmid "* ]] && continue
    pve_has_clean "$vmid" || { noclean=$(( noclean + 1 )); echo "[warn] $name: snapshot clean 無し、スキップ" >&2; continue; }
    pick="$vmid $name $ip $status"; break
  done < <(pool_list "$pj")
  # 「空きなし」だけでは、返却を待てばよいのか VM を足すのか手直しなのかが決まらない。内訳と次の一手を添える（241）
  if [[ -z "$pick" ]]; then
    local defined actual lent unbuilt add
    read -r defined actual lent <<< "$(pool_counts "$pj")"
    unbuilt=$(( defined - actual )); (( unbuilt < 0 )) && unbuilt=0
    add=$(( unbuilt > 0 ? unbuilt : 1 ))
    die "pj=$pj に空きなし: 定義 $defined 台・実体 $actual 台・貸出 $lent 台（未構築 $unbuilt 台 / clean 無し $noclean 台）。返却を待つ（sandbox ls）か、proxmox/40-pool.sh $pj $add で足してください"
  fi
  local vmid name ip status; read -r vmid name ip status <<< "$pick"
  # ロックが効いていれば起きない。効いていないときに二重貸出を素通りさせないための念押し
  local other; other="$(jq -r --arg v "$vmid" 'to_entries[] | select(.value.vmid==($v|tonumber)) | .key' "$STATE" | head -1)"
  [[ -z "$other" ]] || die "vmid $vmid は task $other に貸出中（state.json）"
  _state_set_raw "$task" "$(jq -nc --arg v "$vmid" --arg n "$name" --arg i "$ip" --arg p "$pj" --arg s "$(date -Iseconds)" \
    '{vmid:($v|tonumber),name:$n,ip:$i,pj:$p,since:$s,phase:"taking"}')"
  printf '%s\n' "$pick"
}
reserve_vm() { with_state_lock _reserve_vm_locked "$@"; }

cmd_take() {
  local pj=${1:?pj} task=${2:?task-id}
  load_pj "$pj"
  [[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]] || echo "[warn] CLAUDE_CODE_OAUTH_TOKEN が未設定（sandbox token set ${pj}）" >&2
  local pick; pick="$(reserve_vm "$pj" "$task")"   # die はサブシェルを抜けるだけなので、空なら止める
  [[ -n "$pick" ]] || exit 1
  _reserved_task="$task"   # ここから先で落ちたら _on_exit が予約を消す
  local vmid name ip status; read -r vmid name ip status <<< "$pick"
  echo "[take] $name (vmid $vmid, $ip) → task-$task"
  if [[ "$status" != running ]] || ! wait_port "$ip" 22; then
    rollback "$vmid" "$ip" || die "vm $vmid: rollback が通らない（$_rollback_err）"
  fi
  inject_env "$ip" "$task" "$pj"
  dns_set "$task" "$ip"; _reserved_dns=1
  local rec; rec="$(jq -nc --arg v "$vmid" --arg n "$name" --arg i "$ip" --arg p "$pj" --arg s "$(date -Iseconds)" \
    '{vmid:($v|tonumber),name:$n,ip:$i,pj:$p,since:$s}')"
  _reserved_task=""; _reserved_dns=""   # 確定。以降の EXIT で消さない
  state_set "$task" "$rec"
  touch_used "$vmid"
  echo "[ok] task-$task.$SB_DOMAIN  ssh: sandbox ssh $task  url: http://task-$task.$SB_DOMAIN:$APP_PORT"
}

cmd_ssh() {
  local task=${1:?task-id}; shift || true
  local ip; ip="$(state_field "$task" ip)"; [[ -n "$ip" ]] || die "task $task は未貸出"
  load_pj "$(state_field "$task" pj)"
  if (( $# == 0 )); then exec ssh -t "${SSH_OPTS[@]}" "dev@$ip" 'exec bash -l'; fi
  local q; q=$(printf '%q ' "$@")
  exec ssh "${SSH_OPTS[@]}" "dev@$ip" -- bash -lc "$q"
}

cmd_url() { local task=${1:?task-id}; [[ -n "$(state_get "$task")" ]] || die "task $task は未貸出"; load_pj "$(state_field "$task" pj)"; echo "http://task-$task.$SB_DOMAIN:$APP_PORT"; }

cmd_reset() {
  local task=${1:?task-id}
  local vmid ip pj; vmid="$(state_field "$task" vmid)"; ip="$(state_field "$task" ip)"; pj="$(state_field "$task" pj)"
  [[ -n "$vmid" ]] || die "task $task は未貸出"
  load_pj "$pj"
  echo "[reset] $(state_field "$task" name) → clean"
  rollback "$vmid" "$ip" || die "vm $vmid: 巻き戻しに失敗（$_rollback_err）。貸出は継続。\`sandbox reset $task\` を後で再実行するか、\`sandbox ls\` で VM の状態を確かめてください"
  inject_env "$ip" "$task" "$pj"
  touch_used "$vmid"
  echo "[ok] reset 完了（env 再注入済み）"
}

cmd_release() {
  local task="" force=0 a
  for a in "$@"; do
    case "$a" in
      --force) force=1 ;;
      *) if [[ -n "$task" ]]; then die "usage: sandbox release <task-id> [--force]"; fi; task=$a ;;
    esac
  done
  [[ -n "$task" ]] || die "usage: sandbox release <task-id> [--force]"
  local vmid ip; vmid="$(state_field "$task" vmid)"; ip="$(state_field "$task" ip)"
  [[ -n "$vmid" ]] || die "task $task は未貸出"
  echo "[release] $(state_field "$task" name) ← task-$task"
  if ! rollback "$vmid" "$ip"; then
    # 巻き戻せていない VM を state から消すと、次の take が clean だと思って貸し出す（245）
    (( force )) || die "vm $vmid: 巻き戻しに失敗（$_rollback_err）。state は保持。\`sandbox release $task\` を後で再実行するか、\`sandbox ls\` で VM の状態を確かめてください（VM を手で直したなら \`sandbox release $task --force\`）"
    echo "[warn] 巻き戻し失敗を無視して返却（--force）: $_rollback_err" >&2
    dns_del "$task" || true
    state_del "$task"
    touch_used "$vmid"
    echo "[ok] released (--force)"
    return 0
  fi
  dns_del "$task"
  state_del "$task"
  touch_used "$vmid"
  echo "[ok] released"
}

mask() { local t=$1; [[ -z "$t" ]] && { echo "(未設定)"; return; }; echo "${t:0:8}…${t: -4} (${#t}文字)"; }

# _write_key <file> <key> <val>: env ファイルの該当行だけを書き換える（val が空なら削除）。
#   ctl.env には CONSOLE_TOKEN や説明コメントが同居するので、丸ごと上書きせず該当行と発行日コメントだけ差し替える
_write_key() {
  local file=$1 key=$2 val=$3 tmp
  tmp=$(mktemp); grep -v -e "^$key=" -e "^# $key issued: " "$file" > "$tmp" || true
  [[ -n "$val" ]] && printf '# %s issued: %s\n%s=%s\n' "$key" "$(date +%F)" "$key" "$val" >> "$tmp"
  mv "$tmp" "$file"; chmod 600 "$file"
}

# _issued <file> <key>: 保存時に書いた発行日（YYYY-MM-DD）。無ければ空
_issued() { [[ -f "$1" ]] && sed -n "s/^# $2 issued: //p" "$1" | tail -1 || true; }

# _issued_days <YYYY-MM-DD>: 発行からの日数。GNU / mac のどちらの date でも計算できなければ空を返す（表示を落とさない）
_issued_days() {
  local e; e="$(date -j -f %Y-%m-%d "$1" +%s 2>/dev/null || date -d "$1" +%s 2>/dev/null)" || return 0
  [[ -n "$e" ]] || return 0
  echo $(( ( $(date +%s) - e ) / 86400 ))
}

# _issued_note <key> <src>: token show の行末に足す「発行から N 日」。src は _src_claude / _src_gh の値
_issued_note() {
  local key=$1 src=$2 file="" d n
  case "$src" in
    "global(env)") file="$ENV_FILE" ;;
    pj/*) file="$PJ_DIR/${src#pj/}" ;;
    *) return 0 ;;
  esac
  d="$(_issued "$file" "$key")"
  [[ -n "$d" ]] || { echo "発行日不明（token set / rotate で保存し直すと記録される）"; return 0; }
  n="$(_issued_days "$d")"
  [[ -n "$n" ]] && echo "発行から $n 日（issued $d）" || echo "issued $d"
}

# token set <pj|global> [claude|gh] : 対話入力（エコー無し）で保存。ファイルは 600
cmd_token() {
  local sub=${1:-}; shift || true
  case "$sub" in
    set|clear)
      local scope=${1:?pj または global} kind=${2:-claude} file key
      case "$kind" in claude) key=CLAUDE_CODE_OAUTH_TOKEN;; gh) key=GH_TOKEN;; *) die "kind は claude か gh";; esac
      if [[ "$scope" == global ]]; then file="$ENV_FILE"; else mkdir -p "$PJ_DIR"; file="$PJ_DIR/$scope.env"; [[ -f "$file" ]] || { echo "# sandbox PJ 別設定: ${scope}（~/.config/sandbox/env を上書き）" > "$file"; chmod 600 "$file"; }; fi
      local val=""
      if [[ "$sub" == set ]]; then
        if [[ -t 0 ]]; then read -rs -p "$key for $scope: " val; echo; else val="$(cat)"; fi
        val="${val//[$'\r\n']/}"
        [[ -n "$val" ]] || die "空のトークン"
      fi
      _write_key "$file" "$key" "$val"
      echo "[ok] $key を $file に$([[ "$sub" == set ]] && echo 保存 || echo 削除)"
      if [[ "$scope" != global ]]; then
        local lent; lent="$(jq -r --arg p "$scope" 'to_entries[] | select(.value.pj==$p) | .key' "$STATE" | tr '\n' ' ')"
        [[ -n "$lent" ]] && echo "[hint] 貸出中の task ($lent) に反映するには: sandbox reinject --all（VM 内の claude は再起動が必要）"
        true
      fi ;;
    rotate)
      # 1 回の入力で global・鍵を持つ全 PJ・ctl.env を差し替える（ADR-0029）。
      # 順序は「ファイル更新 → 一覧 → console restart → reinject」。後段が失敗しても、更新できた場所は一覧に残す
      local kind=${1:-claude} key
      case "$kind" in claude) key=CLAUDE_CODE_OAUTH_TOKEN;; gh) key=GH_TOKEN;; *) die "kind は claude か gh";; esac
      local is_ctl=0; [[ -f "$CTL_ENV" ]] && is_ctl=1
      (( is_ctl )) || echo "[warn] このホストは制御系（ctl）ではない（$CTL_ENV が無い）。Mac 運用は停止中なので、制御系 LXC（ssh aifactory@ctl.${SB_DOMAIN}）で実行してください"
      local val=""
      if [[ -t 0 ]]; then read -rs -p "$key（global・全 PJ・ctl.env をまとめて更新）: " val; echo; else val="$(cat)"; fi
      val="${val//[$'\r\n']/}"
      [[ -n "$val" ]] || die "空のトークン"
      local n=0 skip=0 f
      _write_key "$ENV_FILE" "$key" "$val"; echo "[updated] $ENV_FILE (global)"; n=$((n+1))
      for f in "$PJ_DIR"/*.env; do
        [[ -f "$f" ]] || continue
        if grep -q "^$key=" "$f"; then _write_key "$f" "$key" "$val"; echo "[updated] $f"; n=$((n+1))
        else echo "[skip]    $f（$key が無い。この PJ は上の層を使う）"; skip=$((skip+1)); fi
      done
      local ctl_done=0
      if (( is_ctl )); then
        if grep -q "^$key=" "$CTL_ENV"; then _write_key "$CTL_ENV" "$key" "$val"; echo "[updated] $CTL_ENV"; n=$((n+1)); ctl_done=1
        else echo "[skip]    $CTL_ENV（$key の行が無い）"; skip=$((skip+1)); fi
      else
        echo "[skip]    $CTL_ENV（無し）"
      fi
      echo "$n 箇所更新 / $skip 箇所 skip   $key = $(mask "$val")"
      if (( ctl_done )); then
        # console は起動時に ctl.env を読むので、intake の claude -p に効かせるには restart が要る
        # （aifactory-gh-refresh.timer は oneshot で毎回読み直すので不要）
        local sudo=""; [[ $EUID -eq 0 ]] || sudo="sudo"
        if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files aifactory-console.service 2>/dev/null | grep -q aifactory-console; then
          if [[ -z "$sudo" ]] || sudo -n true 2>/dev/null; then
            if $sudo systemctl restart aifactory-console; then echo "[ok] aifactory-console を restart した"
            else echo "[要手動] restart に失敗。次のコマンドを実行してください: sudo systemctl restart aifactory-console"; fi
          else
            echo "[要手動] 次のコマンドを実行してください: sudo systemctl restart aifactory-console"
          fi
        else
          echo "[hint] systemd に aifactory-console が無い。console を動かしているなら手で再起動してください"
        fi
      fi
      # 起動時に読んだ古い値が reinject に混ざらないよう、この実行の中でも新しい値に揃える
      case "$kind" in claude) CLAUDE_CODE_OAUTH_TOKEN="$val";; gh) GH_TOKEN="$val";; esac
      local ids; ids="$(jq -r 'keys[]' "$STATE")"
      if [[ -n "$ids" ]]; then echo "--- 貸出中 VM に再注入"; cmd_reinject --all
      else echo "貸出中の task なし（reinject 不要）"; fi ;;
    show)
      local pj=${1:-} pjfile=""
      if [[ -n "$pj" ]]; then load_pj "$pj"; pjfile="$PJ_DIR/$pj.env"; [[ -f "$pjfile" ]] || pjfile="$pjfile (無し)"; fi
      if [[ -f "$CTL_ENV" ]]; then echo "host: 制御系（ctl.env あり）。トークンの差し替えは sandbox token rotate"
      else echo "host: 手元（ctl.env なし）。Mac 運用は停止中 → 差し替えは制御系 LXC で実行してください"; fi
      echo "scope: ${pj:-global}   files: $ENV_FILE${pjfile:+ + $pjfile}"
      echo "CLAUDE_CODE_OAUTH_TOKEN: $(mask "${CLAUDE_CODE_OAUTH_TOKEN:-}")  ← ${_src_claude:-未設定}  $(_issued_note CLAUDE_CODE_OAUTH_TOKEN "${_src_claude:-}")"
      if ghapp_ready && [[ -n "${GH_REPO:-}" ]]; then
        echo "GH_TOKEN:                GitHub App が take 時に払い出す（${GH_REPO} 限定・1 時間）$([[ -n "${GH_TOKEN:-}" ]] && echo "  ※静的 GH_TOKEN も ${_src_gh} にあるが App が優先")"
      else
        echo "GH_TOKEN:                $(mask "${GH_TOKEN:-}")  ← ${_src_gh:-未設定}$([[ -n "$pj" && -z "${GH_REPO:-}" ]] && echo "（GH_REPO 未設定のため App は使えない）")  $(_issued_note GH_TOKEN "${_src_gh:-}")"
      fi
      echo "APP_PORT: $APP_PORT  SB_JUMP: ${SB_JUMP:-(直結)}  proxmox: $([[ $API_MODE == 1 ]] && echo "API $PVE_API_URL pool=$SB_POOL" || echo "ssh $PVE_HOST")  env: $ENV_FILE"
      [[ -d "$PJ_DIR" ]] && echo "PJ 別ファイル: $(ls "$PJ_DIR" 2>/dev/null | sed 's/\.env$//' | tr '\n' ' ')" ;;
    *) die "usage: sandbox token set|clear <pj|global> [claude|gh] / sandbox token rotate [claude|gh] / sandbox token show [pj]" ;;
  esac
}

# reinject <task-id>|--all : 貸出中の VM の /run/sandbox/env を現在の設定で書き直す（巻き戻しなし）
cmd_reinject() {
  local arg=${1:?task-id または --all} ids
  if [[ "$arg" == --all ]]; then ids="$(jq -r 'keys[]' "$STATE")"; else ids="$arg"; fi
  [[ -n "$ids" ]] || { echo "貸出中の task なし"; return 0; }
  local task
  for task in $ids; do
    local ip pj; ip="$(state_field "$task" ip)"; pj="$(state_field "$task" pj)"
    [[ -n "$ip" ]] || die "task $task は未貸出"
    load_pj "$pj"
    inject_env "$ip" "$task" "$pj"
    touch_used "$(state_field "$task" vmid)"
    echo "[ok] task-$task ($(state_field "$task" name)): env 再注入。claude を使っている場合は VM 内で再起動"
  done
}

cmd_gh_app() {
  local sub=${1:-status}; shift || true
  case "$sub" in
    status)
      if ghapp_ready; then
        local slug; slug="$(sed -n 's/^APP_SLUG=//p' "$GHAPP_DIR/app.env")"
        echo "app: $(sed -n 's/^APP_ID=//p' "$GHAPP_DIR/app.env") ($slug)  key: $GHAPP_DIR/private-key.pem"
        echo "install / 設定変更: https://github.com/apps/$slug/installations/new"
        echo "権限の変更: https://github.com/settings/apps/$slug/permissions"
        echo "--- app permissions（必要: contents=write pull_requests=write metadata=read actions=read / 任意: checks=read、workflows=write（PJ が .github/workflows を触るなら必須。無いと push が拒否される））"
        ghapp_api GET /app | jq -r '.permissions | to_entries[] | "  \(.key)=\(.value)"'
        ghapp_api GET /app | jq -e '.permissions.actions == "read"' >/dev/null 2>&1 || echo "  !! actions=read が無い（research が CI 履歴を読めない。上の URL で Actions: Read-only を足し、各 installation で承認）"
        ghapp_api GET /app | jq -e '.permissions.checks == "read"' >/dev/null 2>&1 || echo "  (任意) checks=read が無い（gh pr checks は使えない。gh run list --branch <head> で代替できる）"
        echo "--- installations"
        ghapp_api GET /app/installations | jq -r '.[] | "  \(.account.login) (\(.repository_selection))  id=\(.id)"'
        echo "--- PJ → repo → token 可否"
        local f pj repo
        for f in "$PJ_DIR"/*.env; do [[ -f "$f" ]] || continue; pj="$(basename "$f" .env)"; repo="$(sed -n 's/^GH_REPO=//p' "$f")"
          [[ -n "$repo" ]] || { echo "  $pj: GH_REPO 未設定"; continue; }
          if ghapp_api GET "/repos/$repo/installation" | jq -e .id >/dev/null 2>&1; then echo "  $pj: $repo  OK"; else echo "  $pj: $repo  未 install"; fi
        done
      else
        echo "GitHub App 未設定（$GHAPP_DIR/app.env と private-key.pem が必要。BUILD.md Step 0b）"; return 1
      fi ;;
    token)
      local pj=${1:?pj}; load_pj "$pj"; ghapp_ready || die "GitHub App 未設定"
      [[ -n "${GH_REPO:-}" ]] || die "pj/$pj.env に GH_REPO が無い"
      ghapp_token "$GH_REPO" ;;
    refresh)
      local ids; ids="$(jq -r 'keys[]' "$STATE")"; [[ -n "$ids" ]] || { echo "貸出中の task なし"; return 0; }
      local task; for task in $ids; do
        local ip pj; ip="$(state_field "$task" ip)"; pj="$(state_field "$task" pj)"; load_pj "$pj"
        inject_env "$ip" "$task" "$pj" && echo "[ok] task-$task ($(state_field "$task" name)): GH_TOKEN 更新"
      done ;;
    *) die "usage: sandbox gh-app status|token <pj>|refresh" ;;
  esac
}

# ---------- idle-stop（使われていないプール VM を止める。次の take が起動し直す。252 / 2026-09-09 に足切りを追加）
# 2 段で決める:
#   1. 候補にする = 貸出中でなく、最終利用から N 時間（既定 24。SB_IDLE_STOP_HOURS）経ったプール VM
#   2. 止める     = 候補を最終利用の古い順に並べ、新しい方から K 台（既定 10。SB_IDLE_STOP_KEEP）を残して、それより古いものだけ
# 候補が K 台以下なら 1 台も止めない（K=0 なら候補を全部止める）。候補のまま残した VM は idle-stop.json の candidates に載せる。
# 制御系の ctl / gw は LXC なので pve_vms（API モードは qemu 限定）にも名前の除外にも掛からず、対象に入らない。
# 止める 1 台ごとに、判定のやり直し → shutdown 完了まで $STATE.lock を持つ: ロックを出た直後に take が予約すると、その VM は
# まだ running・ssh も生きているので rollback() の起動待ちを飛ばし、直後に落ちて run が死ぬ。
_epoch() { # ISO 8601（オフセット付き。ADR-0026）→ epoch 秒。読めなければ空
  date -d "$1" +%s 2>/dev/null && return 0
  local s=$1; s="${s%:*}${s##*:}"   # BSD date の %z はコロン付きオフセットを読めない
  date -j -f '%Y-%m-%dT%H:%M:%S%z' "$s" +%s 2>/dev/null || true
}
_hm() { printf '%dh%02dm' $(( $1 / 3600 )) $(( $1 % 3600 / 60 )); }
idle_hours_for() { # pj 既定 → その PJ の SB_IDLE_STOP_HOURS
  # load_pj は env を累積 source するので、PJ A の値が PJ B に漏れないようサブシェルで読む
  ( load_pj "$1" >/dev/null 2>&1 || true; echo "${SB_IDLE_STOP_HOURS:-$2}" )
}
# _idle_classify vmid name hours now → 判定を $_idle_verdict に入れる（candidate / lent / fresh / unknown / off）。
# candidate と fresh のとき $_idle_since（最終利用の epoch）/ $_idle_age（秒）/ $_idle_src（最終利用 | 起動から）/ $_idle_last（記録。無ければ空）
_idle_verdict=""; _idle_since=""; _idle_age=0; _idle_src=""; _idle_last=""; _idle_entry=""
_idle_classify() {
  local vmid=$1 name=$2 h=$3 now=$4
  _idle_verdict=unknown; _idle_since=""; _idle_age=0; _idle_src=""; _idle_last=""
  if (( h == 0 )); then _idle_verdict=off; return 0; fi
  local task; task="$(jq -r --arg v "$vmid" 'to_entries[] | select(.value.vmid==($v|tonumber)) | .key' "$STATE" | paste -sd, -)"
  if [[ -n "$task" ]]; then _idle_verdict=lent; return 0; fi
  local last="" since="" src=""
  [[ -f "$LAST_USED" ]] && last="$(jq -r --arg v "$vmid" '.[$v] // empty' "$LAST_USED")"
  if [[ -n "$last" ]]; then since="$(_epoch "$last")"; src="最終利用"; fi
  if [[ -z "$since" ]]; then   # 記録が無い VM は「起動からの時間」で代用する
    local up; up="$(pve_uptime "$vmid" </dev/null || true)"
    if [[ "$up" =~ ^[0-9]+$ ]] && (( up > 0 )); then since=$(( now - up )); src="起動から"; fi
  fi
  if [[ -z "$since" ]]; then _idle_verdict=unknown; return 0; fi
  local age=$(( now - since )); (( age < 0 )) && age=0
  _idle_since=$since; _idle_age=$age; _idle_src=$src; _idle_last=$last
  if (( age < h * 3600 )); then _idle_verdict=fresh; return 0; fi
  _idle_verdict=candidate; return 0
}
# _idle_stop_one vmid name hours now dry → ロックの中で判定し直してから止める。$_idle_verdict は
# stopped / fail、または判定し直しで候補でなくなったときの lent / fresh / unknown / off。止めた VM の記録は $_idle_entry に JSON で入る
_idle_stop_one() {
  local vmid=$1 name=$2 h=$3 now=$4 dry=$5
  _idle_entry=""
  _idle_classify "$vmid" "$name" "$h" "$now"
  case "$_idle_verdict" in
    candidate) ;;
    unknown) echo "[idle-stop] $name ($vmid): 見送り（最終利用の記録なし・uptime も不明）"; return 0 ;;
    *) echo "[idle-stop] ${name} (${vmid}): 見送り（判定のあとに状態が変わった: ${_idle_verdict}）"; return 0 ;;
  esac
  if (( dry )); then
    echo "[idle-stop] ${name} (${vmid}): 止める（${_idle_src} $(_hm "$_idle_age") 前、${h}h 超）※ --dry-run なので止めない"
    _idle_verdict=stopped; return 0
  fi
  echo "[idle-stop] ${name} (${vmid}): shutdown（${_idle_src} $(_hm "$_idle_age") 前、${h}h 超）"
  if ! pve_shutdown "$vmid" </dev/null; then
    echo "[warn] $name ($vmid): shutdown が 120 秒で止まらず stop" >&2
    if ! pve_stop "$vmid" </dev/null; then
      echo "[warn] $name ($vmid): stop も失敗。この VM は止めない" >&2
      _idle_verdict=fail; return 0
    fi
  fi
  _idle_entry="$(jq -nc --arg v "$vmid" --arg n "$name" --arg a "$(date -Iseconds)" --arg l "$_idle_last" \
    '{vmid:($v|tonumber), name:$n, at:$a, last_used:(if $l == "" then null else $l end)}')"
  _idle_verdict=stopped; return 0
}

cmd_idle_stop() { # [--hours N] [--keep K] [--dry-run]
  local hours="" keep="" dry=0
  while (( $# )); do
    case "$1" in
      --hours) hours=${2:?--hours には時間数が要る}; shift 2 ;;
      --hours=*) hours=${1#*=}; shift ;;
      --keep) keep=${2:?--keep には台数が要る}; shift 2 ;;
      --keep=*) keep=${1#*=}; shift ;;
      --dry-run) dry=1; shift ;;
      *) die "usage: sandbox idle-stop [--hours N] [--keep K] [--dry-run]" ;;
    esac
  done
  [[ -n "$hours" ]] || hours="${SB_IDLE_STOP_HOURS:-24}"
  [[ "$hours" =~ ^[0-9]+$ ]] || die "idle-stop: 時間数は 0 以上の整数（受け取った値: ${hours}）"
  [[ -n "$keep" ]] || keep="${SB_IDLE_STOP_KEEP:-10}"
  [[ "$keep" =~ ^[0-9]+$ ]] || die "idle-stop: 残す台数（--keep / SB_IDLE_STOP_KEEP）は 0 以上の整数（受け取った値: ${keep}）"
  if (( hours == 0 )); then echo "[idle-stop] 無効（SB_IDLE_STOP_HOURS=0）。何もしない"; return 0; fi
  local all; all="$(pve_vms | awk -v p="^$SB_PREFIX-" '$2 ~ p && $2 !~ /-(base|gw|ctl)$/ && $2 !~ /-tpl-/ {print $1, $2, $3}')"
  local now; now="$(date +%s)"
  local n_stop=0 n_keep=0 n_lent=0 n_fresh=0 n_unknown=0 n_off=0 n_fail=0 total=0 n_cand=0
  local mine="[]" cands="[]" cand="" vmid name status pj h since src
  # 1 段目: 候補を集める（ロック無し。止める直前にロックの中で判定し直す）
  while read -r vmid name status; do
    [[ -n "$vmid" ]] || continue
    [[ "$status" == running ]] || continue    # 既に止まっている VM は数えない（前回止めた分は下の still で引き継ぐ）
    total=$(( total + 1 ))
    pj="$(sed -n "s/^$SB_PREFIX-\(.*\)-[0-9][0-9]*\$/\1/p" <<< "$name")"
    h="$hours"
    if [[ -n "$pj" ]]; then h="$(idle_hours_for "$pj" "$hours")"; fi
    [[ "$h" =~ ^[0-9]+$ ]] || h="$hours"
    _idle_classify "$vmid" "$name" "$h" "$now"
    case "$_idle_verdict" in
      candidate) n_cand=$(( n_cand + 1 )); cand+="$_idle_since $vmid $name $h $_idle_src"$'\n' ;;
      lent) n_lent=$(( n_lent + 1 )) ;;
      fresh) n_fresh=$(( n_fresh + 1 )) ;;
      off) n_off=$(( n_off + 1 )) ;;
      *) echo "[idle-stop] $name ($vmid): 見送り（最終利用の記録なし・uptime も不明）"; n_unknown=$(( n_unknown + 1 )) ;;
    esac
  done <<< "$all"
  # 2 段目: 候補を古い順に並べ、新しい方から $keep 台を残して、それより古いものだけ止める
  local n_to_stop=$(( n_cand - keep )); (( n_to_stop < 0 )) && n_to_stop=0
  local i=0
  while read -r since vmid name h src; do
    [[ -n "$vmid" ]] || continue
    i=$(( i + 1 ))
    if (( i > n_to_stop )); then
      echo "[idle-stop] ${name} (${vmid}): 候補だが残す（${src} $(_hm $(( now - since ))) 前。新しい方から ${keep} 台の内）"
      n_keep=$(( n_keep + 1 ))
      cands="$(jq -c --arg v "$vmid" --arg n "$name" --arg s "$since" \
        '. + [{vmid:($v|tonumber), name:$n, last_used:($s|tonumber|todate)}]' <<< "$cands")"
      continue
    fi
    if (( dry )); then
      _idle_stop_one "$vmid" "$name" "$h" "$now" 1 || true
    else
      # 判定のやり直し → shutdown 完了までロックを持つ（take が予約した直後の VM を止めないため）
      state_lock_acquire
      _idle_stop_one "$vmid" "$name" "$h" "$now" 0 || true
      state_lock_release
    fi
    case "$_idle_verdict" in
      stopped) n_stop=$(( n_stop + 1 )); [[ -n "$_idle_entry" ]] && mine="$(jq -c --argjson e "$_idle_entry" '. + [$e]' <<< "$mine")" ;;
      fail) n_fail=$(( n_fail + 1 )) ;;
      lent) n_lent=$(( n_lent + 1 )); n_cand=$(( n_cand - 1 )) ;;
      fresh) n_fresh=$(( n_fresh + 1 )); n_cand=$(( n_cand - 1 )) ;;
      off) n_off=$(( n_off + 1 )); n_cand=$(( n_cand - 1 )) ;;
      *) n_unknown=$(( n_unknown + 1 )); n_cand=$(( n_cand - 1 )) ;;
    esac
  done <<< "$(sort -n -k1,1 -k2,2 <<< "$cand")"
  local sum="[idle-stop] 対象 ${total} 台: 候補 ${n_cand}（停止 ${n_stop} / 残す ${n_keep}。足切り ${keep} 台）/ 貸出中 ${n_lent} / 未経過 ${n_fresh} / 不明 ${n_unknown}"
  (( n_off )) && sum="$sum / 対象外 $n_off"
  (( n_fail )) && sum="$sum / 失敗 $n_fail"
  echo "$sum"
  (( dry )) && return 0
  # 「今回止めた」+「前回の一覧のうち今も止まっているもの」。take が起動した VM は次の実行で自然に消える
  local prev="[]" ids
  [[ -f "$IDLE_STOP_FILE" ]] && prev="$(jq -c '.stopped // []' "$IDLE_STOP_FILE" 2>/dev/null || echo '[]')"
  ids="$(awk '$3 == "stopped" {print $1}' <<< "$all" | jq -Rc 'select(length > 0)' | jq -sc .)"
  local list; list="$(jq -nc --argjson prev "$prev" --argjson mine "$mine" --argjson ids "$ids" \
    '($mine | map(.vmid|tostring)) as $new
     | $mine + ($prev | map(select((.vmid|tostring) as $v | ($ids | index($v)) != null and ($new | index($v)) == null)))')"
  local tmp; tmp="$(mktemp)"
  jq -nc --arg h "$hours" --arg k "$keep" --arg t "$(date -Iseconds)" --argjson s "$list" --argjson c "$cands" \
    '{hours:($h|tonumber), keep:($k|tonumber), last_run:$t, stopped:$s, candidates:$c}' > "$tmp" && mv "$tmp" "$IDLE_STOP_FILE"
}

cmd_ls() {
  printf '%-8s %-14s %-6s %-12s %-9s %s\n' TASK VM VMID IP STATUS SINCE
  local all; all="$(pve_vms | awk -v p="^$SB_PREFIX-" '$2 ~ p && $2 !~ /-(base|gw|ctl)$/ && $2 !~ /-tpl-/ {print $1, $2, $3}')"
  while read -r vmid name status; do
    [[ -n "$vmid" ]] || continue
    local ip; ip="$(pool_ip "$vmid")"
    # 同じ vmid に複数の貸出があっても 1 台 1 行にする（改行のままだと表の行が割れる）。SINCE は先頭の貸出のもの
    local task; task="$(jq -r --arg v "$vmid" 'to_entries[] | select(.value.vmid==($v|tonumber)) | .key' "$STATE" | paste -sd, -)"
    local since=""; [[ -n "$task" ]] && since="$(state_field "${task%%,*}" since)"
    printf '%-8s %-14s %-6s %-12s %-9s %s\n' "${task:--}" "$name" "$vmid" "$ip" "$status" "$since"
  done <<< "$all"
  idle_stop_note
}

# 定義台数（設定）と実体台数（Proxmox）を分けて出す。「pool 3」だけを見て 3 本同時に走らせると take で落ちる（241）
cmd_status() { # [pj]
  local want=${1:-} list pj
  # PJ は VM 名（$SB_PREFIX-<pj>-NN）から集め、実体が 1 台も無い PJ も台帳と引数から拾う
  list="$( { pve_vms | awk -v p="^$SB_PREFIX-" '$2 ~ p && $2 !~ /-(base|gw|ctl)$/ && $2 !~ /-tpl-/ {print $2}' \
                     | sed -n "s/^$SB_PREFIX-\(.*\)-[0-9][0-9]*\$/\1/p"
             jq -r '.[].pj // empty' "$STATE"
             if [[ -n "$want" ]]; then echo "$want"; fi; } | sort -u )"
  printf '%-14s %-8s %-7s %-5s %s\n' PJ DEFINED ACTUAL LENT FREE
  while read -r pj; do
    [[ -n "$pj" ]] || continue
    [[ -z "$want" || "$pj" == "$want" ]] || continue
    local defined actual lent free
    read -r defined actual lent <<< "$(pool_counts "$pj")"
    free=$(( actual - lent )); (( free < 0 )) && free=0    # 実体と貸出は取得の時点が違う。空きは 0 で止める
    printf '%-14s %-8s %-7s %-5s %s\n' "$pj" "$defined" "$actual" "$lent" "$free"
  done <<< "$list"
  idle_stop_note
}

case "${1:-}" in
  take) shift; cmd_take "$@" ;;
  ssh) shift; cmd_ssh "$@" ;;
  url) shift; cmd_url "$@" ;;
  reset) shift; cmd_reset "$@" ;;
  release) shift; cmd_release "$@" ;;
  ls) cmd_ls ;;
  status) shift; cmd_status "$@" ;;
  token) shift; cmd_token "$@" ;;
  reinject) shift; cmd_reinject "$@" ;;
  gh-app) shift; cmd_gh_app "$@" ;;
  idle-stop) shift; cmd_idle_stop "$@" ;;
  *) sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
