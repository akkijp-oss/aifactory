#!/usr/bin/env python3
"""console/bin/console: aifactory の Web コンソール（Mac ローカル専用、Python 3 標準ライブラリのみ）。

  console/bin/console [--port 8765] [--host 127.0.0.1] [--open]

- 見る: kanban のボード（kanban.db を読み取り専用で開く）/ workflow/runs/ の実行記録と各ログ / sandbox の貸出状況 / glue のログ
- 動かす: kb（状態変更・起票・kb run）/ glue/bin/intake / glue/bin/dispatch / sandbox ls・release を **ジョブ**として起動し、標準出力を
  console/jobs/<id>/log に流す。画面はそれを追い読みする。長い run（60 分超）もブラウザを閉じて構わない
- 状態を変えるのは必ず CLI 経由（kb / sandbox）。コンソールが DB や state.json に直接書くことはない（他セッションとの整合を kb に集約する）
- 127.0.0.1 にしか bind しない。認証は無い。POST は X-Console ヘッダを要求する（ブラウザの他サイトからは送れない）
- 置き場は AIFACTORY_WORKSPACE（lib/aifactory_paths.py）。KB_ROOT / CONSOLE_JOBS で個別に差し替えられる（テスト用: console/tests/）
- 読み書きの正本は lib/core.py（bin/mcp と共有）。ここは HTTP の口だけ
"""
import argparse, http.server, json, mimetypes, os, pathlib, re, sys, threading, urllib.parse, webbrowser

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))
import core
from core import *   # noqa: F401,F403  読み書きの正本は lib/core.py。ここは HTTP の口だけ

STATIC = core.HERE / "static"


# ---------- HTTP
class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "aifactory-console/0.2"

    def log_message(self, fmt, *args):
        if os.environ.get("CONSOLE_VERBOSE"): super().log_message(fmt, *args)

    def send_json(self, obj, code=200):
        body = json.dumps(obj, ensure_ascii=False).encode()
        self.send_response(code); self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body))); self.send_header("Cache-Control", "no-store"); self.end_headers()
        self.wfile.write(body)

    def send_file(self, p):
        ctype = mimetypes.guess_type(str(p))[0] or "application/octet-stream"
        if ctype.startswith("text/") or ctype in ("application/javascript",): ctype += "; charset=utf-8"
        body = p.read_bytes()
        self.send_response(200); self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store"); self.end_headers(); self.wfile.write(body)

    def body_json(self):
        n = int(self.headers.get("Content-Length") or 0)
        raw = self.rfile.read(n) if n else b""
        try: return json.loads(raw.decode("utf-8")) if raw else {}
        except Exception: return {}

    def do_GET(self):
        u = urllib.parse.urlsplit(self.path); q = dict(urllib.parse.parse_qsl(u.query))
        path = u.path
        try:
            if path.startswith("/api/"): return self.send_json(*self.api_get(path[5:], q))
            if path == "/": path = "/index.html"
            p = (STATIC / path.lstrip("/")).resolve()
            if p.is_file() and p.is_relative_to(STATIC.resolve()): return self.send_file(p)
            if "." not in path.rsplit("/", 1)[-1]: return self.send_file(STATIC / "index.html")
            self.send_json({"error": "not found"}, 404)
        except ApiError as e: self.send_json({"error": str(e)}, e.code)
        except Exception as e: self.send_json({"error": f"{type(e).__name__}: {e}"}, 500)

    def api_get(self, ep, q):
        """戻り: (obj, code)"""
        if ep == "overview": return overview(), 200
        if ep == "tickets": return tickets_list(pj=q.get("pj")), 200
        m = re.match(r"^tickets/(\d+)$", ep)
        if m: return ticket_detail(int(m.group(1))), 200
        if ep == "runs": return {"runs": list_runs()}, 200
        m = re.match(r"^runs/(.+)$", ep)
        if m:
            d = run_detail(urllib.parse.unquote(m.group(1)))
            if not d: raise ApiError("run が無い", 404)
            return d, 200
        if ep == "file":
            tail = int(q["tail"]) if q.get("tail") else None
            offset = int(q["offset"]) if q.get("offset") else None
            data, err = read_file(q.get("path", ""), tail=tail, offset=offset)
            if not data: raise ApiError(err, 403)
            return data, 200
        if ep == "sandbox": return sandbox_view(), 200
        if ep == "jobs": return {"jobs": JobStore.list()[:200]}, 200
        m = re.match(r"^jobs/([\w.-]+)$", ep)
        if m: return job_view(m.group(1), int(q.get("offset") or 0)), 200
        if ep == "logs": return logs_view(), 200
        if ep == "config": return config_view(), 200
        raise ApiError("not found", 404)

    def do_POST(self):
        if self.headers.get("X-Console") != "1": return self.send_json({"error": "X-Console ヘッダが無い"}, 403)
        u = urllib.parse.urlsplit(self.path); ep = u.path[5:] if u.path.startswith("/api/") else ""
        b = self.body_json()
        try: return self.send_json(self.api_post(ep, b))
        except ApiError as e: return self.send_json({"error": str(e)}, e.code)
        except Conflict as e: return self.send_json({"error": str(e)}, 409)
        except Exception as e: return self.send_json({"error": f"{type(e).__name__}: {e}"}, 500)

    def api_post(self, ep, b):
        m = re.match(r"^tickets/(\d+)/action$", ep)
        if m: return ticket_action(int(m.group(1)), b)
        m = re.match(r"^tickets/(\d+)/run$", ep)
        if m: return ticket_run(int(m.group(1)), b)
        if ep == "tickets": return ticket_new(b)
        if ep == "intake": return op_intake(b)
        if ep == "dispatch": return op_dispatch(b)
        if ep == "sandbox/ls": return op_sandbox_ls()
        if ep == "sandbox/release": return op_sandbox_release(b)
        m = re.match(r"^jobs/([\w.-]+)/stop$", ep)
        if m: return op_job_stop(m.group(1))
        raise ApiError("not found", 404)


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    ap = argparse.ArgumentParser(prog="console", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--port", type=int, default=int(os.environ.get("CONSOLE_PORT", 8765)))
    ap.add_argument("--host", default="127.0.0.1", help="既定 127.0.0.1。他のホストに開けない")
    ap.add_argument("--open", action="store_true", help="起動後にブラウザで開く")
    a = ap.parse_args()
    if a.host not in ("127.0.0.1", "localhost", "::1"):
        print("[console] 認証が無いので 127.0.0.1 以外には bind しない", file=sys.stderr); sys.exit(1)
    JOBS.mkdir(exist_ok=True); JobStore.reconcile()
    srv = Server((a.host, a.port), Handler)
    url = f"http://{a.host}:{a.port}/"
    print(f"[console] {url}  repo={REPO}  kb_root={KB_ROOT}  jobs={JOBS}", flush=True)
    if a.open: threading.Timer(0.5, lambda: webbrowser.open(url)).start()
    try: srv.serve_forever()
    except KeyboardInterrupt: print("\n[console] 停止（起動中のジョブは続く。console/jobs/ に記録）")


if __name__ == "__main__":
    main()
