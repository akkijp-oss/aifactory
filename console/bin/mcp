    ("computer_close", "画面操作用の予約を返却する。Macは専用VMを削除、Windows/Linuxはworkspaceを削除。保存済みスクリーンショットは保持する。",schema({"session":STR},["session"]),t_computer_close),
    ("overview", "工場の概況: 状態ごとのチケット数、動いている run（今の step）、実行中ジョブ、貸出中 VM 数、枠組みの checkout が origin と食い違っていないか（repo）。pj を渡すと run の一覧だけその PJ に絞る（チケット数は常に全 PJ）", schema({"pj": STR}), t_overview),
    ("ticket_list", "チケット一覧（既定は done 以外）。pj / status で絞る", schema({"pj": STR, "status": {"type": "string", "enum": core.STATUSES}, "all": {**BOOL, "description": "done も含める"}}), t_ticket_list),
    ("ticket_show", "チケット 1 件: メタ・本文・履歴・関連する run とジョブ。run があれば sync_preview（状態を合わせたときの前後）も付く", schema({"id": INT}, ["id"]), t_ticket_show),
    ("ticket_new", "整った本文でチケットを起票する（kb new）。自由文なら intake を使う", schema({"pj": STR, "kind": {"type": "string", "description": "chore / bug / feature / hotfix / research / merge-pr"}, "title": STR, "body": {**STR, "description": "Markdown。末尾に『## 完了条件』"}, "pr": INT, "note": STR}, ["pj", "kind", "title"]), t_ticket_new),
    ("ticket_attach", "チケットにファイルを 1 件添付する（kb attach）。runner が VM の ~/work/<id>/attachments/ に配り、依頼文にも名前が載る。"
     "content_base64 に中身をそのまま渡すか、path に ctl の上のファイル（ホームか /tmp の下・`.` で始まる要素を含まないもの）を指定する。どちらか一方。"
     "名前は保存時に整えられる（長さと Markdown の記法を落とす）ので、返りの added を見ること。秘密（トークン・鍵）は添付しない",
     schema({"id": INT, "name": {**STR, "description": "添付する名前。content_base64 のときは必須"},
             "content_base64": {**STR, "description": "中身を base64 で。1 ファイル 20 MiB / チケット合計 100 MiB まで"},
             "path": {**STR, "description": "ctl の上のファイルの絶対パス（例 /tmp/画面.png）"}}, ["id"]), t_ticket_attach),
    ("ticket_detach", "チケットの添付を 1 件消す（kb detach）。ファイルが消えるので元に戻せない。名前は ticket_show の attachments[].name のとおりに渡す",
     schema({"id": INT, "name": STR}, ["id", "name"]), t_ticket_detach),
    ("ticket_action", "チケットの状態を進める・項目を直す（kb）。done と set の pr は、紐づく run が human で止まったままなら run 記録にも「人間が仕上げた」を転記する（run_action と同じ内容）。action: start / review / done / reopen / block（note 必須）/ set（kind・pr・note・status・run。note は空文字列で消せる。キーを渡さなければ触らない）/ append（text 必須・section 任意。本文の末尾に追記し history に残る）/ sync（run 記録から状態を取り直す。既定は書かずに前後を返すだけ）",
     schema({"id": INT, "action": {"type": "string", "enum": ["start", "review", "done", "reopen", "block", "set", "append", "sync"]}, "note": STR, "kind": STR, "pr": INT, "status": STR, "run": STR,
             "text": {**STR, "description": "append する本文（append では必須）"}, "section": {**STR, "description": "append に付ける見出し。例 PM 補足"},
             "dry_run": {**BOOL, "description": "sync 専用。既定 true = 書かずに前後を返す。false を明示したときだけ状態とメモを上書きする"}}, ["id", "action"]), t_ticket_action),
    ("ticket_run", "チケットを runner で回す（kb run）。VM を貸し出し step を順に実行し PR まで進める。ジョブを返す。dry_run なら VM を触らず依頼文だけ組む",
     schema({"id": INT, "dry_run": BOOL, "workflow": {**STR, "description": "種別と違う workflow で回すとき"}, "keep": {**BOOL, "description": "終了後 VM を返却しない"}, "resume": {**BOOL, "description": "貸出中の VM で続きから"},
             "from_step": {**STR, "description": "human で止まった run を新しい VM で、この step からやり直す（research / design は走らない）。記録の wip ブランチの続きから始まり、前回の work/*.md と review.md の指摘が依頼文に入る。空文字列なら記録の resume_step に任せる。打つべき値は ticket_show の runs[].resume に出る"},
             "from_branch": {**STR, "description": "from_step のとき続きに使うブランチ。既定は記録の wip_branch"},
