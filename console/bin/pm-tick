#!/usr/bin/env python3
"""console/bin/pm-tick: AI Factory Manager の 1 周（core.pm_tick）を 1 回だけ回して、結果を JSON で出す薄い入口。

aifactory-pm.timer / com.aifactory.pm.plist が 5 分ごとにこれを起こす（ADR-0074 決定 1）。
判定はここに 1 行も無い（ADR-0015: 正本は console/lib/core.py）。この版は propose だけで、何も起動しない。

  console/bin/pm-tick [--pj <PJ>] [--dry]

ロックを取れなかった（別の tick が走っている）・auto を渡された、といった「今日は何もしない」は
rc 0 で JSON に載せる。5 分ごとの timer が journal を赤で埋めないため。読めない置き場・壊れた
引数のような本当の失敗だけ rc 1。
"""
import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parents[1] / "lib"))
import core  # noqa: E402


def main():
    ap = argparse.ArgumentParser(description="AI Factory Manager の 1 周（提案のみ。何も起動しない）")
    ap.add_argument("--pj", help="この PJ だけを見る（省略すると全 PJ 横断）")
    ap.add_argument("--dry", action="store_true", help="決めるところまでで、判断ログに書かない")
    a = ap.parse_args()
    try:
        out = core.pm_tick(pj=a.pj or None, dry=a.dry, by="tick")
    except (core.ApiError, core.Conflict) as e:
        out = {"ticked": False, "skipped": "error", "error": str(e), "pj": a.pj or None, "at": core.now()}
    print(json.dumps(out, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
