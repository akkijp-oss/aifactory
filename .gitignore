# 秘密情報
*.env
*.token
.env*
!.env.example
# workflow/kit/routes.env はモデルの経路表（設定）で秘密ではない。*.env の例外
!workflow/kit/routes.env
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
.envrc
*.tfvars
credentials*.json

# 運用データ（枠組みとは別に置く。lib/aifactory_paths.py / ADR-0016）
# 既定は <repo>/workspace/。AIFACTORY_WORKSPACE で外にも置ける。
# 中身: projects/（PJ 定義）kanban/（台帳）runs/（実行記録）logs/ docs/（私有メモ）
# 末尾スラッシュ無し = 外に置いた workspace への symlink も無視する
workspace

# sandbox の貸出状態は ~/.config/sandbox/state.json（リポジトリ外）
*.img
*.qcow2
*.tar.zst
.DS_Store
# macOS の AppleDouble（Mac の tree を別ホストに被せると残り、種別・役割の候補に混ざる。218 / 247）
._*
docs/source/media/

# console が起動した CLI の記録（ローカルの運転ログ。正本は runs/ と kb history）
console/jobs/

# agent step の生イベント（stream-json）。大きいのでローカルのみ。人が読む形は同名の .log
**/*.jsonl

# Python
__pycache__/
*.pyc
.venv/

# MkDocs のビルド生成物
website/site/
.playwright-mcp/

# console のモデルの変更が書く前に残す控え（作業ツリーにだけ置く。チケット 416 / ADR-0063）
*.bak-20*
