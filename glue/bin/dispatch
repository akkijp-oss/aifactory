#!/usr/bin/env python3
"""glue/bin/dispatch: kanban の todo を順に取り出して workflow を回す（配車。ただのコード、エージェント不在）。

  glue/bin/dispatch [--pj P] [--once] [--max N] [--dry-run]

- `kb next --json [--pj P]` で最も古い todo を 1 件取り、`kb run <id>` を呼ぶ。終わったら次を取る。todo が無くなれば終了
- 種別（kind）は kanban が持っているので、ここでの判断は「回せるか」だけ:
    - PJ に `project.yml` が無い（$AIFACTORY_WORKSPACE/projects/<pj>/ にも examples/projects/<pj>/ にも）→ `kb block`（メモに理由）して次へ
    - その PJ のプールが全部貸出中（`sandbox ls`）→ その PJ は飛ばして次の PJ の todo を探す。全部詰まっていたら終了
- 直列で回す（1 回に 1 run）。並列は runs の観察（ゲートが重い）を踏まえて後で
- 記録は $AIFACTORY_WORKSPACE/logs/dispatch.log（1 行 1 run: 開始 / 終了 / id / pj / kind / 結果ステータス / 所要秒）
- --once は 1 件だけ。--max N は N 件まで。--dry-run は kb run --dry-run（VM を触らない。状態も進まない）
"""
import argparse, datetime, json, pathlib, subprocess, sys, time

HERE = pathlib.Path(__file__).resolve().parent.parent          # glue/
REPO = HERE.parent
sys.path.insert(0, str(REPO / "lib")); import aifactory_paths as paths
KB = REPO / "kanban" / "bin" / "kb"
LOG = paths.LOGS / "dispatch.log"
POOL_PER_PJ = 3   # sandbox/STATUS.md: PJ ごとに 3 台


def sh(cmd, **kw):
    return subprocess.run(cmd, text=True, capture_output=True, errors="replace", **kw)


def log(line):
    print(f"[dispatch] {line}", flush=True)
    LOG.parent.mkdir(parents=True, exist_ok=True)
    with open(LOG, "a", encoding="utf-8") as f: f.write(f"{datetime.datetime.now().isoformat(timespec='seconds')}\t{line}\n")


def next_ticket(pj=None, skip=()):
    """todo を古い順に見て、skip に無い最初の 1 件"""
    cmd = [str(KB), "list", "--status", "todo"] + (["--pj", pj] if pj else [])
    rows = [l.split() for l in sh(cmd).stdout.splitlines() if l.strip() and l.strip() != "(なし)"]
    for r in rows:
        tid = int(r[0])
        if tid in skip: continue
        info = dict(l.split(None, 1) for l in sh([str(KB), "show", str(tid)]).stdout.split("-" * 60)[0].splitlines() if len(l.split(None, 1)) == 2)
        return {"id": tid, "pj": info.get("pj"), "kind": info.get("kind"), "title": info.get("title", "")}
    return None


def lent_per_pj():
    out = {}
    for l in sh(["sandbox", "ls"]).stdout.splitlines()[1:]:
        c = l.split()
        if len(c) >= 2 and c[0] != "-":
            pj = c[1].removeprefix("sb-").rsplit("-", 1)[0]; out[pj] = out.get(pj, 0) + 1
    return out


def main():
    ap = argparse.ArgumentParser(prog="dispatch", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--pj"); ap.add_argument("--once", action="store_true"); ap.add_argument("--max", type=int, default=0); ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()
    limit = 1 if a.once else (a.max or 10**9)
    done = 0; skip = set(); busy_pj = set()
    while done < limit:
        t = next_ticket(a.pj, skip)
        if not t: log("todo が無い（または全部飛ばした）。終了"); break
        tid, pj = t["id"], t["pj"]
        pd = paths.project_dir(pj)
        if not (pd and (pd / "project.yml").exists()):
            sh([str(KB), "block", str(tid), "--note", f"dispatch: {pj} に project.yml が無く runner を回せない"])
            log(f"{tid} {pj} {t['kind']}: project.yml 無し → blocked"); skip.add(tid); continue
        if not a.dry_run and pj in busy_pj: skip.add(tid); continue
        if not a.dry_run and lent_per_pj().get(pj, 0) >= POOL_PER_PJ:
            log(f"{tid} {pj}: プール {POOL_PER_PJ} 台すべて貸出中 → この PJ は飛ばす"); busy_pj.add(pj); skip.add(tid); continue
        log(f"start {tid} {pj} {t['kind']} {t['title'][:50]}{' (dry-run)' if a.dry_run else ''}")
        t0 = time.time()
        rc = subprocess.run([str(KB), "run", str(tid)] + (["--dry-run"] if a.dry_run else [])).returncode
        status = next((l.split(None, 2)[1] for l in sh([str(KB), "show", str(tid)]).stdout.splitlines() if l.startswith("status")), "?")
        log(f"end   {tid} {pj} {t['kind']} rc={rc} status={status} {int(time.time() - t0)}s")
        done += 1; skip.add(tid)
    return 0


if __name__ == "__main__":
    sys.exit(main())
